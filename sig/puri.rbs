# A Siri-style desktop assistant on pikuri. Three namespaces share one loader: {Puri::Core}, the
# backend; {Puri::Protocol}, the messages between the two; {Puri::Desktop}, the GTK4 UI. Only
# `exe/puri` knows both sides.
# 
# Requiring this file sets the loader up but loads nothing, so a process may load Core and
# Protocol without GTK. Desktop's windows subclass Adw's at load time, so whoever loads Desktop
# calls {require_gtk} first.
module Puri
  LOADER: Zeitwerk::Loader
  USER_AGENT: String
  SETUP: String

  # Loads GTK4, libadwaita and libshumate, the map widget. Neither of the last two has a Ruby
  # package, so each comes through GObject Introspection, which is not a Zeitwerk-shaped file.
  # Safe to call twice.
  # 
  # `require 'gtk4'` runs `gtk_init`, so `GDK_BACKEND` and the display must already be in the
  # environment.
  def self.require_gtk: () -> void

  # _@param_ `namespace` — a typelib's, and the module it loads into
  # 
  # _@param_ `version`
  # 
  # _@return_ — whether it was loaded already
  def self.introspect: (String namespace, String version) -> bool

  # Appends apt's +name+ gem and its runtime dependencies to the load path, so Bundler, which hides
  # every gem not in the lockfile, can't hide them.
  # 
  # Only the gem layout needs it: Ubuntu 26.10's ruby-cairo installs into
  # `/usr/lib/*/rubygems-integration/` and is otherwise unreachable, while a package still in
  # `vendor_ruby` has nothing at its gemspec's paths and adds nothing. Appended, so a bundled gem of
  # the same name still wins.
  # 
  # _@param_ `name` — the gem, e.g. `gtk4`
  # 
  # _@param_ `specs` — from {apt_gem_specs}
  # 
  # _@param_ `seen` — the gems already visited
  def self.add_apt_gem: (String name, ::Hash[String, Gem::Specification] specs, ?::Array[String] seen) -> void

  # Under Bundler `Gem.path` is the bundle alone, but `Gem.default_path` still lists apt's folders.
  # 
  # _@return_ — apt's newest gemspec of each name
  def self.apt_gem_specs: () -> ::Hash[String, Gem::Specification]

  # The backend. It takes {Protocol} commands and emits {Protocol} events on its own threads.
  # 
  # Core never names Gtk, Adw, GLib, Gio or {Desktop}, so it loads and runs without GTK and could
  # move into its own process unchanged; `spec/boundaries_spec.rb` holds it to that.
  module Core
    # GETs JSON from the public services the agent's tools ask, OpenStreetMap's and Open-Meteo's,
    # as their terms ask: Puri's own User-Agent, at most one request a second to each host, and
    # answers cached.
    # 
    #   http = Http.new
    #   http.get_json('https://photon.komoot.io/api/?q=Jumbo', cancellable:)   # => {"features" => […]}
    #   http.get_json(forecast_url, max_age: 900, cancellable:)                # asked again after 15 min
    # 
    # A cached answer costs no request and no wait. A request to a host asked less than an
    # interval ago waits its turn on `cancellable`, so a cancel lands during the wait.
    # 
    # Thread-safe: one per process, or two agents would each send their own one a second.
    class Http
      MONOTONIC: Proc

      # _@param_ `interval` — seconds between two requests to one host
      # 
      # _@param_ `cache_size` — answers kept, the least recently used dropped first
      # 
      # _@param_ `timeout` — seconds to connect, and again to read
      # 
      # _@param_ `clock` — monotonic seconds; a spec's moves at will
      def initialize: (
                        ?interval: Float,
                        ?cache_size: Integer,
                        ?timeout: Integer,
                        ?clock: Proc
                      ) -> void

      # _@param_ `url`
      # 
      # _@param_ `max_age` — seconds a cached answer stays good; nil keeps it until the cache drops it
      # 
      # _@param_ `cancellable` — the turn's
      # 
      # _@return_ — the parsed JSON
      def get_json: (String url, ?max_age: Float?, ?cancellable: Pikuri::Agent::Control::Cancellable) -> (::Hash[String, Object] | ::Array[Object])

      # Books the host's next free slot, so two callers waiting at once go a second apart.
      # 
      # _@param_ `host`
      # 
      # _@return_ — when this request may go, on the monotonic clock
      def reserve: (String host) -> Float

      # _@param_ `uri`
      def fetch: (URI::HTTP uri) -> (::Hash[String, Object] | ::Array[Object])

      # OSRM and Nominatim say what was wrong in a JSON `message` or `error`, Open-Meteo in a
      # `reason` beside `"error": true`.
      # 
      # _@param_ `body`
      # 
      # _@return_ — ": the message", or "" for none
      def reason: (String? body) -> String

      # _@param_ `url`
      # 
      # _@param_ `max_age`
      # 
      # _@return_ — moved to the most recently used; nil
      # for none, or one older than `max_age`
      def hit: (String url, Float? max_age) -> (::Hash[String, Object] | ::Array[Object])?

      # _@param_ `url`
      # 
      # _@param_ `json`
      def remember: (String url, (::Hash[String, Object] | ::Array[Object]) json) -> void

      def now: () -> Float

      # A request that failed: the network, a timeout, a status other than 200, or a body that
      # isn't JSON. Its message says which host, and why.
      class Error < StandardError
      end
    end

    # "Play my favourite music": the `play_music` tool, which finds an artist, an album, a song or
    # a genre in Rhythmbox's library and plays it there (`D_music`).
    # 
    #   rhythmbox = Music::Rhythmbox.find          # one per process; nil without Rhythmbox
    #   configurator.add_tool(Music::PlayTool.new(rhythmbox:))
    # 
    # {Rhythmbox} speaks D-Bus, {Finder} turns the model's names into {Track}s, and {PlayTool}
    # orders them and words the answer.
    module Music
      # One track of Rhythmbox's library, as its media server lists it.
      # 
      # @!attribute [r] title
      #   @return [String]
      # @!attribute [r] artist
      #   @return [String]
      # @!attribute [r] album
      #   @return [String]
      # @!attribute [r] genre
      #   @return [String]
      # @!attribute [r] duration
      #   @return [Integer] seconds; 0 when Rhythmbox doesn't know
      # @!attribute [r] number
      #   @return [Integer] its track number on the album; 0 when untagged
      # @!attribute [r] uri
      #   @return [String] where Rhythmbox plays it from, a percent-encoded `file://` URI
      class Track
        PROPERTIES: ::Array[String]

        # _@param_ `item` — one of `ListItems`' answers, with {PROPERTIES}
        def self.from_item: (::Hash[String, Object] item) -> Puri::Core::Music::Track

        # _@param_ `kind` — one of {Finder::KINDS}
        # 
        # _@return_ — the field a kind names: the title for a song
        def []: (String kind) -> String

        attr_reader title: String

        attr_reader artist: String

        attr_reader album: String

        attr_reader genre: String

        # _@return_ — seconds; 0 when Rhythmbox doesn't know
        attr_reader duration: Integer

        # _@return_ — its track number on the album; 0 when untagged
        attr_reader number: Integer

        # _@return_ — where Rhythmbox plays it from, a percent-encoded `file://` URI
        attr_reader uri: String
      end

      # Turns the model's names into the library's tracks, or into a {Miss} that tells the model
      # what is there instead:
      # 
      #   Finder.new(session).find('artist' => 'state azure')            # => State Azure's tracks
      #   Finder.new(session).find('artist' => 'Johnny Cash', 'song' => 'Hurt')   # => his "Hurt"
      #   Finder.new(session).find('artist' => 'Ambient')
      #   # raises Miss: No artist "Ambient" in the library. Genre "Ambient" has 3 tracks. …
      # 
      # A name matches case-folded and exactly; a near miss comes back as candidates, never
      # played. Several names narrow: the most specific kind given picks the tracks, and every
      # other must match each one's own field.
      class Finder
        KINDS: ::Array[String]
        NEAREST: Integer

        # _@param_ `session`
        def initialize: (Puri::Core::Music::Rhythmbox::Session session) -> void

        # _@param_ `asked` — a name per kind of {KINDS}, at least one
        # 
        # _@return_ — never empty
        def find: (::Hash[String, String] asked) -> ::Array[Puri::Core::Music::Track]

        # _@param_ `kind`
        # 
        # _@param_ `name` — the model's
        # 
        # _@return_ — the library's spelling
        def resolve: (String kind, String name) -> String

        # _@param_ `kind`
        # 
        # _@param_ `name`
        def missing: (String kind, String name) -> String

        # _@param_ `kind`
        # 
        # _@param_ `name`
        # 
        # _@return_ — "Genre "Jazz" has 214 tracks.", when the name is one of this kind
        def elsewhere: (String kind, String name) -> String?

        # _@param_ `primary` — the kind that picked `tracks`
        # 
        # _@param_ `names`
        # 
        # _@param_ `tracks`
        def apart: (String primary, ::Hash[String, String] names, ::Array[Puri::Core::Music::Track] tracks) -> String

        # _@param_ `found` — one title by several artists
        def several: (::Array[Puri::Core::Music::Track] found) -> String

        # _@param_ `candidates`
        # 
        # _@param_ `name`
        # 
        # _@return_ — those containing it or contained in it, then the near spellings
        def nearest: (::Array[String] candidates, String name) -> ::Array[String]

        # _@param_ `kind`
        # 
        # _@return_ — every name of a kind in the library
        def names: (String kind) -> ::Array[String]

        # _@param_ `kind`
        # 
        # _@param_ `name` — the library's spelling
        # 
        # _@return_ — every track of that name: a song's, from the
        # whole library, since songs have no container of their own
        def primary_tracks: (String kind, String name) -> ::Array[Puri::Core::Music::Track]

        # _@param_ `kind` — not `song`
        # 
        # _@param_ `name` — the library's spelling
        def group: (String kind, String name) -> Puri::Core::Music::Rhythmbox::Group

        # _@param_ `kind` — not `song`
        def groups: (String kind) -> ::Array[Puri::Core::Music::Rhythmbox::Group]

        # Every track, read once and only when a song is asked for, or a name is missing: a big
        # library is one long answer.
        def library: () -> ::Array[Puri::Core::Music::Track]

        # _@param_ `names`
        # 
        # _@return_ — "\"a\", \"b\""
        def quoted: (::Array[String] names) -> String

        # _@param_ `name`
        def fold: (String name) -> String

        # Raised when the names find nothing to play; the message is for the model.
        class Miss < StandardError
        end
      end

      # `play_music`: plays an artist, an album, a song or a genre from Rhythmbox's library, in
      # Rhythmbox, and raises its window.
      # 
      #   tool = PlayTool.new(rhythmbox: Rhythmbox.find)
      #   tool.run('artist' => 'state azure').content
      #   # => Playing State Azure in Rhythmbox: 3 tracks, shuffled, round after round.
      # 
      # Each kind plays its own way: an artist or a genre shuffled afresh each round until a
      # day's worth is queued, endless in practice; an album in track order, once; a song alone,
      # the library carrying on after it. The tool takes names, never a URI (*Search, never
      # fetch*), and asks no confirmation: local playback has no outbound leg, and a pause undoes
      # it (`D_music`).
      class PlayTool < Pikuri::Tool
        DAY: Integer
        QUEUE_LIMIT: Integer
        DESCRIPTION: String

        # _@param_ `rhythmbox`
        # 
        # _@param_ `random` — what shuffles
        def initialize: (rhythmbox: Puri::Core::Music::Rhythmbox, ?random: Random) -> void

        # _@param_ `arguments` — the model's
        # 
        # _@return_ — "Hurt, Johnny Cash"
        def describe_call: (::Hash[untyped, untyped] arguments) -> String

        # _@param_ `asked` — a name per kind, nil where not given
        # 
        # _@param_ `cancellable`
        def play: (::Hash[String, String?] asked, Pikuri::Agent::Control::Cancellable cancellable) -> Pikuri::Tool::Result

        # _@param_ `asked`
        # 
        # _@param_ `tracks`
        # 
        # _@return_ — in the order they play
        def queue: (::Hash[String, String] asked, ::Array[Puri::Core::Music::Track] tracks) -> ::Array[Puri::Core::Music::Track]

        # Fresh shuffles back to back, cut at a day's worth: the play queue never loops, and a
        # listener refilling it couldn't tell it running dry from the user picking other music.
        # 
        # _@param_ `tracks`
        def rounds: (::Array[Puri::Core::Music::Track] tracks) -> ::Array[Puri::Core::Music::Track]

        # _@param_ `asked`
        # 
        # _@param_ `tracks`
        def answer: (::Hash[String, String] asked, ::Array[Puri::Core::Music::Track] tracks) -> Pikuri::Tool::Result
      end

      # Rhythmbox, over the session bus: its library through the `dbus-media-server` plugin, its
      # play queue, and MPRIS (`R_rhythmbox_dbus`). Each {#open} is a connection of its own,
      # which starts Rhythmbox when it isn't running:
      # 
      #   rhythmbox = Rhythmbox.find                 # nil where the bus can't start Rhythmbox
      #   rhythmbox.open(cancellable:) do |session|
      #     artist = session.groups('artist').find { _1.name == 'State Azure' }
      #     session.play(session.tracks(artist.path).map(&:uri).shuffle)
      #   end
      # 
      # Thread-safe: a call opens its own connection, since ruby-dbus' isn't safe to share.
      class Rhythmbox
        APPLICATION: String
        MEDIA_SERVER: String
        MPRIS: String
        LIBRARY: String
        CONTAINER: String
        TIMEOUT: Integer
        LOAD_TIMEOUT: Integer

        # _@param_ `address` — the session bus's; nil for the user's own
        # 
        # _@return_ — nil where the bus can't start Rhythmbox, or
        # there is no bus
        def self.find: (?String? address) -> Puri::Core::Music::Rhythmbox?

        # _@param_ `address` — the session bus's; nil for the user's own
        def initialize: (?String? address) -> void

        # _@return_ — whether the bus can start Rhythmbox, or it runs already
        def installed?: () -> bool

        # Connects, starts Rhythmbox unless it runs, and yields the connection.
        # 
        # _@param_ `cancellable` — polled while Rhythmbox starts
        # 
        # _@return_ — the block's value
        def open: (cancellable: Pikuri::Agent::Control::Cancellable) ?{ (Puri::Core::Music::Rhythmbox::Session session) -> Object } -> Object

        # _@return_ — the block's value
        def connect: () ?{ (DBus::BusConnection bus) -> Object } -> Object

        def bus_address: () -> String

        # Raised for anything that keeps Rhythmbox from answering: no bus, a start that failed, a
        # call that timed out.
        class Error < StandardError
        end

        # An artist, album or genre, as the library lists it.
        # 
        # @!attribute [r] name
        #   @return [String] as Rhythmbox shows it
        # @!attribute [r] path
        #   @return [String] its container's object path, for {Session#tracks}
        # @!attribute [r] count
        #   @return [Integer] how many tracks it has
        class Group
          # _@return_ — as Rhythmbox shows it
          attr_reader name: String

          # _@return_ — its container's object path, for {Session#tracks}
          attr_reader path: String

          # _@return_ — how many tracks it has
          attr_reader count: Integer
        end

        # One connection to a running Rhythmbox.
        class Session
          # _@param_ `bus`
          # 
          # _@param_ `cancellable`
          def initialize: (DBus::BusConnection bus, cancellable: Pikuri::Agent::Control::Cancellable) -> void

          # Starts Rhythmbox unless its media server is on the bus, and waits for its library.
          # D-Bus activation opens its window, which is wanted: the user sees the music start
          # even with the sound off (`D_music`).
          def start: () -> void

          # _@param_ `kind` — `artist`, `album` or `genre`
          # 
          # _@return_ — every one in the library
          def groups: (String kind) -> ::Array[Puri::Core::Music::Rhythmbox::Group]

          # _@param_ `path` — a {Group}'s, or `nil` for the whole library
          def tracks: (?String? path) -> ::Array[Puri::Core::Music::Track]

          # Plays `uris` in order: the first at once, the rest from the play queue, which it
          # clears of whatever was queued before. Then raises Rhythmbox's window.
          # 
          # _@param_ `uris` — the library's own, never the model's: a URI Rhythmbox doesn't know is fetched
          def play: (::Array[String] uris) -> void

          def mpris_player: () -> DBus::ProxyObjectInterface

          # _@param_ `path`
          def container: (String path) -> DBus::ProxyObjectInterface

          # _@param_ `name`
          def owned?: (String name) -> bool

          # A fresh Rhythmbox serves an empty library until its database has loaded, then all of
          # it at once; a count that holds for two polls is taken as loaded.
          def wait_for_library: () -> void

          def all_tracks_count: () -> Integer

          # _@param_ `seconds`
          # 
          # _@return_ — whether the block came true in time
          def wait: (Numeric seconds) ?{ () -> bool } -> bool
        end
      end
    end

    # Puri's `config.toml`: the model connections, which one writes the titles, the search
    # engines' keys, the Thunderbird profile and the documents folder. Loaded once
    # at startup, and required: there is no built-in connection, so a missing or incomplete file
    # raises {Error} pointing at {EXAMPLE}, and Puri does not start.
    # 
    #   config = Config.load
    #   config.primary_llm   # => Llm(name:, server:, model:, api_key:, context_window:, params:)
    #   config.titler_llm    # => the [titler] connection, never nil
    #   config.servers       # => [Server(id:, url:, api_key:, max_concurrent_requests:)]
    #   config.embedded_server   # => EmbeddedServer(id:, model:, port:, api_key:), or nil
    #   config.search        # => SearchTable(brave_key:, exa_key:, engines:), or nil with no key
    #   config.thunderbird   # => ThunderbirdTable(enabled:, profile_dir:), or nil when switched off
    #   config.documents     # => Documents(folder:), or nil without the table
    #   config.maps          # => MapsTable(tiles:), or nil without the table
    #   config.weather       # => WeatherTable(url:), or nil without the table
    #   config.dictation     # => DictationTable(url:, api_key:, model:, language:), or nil without the table
    # 
    # The file is Puri's own, `$XDG_CONFIG_HOME/puri/config.toml` (default `~/.config`), never
    # the `pikuri/config.toml` pikuri-tui and pikuri-web share; no other app writes it, so the
    # schema holds only what Puri reads and a key it doesn't know is an error. The schema is
    # pikuri-web's, cut down:
    # 
    #   [[server]]                       # one box: its URL and key, stated once
    #   id      = "local"
    #   url     = "http://localhost:8080"  # optional; omitted, Puri runs llama-server itself
    #   api_key = "…"                    # optional, and only with a url; a local llama-server needs none
    #   max_concurrent_requests = 1      # optional; omitted, sized from the server's slots
    # 
    #   [[llm]]                          # one model on a box; the first is the conversations'
    #   name           = "Qwen 3.5 4B"
    #   server         = "local"         # a [[server]] id, never a URL
    #   model          = "ggml-org/Qwen3.5-4B-GGUF:Q4_K_M"
    #   context_window = 65536           # optional; omitted, pikuri asks the server
    #   params         = { … }           # optional; merged into every request, verbatim
    # 
    #   [titler]
    #   llm = "Qwen 3.5 4B, no thinking" # an [[llm]] name; required
    # 
    #   [search]                         # optional; without a key, the agent has no web tools
    #   brave_key = "…"                  # Brave's, Exa's or both: only they return page text
    #   exa_key   = "…"
    #   engines   = ["brave"]            # optional; omitted, every engine with a key
    # 
    #   [thunderbird]                    # optional; omitted, the profile is discovered
    #   enabled     = false              # optional; false, the agent has no mail or calendar
    #   profile_dir = "~/.thunderbird/x" # optional; omitted, discovered (snap, then apt)
    # 
    #   [documents]                      # optional; omitted, the agent has no files
    #   folder = "~/Documents"           # optional; omitted, the desktop's own, in its language
    # 
    #   [maps]                           # optional; omitted, the agent has no place tools
    #   tiles = "https://tile.openstreetmap.org/{z}/{x}/{y}.png"   # required; the map's tiles
    # 
    #   [weather]                        # optional, and only with [maps]; omitted, no weather tool
    #   url = "https://api.open-meteo.com"   # optional, the default; a self-hosted Open-Meteo
    # 
    #   [dictation]                      # optional; omitted, the prompt has no mic
    #   url      = "http://127.0.0.1:8081"  # optional; an OpenAI-style transcription server, and
    #                                       # without it Puri runs whisper-cli once per clip
    #   api_key  = "…"                   # optional, and only with a url
    #   model    = "whisper-1"           # with a url, optional, the default, which whisper-server
    #                                    # ignores; without, required: the file whisper-cli loads,
    #                                    # "ggerganov/whisper.cpp:ggml-small.bin"
    #   language = "auto"                # optional, the default; or a code such as "de"
    # 
    # A `[[server]]` without a `url` is the llama-server Puri runs itself (`D_embedded`), on the one
    # model every `[[llm]]` on it names, `org/repo:quant` as `-hf` takes it; at most one may lack
    # a `url`.
    # 
    # `params` is a passthrough, since how to switch thinking off differs per server and per chat
    # template; only its shape is checked here.
    # 
    # == Layers
    # 
    # Lowest to highest: each `$XDG_CONFIG_DIRS` entry (default `/etc/xdg`, earlier ranks
    # higher), then `$XDG_CONFIG_HOME`. Tables merge key by key; arrays (`[[server]]`, `[[llm]]`)
    # are replaced whole by the nearest file that has them. `server` references resolve after the
    # merge, so a user file may add an `[[llm]]` on a system file's `[[server]]`.
    # 
    # == Implementation details
    # 
    # Typemap maps the merged TOML onto {Root} and the classes in it, checking each value against
    # the type its YARD tag gives, read back from `sig/puri.rbs`: a stale `sig/` means stale
    # config types, so `rake sig` after changing a tag. {.load} then resolves each {LlmTable}
    # against its {Server} into an {Llm}.
    # 
    # Immutable.
    class Config
      EXAMPLE: String
      FILENAME: String
      XDG_SUBDIR: String
      MAPPER: Typemap::Mapper

      # Reads and resolves the layered configuration.
      # 
      # _@param_ `env` — where `XDG_CONFIG_HOME` and `XDG_CONFIG_DIRS` come from; specs pass their own
      def self.load: (?env: untyped) -> Puri::Core::Config

      # _@param_ `llms` — never empty
      # 
      # _@param_ `servers` — the `[[server]]` entries `llms` were resolved against
      # 
      # _@param_ `embedded_server` — the llama-server Puri runs itself, or nil
      # 
      # _@param_ `titler_llm`
      # 
      # _@param_ `search` — a keyed `[search]`, or nil
      # 
      # _@param_ `thunderbird` — an enabled `[thunderbird]`, or nil; nil by default, so a config built in code reads no profile unless it says which
      # 
      # _@param_ `documents` — the `[documents]` folder, or nil
      # 
      # _@param_ `maps` — the `[maps]` table, or nil
      # 
      # _@param_ `weather` — the `[weather]` table, or nil
      # 
      # _@param_ `dictation` — the `[dictation]` table, or nil
      def initialize: (
                        llms: ::Array[Puri::Core::Config::Llm],
                        servers: ::Array[Puri::Core::Config::Server],
                        titler_llm: Puri::Core::Config::Llm,
                        ?embedded_server: Puri::Core::Config::EmbeddedServer?,
                        ?search: Puri::Core::Config::SearchTable?,
                        ?thunderbird: Puri::Core::Config::ThunderbirdTable?,
                        ?documents: Puri::Core::Config::Documents?,
                        ?maps: Puri::Core::Config::MapsTable?,
                        ?weather: Puri::Core::Config::WeatherTable?,
                        ?dictation: Puri::Core::Config::DictationTable?
                      ) -> void

      # _@return_ — where conversations run: the first `[[llm]]`
      def primary_llm: () -> Puri::Core::Config::Llm

      # _@param_ `env` — see {.load}
      # 
      # _@return_ — the user's own file, `~/.config/puri/config.toml`, perhaps missing
      def self.user_path: (?env: untyped) -> String

      # _@param_ `env` — see {.load}
      # 
      # _@return_ — whether any layer has a file, so that {.load} doesn't fail for want of one
      def self.exists?: (?env: untyped) -> bool

      # _@param_ `env`
      # 
      # _@return_ — the files to read, lowest priority first
      def self.candidate_paths: (untyped env) -> ::Array[String]

      # _@param_ `env`
      # 
      # _@return_ — `$HOME`
      def self.home: (untyped env) -> String

      # _@param_ `env`
      # 
      # _@return_ — `$XDG_CONFIG_HOME`, `~/.config` when unset
      def self.config_home: (untyped env) -> String

      # Warns on stderr, never fails, when a file holding a key — a `[[server]]`'s `api_key`, a
      # search engine's, `[dictation]`'s — is readable by others.
      # 
      # _@param_ `path`
      # 
      # _@param_ `parsed` — the file's raw TOML, unchecked
      def self.warn_loose_perms: (String path, ::Hash[String, Object] parsed) -> void

      # _@param_ `parsed` — a file's raw TOML, unchecked
      # 
      # _@return_ — whether it holds a key
      def self.keys?: (::Hash[String, Object] parsed) -> bool

      # _@param_ `path`
      def self.parse_file: (String path) -> ::Hash[String, Object]

      # Tables merge key by key; scalars and arrays take the higher layer's value whole.
      # 
      # _@param_ `lower`
      # 
      # _@param_ `higher`
      # 
      # _@return_ — a new Hash
      def self.deep_merge: (::Hash[String, Object] lower, ::Hash[String, Object] higher) -> ::Hash[String, Object]

      # _@param_ `merged`
      def self.map: (::Hash[String, Object] merged) -> Puri::Core::Config::Root

      # The `[[server]]` with no `url`, if any `[[llm]]` names it, given a free port on loopback and
      # a fresh key.
      # 
      # _@param_ `servers` — as the file writes them
      # 
      # _@param_ `llms`
      def self.resolve_embedded: (::Array[Puri::Core::Config::Server] servers, ::Array[Puri::Core::Config::LlmTable] llms) -> Puri::Core::Config::EmbeddedServer?

      # _@return_ — a port on 127.0.0.1 nothing listens on, as of now
      def self.free_port: () -> Integer

      # _@param_ `table`
      # 
      # _@param_ `servers` — every `[[server]]`, by id
      def self.resolve_llm: (Puri::Core::Config::LlmTable table, ::Hash[String, Puri::Core::Config::Server] servers) -> Puri::Core::Config::Llm

      # _@param_ `table`
      # 
      # _@param_ `llms`
      def self.resolve_titler: (Puri::Core::Config::TitlerTable table, ::Array[Puri::Core::Config::Llm] llms) -> Puri::Core::Config::Llm

      # A table with no key is no table: the agent goes without web tools, which {PikuriCore}
      # logs. One with a key must name only engines that have theirs, and neither DuckDuckGo
      # nor an engine pikuri doesn't know.
      # 
      # _@param_ `table`
      # 
      # _@return_ — `table`, or nil without a key
      def self.resolve_search: (Puri::Core::Config::SearchTable? table) -> Puri::Core::Config::SearchTable?

      # Thunderbird is on unless switched off: with no profile on the machine, pikuri wires
      # nothing and says so in the log.
      # 
      # _@param_ `table`
      # 
      # _@return_ — nil when `enabled = false`, the
      # defaults when the table is absent, `profile_dir` expanded
      def self.resolve_thunderbird: (Puri::Core::Config::ThunderbirdTable? table) -> Puri::Core::Config::ThunderbirdTable?

      # _@param_ `table`
      # 
      # _@param_ `env`
      def self.resolve_documents: (Puri::Core::Config::DocumentsTable table, untyped env) -> Puri::Core::Config::Documents

      # The desktop's own Documents folder, named in its language, as xdg-user-dirs records it:
      # 
      #   XDG_DOCUMENTS_DIR="$HOME/Dokumenty"   # in ~/.config/user-dirs.dirs => ~/Dokumenty
      # 
      # `~/Documents` without that line, and when it names the home itself, which is how
      # xdg-user-dirs switches a folder off: reading all of home needs a `folder` that says so.
      # 
      # _@param_ `env`
      # 
      # _@return_ — absolute, and perhaps missing
      def self.desktop_documents: (untyped env) -> String

      # _@param_ `table`
      # 
      # _@return_ — `table`
      def self.resolve_maps: (Puri::Core::Config::MapsTable table) -> Puri::Core::Config::MapsTable

      # _@param_ `table`
      # 
      # _@param_ `maps` — the `[maps]` table, which it needs
      # 
      # _@return_ — `table`
      def self.resolve_weather: (Puri::Core::Config::WeatherTable table, Puri::Core::Config::MapsTable? maps) -> Puri::Core::Config::WeatherTable

      # _@param_ `table`
      # 
      # _@return_ — `table`, `model` filled in for a server
      def self.resolve_dictation: (Puri::Core::Config::DictationTable table) -> Puri::Core::Config::DictationTable

      # _@param_ `env`
      # 
      # _@return_ — the commands that copy {EXAMPLE} to where Puri reads it
      def self.copy_example: (untyped env) -> String

      # _@return_ — every connection, in file order; never empty
      attr_reader llms: ::Array[Puri::Core::Config::Llm]

      # _@return_ — every `[[server]]`, in file order, with a
      # `url` each: those no `[[llm]]` names included, but not one with no `url` that none names,
      # since Puri runs no server without a model
      attr_reader servers: ::Array[Puri::Core::Config::Server]

      # _@return_ — the llama-server Puri runs itself; nil
      # when every `[[server]]` an `[[llm]]` names has a `url`
      attr_reader embedded_server: Puri::Core::Config::EmbeddedServer?

      # _@return_ — the connection `[titler]` names
      attr_reader titler_llm: Puri::Core::Config::Llm

      # _@return_ — the engines `web_search` uses; nil when
      # `[search]` sets neither Brave's key nor Exa's, and the agent goes without web tools
      attr_reader search: Puri::Core::Config::SearchTable?

      # _@return_ — the profile the agent reads mail and
      # calendar from; nil when `[thunderbird]` says `enabled = false`
      attr_reader thunderbird: Puri::Core::Config::ThunderbirdTable?

      # _@return_ — the folder the agent searches, reads and keeps
      # its notes in; nil without a `[documents]` table, and the agent has no files
      attr_reader documents: Puri::Core::Config::Documents?

      # _@return_ — the tiles the map under an answer draws; nil
      # without a `[maps]` table, and the agent has no place tools
      attr_reader maps: Puri::Core::Config::MapsTable?

      # _@return_ — where the forecast comes from; nil without a
      # `[weather]` table, and the agent has no weather tool
      attr_reader weather: Puri::Core::Config::WeatherTable?

      # _@return_ — the server the mic's clips go to; nil
      # without a `[dictation]` table, and the prompt has no mic
      attr_reader dictation: Puri::Core::Config::DictationTable?

      # Raised for a missing, unreadable, malformed or incomplete config; the message names the
      # file or the offending key, and says what to write.
      class Error < StandardError
      end

      # One inference server, referenced by {#id} from any number of `[[llm]]` entries.
      # 
      # @!attribute [r] id
      #   @return [String] what an `[[llm]]`'s `server` names; never shown, never stored
      # @!attribute [r] url
      #   @return [String, nil] base URL, with or without `/v1`; pikuri strips it either way. Nil
      #     only as the file writes the server Puri runs itself: {Config.load} fills in its
      #     {EmbeddedServer#url}.
      # @!attribute [r] api_key
      #   @return [String, nil] the key, stored literally, or nil for a server that needs none.
      #     In this file rather than an env var, which every subprocess would inherit.
      # @!attribute [r] max_concurrent_requests
      #   @return [Integer, nil] a `Pikuri::Conversations::Throttle` limit, or nil to size it from
      #     the server's own `total_slots`
      class Server
        extend Typemap::Constrain

        # _@param_ `id`
        # 
        # _@param_ `url`
        # 
        # _@param_ `api_key`
        # 
        # _@param_ `max_concurrent_requests`
        def initialize: (
                          id: String,
                          ?url: String?,
                          ?api_key: String?,
                          ?max_concurrent_requests: Integer?
                        ) -> void

        # Names the entry in a schema error: `server[1] "local".url: required`.
        # 
        # _@param_ `raw` — the entry as written, unchecked
        # 
        # _@return_ — its `id`
        def self.entry_name: (::Hash[String, Object] raw) -> Object

        # _@return_ — what an `[[llm]]`'s `server` names; never shown, never stored
        attr_reader id: String

        # _@return_ — base URL, with or without `/v1`; pikuri strips it either way. Nil
        # only as the file writes the server Puri runs itself: {Config.load} fills in its
        # {EmbeddedServer#url}.
        attr_reader url: String?

        # _@return_ — the key, stored literally, or nil for a server that needs none.
        # In this file rather than an env var, which every subprocess would inherit.
        attr_reader api_key: String?

        # _@return_ — a `Pikuri::Conversations::Throttle` limit, or nil to size it from
        # the server's own `total_slots`
        attr_reader max_concurrent_requests: Integer?
      end

      # The llama-server Puri runs itself, for the `[[server]]` with no `url` (`D_embedded`): the
      # one model its `[[llm]]`s name, and the loopback port and key {Config.load} picks for this
      # run, the same for every restart within it.
      # 
      #   config.embedded_server.url   # => "http://127.0.0.1:41235"
      # 
      # @!attribute [r] id
      #   @return [String] its `[[server]]`'s
      # @!attribute [r] model
      #   @return [String] `org/repo:quant`, what `-hf` loads
      # @!attribute [r] port
      #   @return [Integer] a free one on 127.0.0.1
      # @!attribute [r] api_key
      #   @return [String] fresh each run, so nothing else on the machine may use the model
      class EmbeddedServer
        # _@return_ — what its `[[llm]]`s connect to
        def url: () -> String

        # Data's own would print the key into any log line.
        def inspect: () -> String

        # _@return_ — its `[[server]]`'s
        attr_reader id: String

        # _@return_ — `org/repo:quant`, what `-hf` loads
        attr_reader model: String

        # _@return_ — a free one on 127.0.0.1
        attr_reader port: Integer

        # _@return_ — fresh each run, so nothing else on the machine may use the model
        attr_reader api_key: String
      end

      # One model connection, its `[[server]]` resolved into it; its fields are
      # `Pikuri::Agent::ChatTransport.from_openai_server`'s keywords.
      # 
      # @!attribute [r] name
      #   @return [String] unique, e.g. `"Ornith 1.5"`
      # @!attribute [r] server
      #   @return [String] the {Server#url}, never the id the file wrote
      # @!attribute [r] model
      #   @return [String] the model id sent to the server
      # @!attribute [r] api_key
      #   @return [String, nil] the {Server#api_key}
      # @!attribute [r] context_window
      #   @return [Integer, nil] the stated cap, or nil to let pikuri ask the server
      # @!attribute [r] params
      #   @return [Hash{String => Object}] merged into every request on this connection, e.g.
      #     `{"chat_template_kwargs" => {"enable_thinking" => false}}`; frozen, `{}` when omitted
      class Llm
        # _@param_ `name`
        # 
        # _@param_ `server`
        # 
        # _@param_ `model`
        # 
        # _@param_ `api_key`
        # 
        # _@param_ `context_window`
        # 
        # _@param_ `params`
        def initialize: (
                          name: String,
                          server: String,
                          model: String,
                          ?api_key: String?,
                          ?context_window: Integer?,
                          ?params: ::Hash[String, Object]
                        ) -> void

        # The connection an agent rides; `params` go with it, so a connection stays
        # non-thinking wherever its transport goes. No `with_detected_modalities`: Puri sends no
        # attachments, so probing the model's modalities would buy two requests at startup for
        # nothing.
        # 
        #   Pikuri::Agent.new(transport: config.primary_llm.transport, system_prompt:)
        def transport: () -> Pikuri::Agent::ChatTransport

        # _@return_ — unique, e.g. `"Ornith 1.5"`
        attr_reader name: String

        # _@return_ — the {Server#url}, never the id the file wrote
        attr_reader server: String

        # _@return_ — the model id sent to the server
        attr_reader model: String

        # _@return_ — the {Server#api_key}
        attr_reader api_key: String?

        # _@return_ — the stated cap, or nil to let pikuri ask the server
        attr_reader context_window: Integer?

        # _@return_ — merged into every request on this connection, e.g.
        # `{"chat_template_kwargs" => {"enable_thinking" => false}}`; frozen, `{}` when omitted
        attr_reader params: ::Hash[String, Object]
      end

      # One `[[llm]]` table as the file writes it; {Config.load} resolves it into an {Llm}.
      # 
      # @!attribute [r] name
      #   @return [String] see {Llm#name}
      # @!attribute [r] server
      #   @return [String] the {Server#id} it runs on
      # @!attribute [r] model
      #   @return [String] see {Llm#model}
      # @!attribute [r] context_window
      #   @return [Integer, nil] see {Llm#context_window}
      # @!attribute [r] params
      #   @return [Hash{String => Object}] see {Llm#params}; checked to be a table, its contents
      #     the server's business
      class LlmTable
        extend Typemap::Constrain

        # _@param_ `name`
        # 
        # _@param_ `server`
        # 
        # _@param_ `model`
        # 
        # _@param_ `context_window`
        # 
        # _@param_ `params`
        def initialize: (
                          name: String,
                          server: String,
                          model: String,
                          ?context_window: Integer?,
                          ?params: ::Hash[String, Object]
                        ) -> void

        # _@param_ `raw` — see {Server.entry_name}
        # 
        # _@return_ — its `name`
        def self.entry_name: (::Hash[String, Object] raw) -> Object

        # _@return_ — see {Llm#name}
        attr_reader name: String

        # _@return_ — the {Server#id} it runs on
        attr_reader server: String

        # _@return_ — see {Llm#model}
        attr_reader model: String

        # _@return_ — see {Llm#context_window}
        attr_reader context_window: Integer?

        # _@return_ — see {Llm#params}; checked to be a table, its contents
        # the server's business
        attr_reader params: ::Hash[String, Object]
      end

      # The `[titler]` table.
      # 
      # @!attribute [r] llm
      #   @return [String] the {Llm#name} that writes conversation titles
      class TitlerTable
        extend Typemap::Constrain

        # _@return_ — the {Llm#name} that writes conversation titles
        attr_reader llm: String
      end

      # The `[search]` table: the keys `Pikuri::Web::Search.build` takes, and its engines. Only
      # Brave and Exa: `web_read_cached` reads the page text an engine returns with its results,
      # and DuckDuckGo returns none (`D_search_engines`).
      # 
      # @!attribute [r] brave_key
      #   @return [String, nil] a Brave Search API key, https://api-dashboard.search.brave.com
      # @!attribute [r] exa_key
      #   @return [String, nil] an Exa key, https://exa.ai
      # @!attribute [r] engines
      #   @return [Array<String>, nil] `brave`, `exa` or both, each with its key; a set, since
      #     pikuri shuffles them per query. Nil for every engine with a key.
      class SearchTable
        # _@param_ `brave_key`
        # 
        # _@param_ `exa_key`
        # 
        # _@param_ `engines`
        def initialize: (?brave_key: String?, ?exa_key: String?, ?engines: ::Array[String]?) -> void

        # _@return_ — whether a key is set, Brave's or Exa's
        def keyed?: () -> bool

        # _@return_ — a Brave Search API key, https://api-dashboard.search.brave.com
        attr_reader brave_key: String?

        # _@return_ — an Exa key, https://exa.ai
        attr_reader exa_key: String?

        # _@return_ — `brave`, `exa` or both, each with its key; a set, since
        # pikuri shuffles them per query. Nil for every engine with a key.
        attr_reader engines: ::Array[String]?
      end

      # The `[thunderbird]` table: which local profile `Pikuri::Thunderbird::Extension` reads.
      # 
      # @!attribute [r] enabled
      #   @return [Boolean] false leaves the agent without mail, contacts and calendar
      # @!attribute [r] profile_dir
      #   @return [String, nil] the profile directory, `~` expanded; nil to discover it, which
      #     fails, naming both, when two installs hold a mail account
      class ThunderbirdTable
        extend Typemap::Constrain

        # _@param_ `enabled`
        # 
        # _@param_ `profile_dir`
        def initialize: (?enabled: bool, ?profile_dir: String?) -> void

        # _@return_ — false leaves the agent without mail, contacts and calendar
        attr_reader enabled: bool

        # _@return_ — the profile directory, `~` expanded; nil to discover it, which
        # fails, naming both, when two installs hold a mail account
        attr_reader profile_dir: String?
      end

      # The `[documents]` table as the file writes it; {Config.load} resolves it into a
      # {Documents}.
      # 
      # @!attribute [r] folder
      #   @return [String, nil] see {Documents#folder}, `~` unexpanded; nil for the desktop's own
      #     Documents folder
      class DocumentsTable
        extend Typemap::Constrain

        # _@param_ `folder`
        def initialize: (?folder: String?) -> void

        # _@return_ — see {Documents#folder}, `~` unexpanded; nil for the desktop's own
        # Documents folder
        attr_reader folder: String?
      end

      # The `[maps]` table, which turns on `place_search`, `route` and the map under an answer.
      # Their services are fixed, OSM's own; the tiles are a setting, as OSM's terms ask an app not
      # to hard-code its tile server.
      # 
      # @!attribute [r] tiles
      #   @return [String] the tile server's URL template, with `{z}`, `{x}` and `{y}` in it
      class MapsTable
        extend Typemap::Constrain

        # _@return_ — the tile server's URL template, with `{z}`, `{x}` and `{y}` in it
        attr_reader tiles: String
      end

      # The `[weather]` table, which turns on the `weather` tool (`D_weather`). It finds its place
      # through the place tools, so it needs `[maps]` too. The forecast is Open-Meteo's, whose server
      # is open source, so the URL is a setting.
      # 
      # @!attribute [r] url
      #   @return [String] the API's base, without `/v1`
      class WeatherTable
        extend Typemap::Constrain

        # _@param_ `url`
        def initialize: (?url: String) -> void

        # _@return_ — the API's base, without `/v1`
        attr_reader url: String
      end

      # The `[dictation]` table, which turns on the mic in the prompt (`D_dictation`): with a
      # `url`, an OpenAI-style transcription server of the user's own, whisper.cpp's
      # `whisper-server` unless they opt into a hosted one; without, `whisper-cli` on this
      # machine, run once per clip (`D_embedded`). Its own URL, not a `[[server]]` id: those are
      # chat servers.
      # 
      # @!attribute [r] url
      #   @return [String, nil] base URL, with or without `/v1`; nil for `whisper-cli`
      # @!attribute [r] api_key
      #   @return [String, nil] the key, or nil for a server that needs none
      # @!attribute [r] model
      #   @return [String, nil] with a `url`, what the request names, which `whisper-server`
      #     ignores; without, the file `whisper-cli` loads, `org/repo:file` in the {HubCache}.
      #     Nil only as the file writes it: {Config.load} fills in `whisper-1` for a server.
      # @!attribute [r] language
      #   @return [String] what is spoken, a code such as `de`, or {AUTO}
      class DictationTable
        extend Typemap::Constrain
        AUTO: String

        # _@param_ `url`
        # 
        # _@param_ `api_key`
        # 
        # _@param_ `model`
        # 
        # _@param_ `language`
        def initialize: (
                          ?url: String?,
                          ?api_key: String?,
                          ?model: String?,
                          ?language: String
                        ) -> void

        # _@return_ — base URL, with or without `/v1`; nil for `whisper-cli`
        attr_reader url: String?

        # _@return_ — the key, or nil for a server that needs none
        attr_reader api_key: String?

        # _@return_ — with a `url`, what the request names, which `whisper-server`
        # ignores; without, the file `whisper-cli` loads, `org/repo:file` in the {HubCache}.
        # Nil only as the file writes it: {Config.load} fills in `whisper-1` for a server.
        attr_reader model: String?

        # _@return_ — what is spoken, a code such as `de`, or {AUTO}
        attr_reader language: String
      end

      # The folder the agent searches and reads, and writes only in its {#notes}. Search goes
      # through the desktop's own file index, bounded to this folder.
      # 
      # @!attribute [r] folder
      #   @return [String] an existing directory, absolute
      class Documents
        # _@return_ — where the agent writes, and keeps its memory
        def notes: () -> String

        # _@return_ — the memory note, read into each agent's system prompt
        def memory: () -> String

        # _@return_ — an existing directory, absolute
        attr_reader folder: String
      end

      # The whole file. Every key defaults to empty, so {Config.load} rather than Typemap says
      # what is missing, with the example to paste.
      # 
      # @!attribute [r] server
      #   @return [Array<Server>] the `[[server]]` entries, ids unique
      # @!attribute [r] llm
      #   @return [Array<LlmTable>] the `[[llm]]` entries, names unique
      # @!attribute [r] titler
      #   @return [TitlerTable, nil] the `[titler]` table
      # @!attribute [r] search
      #   @return [SearchTable, nil] the `[search]` table
      # @!attribute [r] thunderbird
      #   @return [ThunderbirdTable, nil] the `[thunderbird]` table
      # @!attribute [r] documents
      #   @return [DocumentsTable, nil] the `[documents]` table
      # @!attribute [r] maps
      #   @return [MapsTable, nil] the `[maps]` table
      # @!attribute [r] weather
      #   @return [WeatherTable, nil] the `[weather]` table
      # @!attribute [r] dictation
      #   @return [DictationTable, nil] the `[dictation]` table
      class Root
        extend Typemap::Constrain

        # _@param_ `server`
        # 
        # _@param_ `llm`
        # 
        # _@param_ `titler`
        # 
        # _@param_ `search`
        # 
        # _@param_ `thunderbird`
        # 
        # _@param_ `documents`
        # 
        # _@param_ `maps`
        # 
        # _@param_ `weather`
        # 
        # _@param_ `dictation`
        def initialize: (
                          ?server: ::Array[Server],
                          ?llm: ::Array[LlmTable],
                          ?titler: TitlerTable?,
                          ?search: SearchTable?,
                          ?thunderbird: ThunderbirdTable?,
                          ?documents: DocumentsTable?,
                          ?maps: MapsTable?,
                          ?weather: WeatherTable?,
                          ?dictation: DictationTable?
                        ) -> void

        # _@return_ — the `[[server]]` entries, ids unique
        attr_reader server: ::Array[Server]

        # _@return_ — the `[[llm]]` entries, names unique
        attr_reader llm: ::Array[LlmTable]

        # _@return_ — the `[titler]` table
        attr_reader titler: TitlerTable?

        # _@return_ — the `[search]` table
        attr_reader search: SearchTable?

        # _@return_ — the `[thunderbird]` table
        attr_reader thunderbird: ThunderbirdTable?

        # _@return_ — the `[documents]` table
        attr_reader documents: DocumentsTable?

        # _@return_ — the `[maps]` table
        attr_reader maps: MapsTable?

        # _@return_ — the `[weather]` table
        attr_reader weather: WeatherTable?

        # _@return_ — the `[dictation]` table
        attr_reader dictation: DictationTable?
      end
    end

    # The connections a conversation can run on, by the name `config.toml` gives each `[[llm]]`:
    # 
    #   models = Models.from_config(config)
    #   models.names                          # => ["Ornith 1.5", "Ornith 1.5, no thinking"]
    #   models.find('Ornith 1.5').transport   # => what conversations.open takes
    #   models.name_for(live.status.model)    # => "Ornith 1.5", whatever the probe filled in
    #   models.saved(entry)                   # => the Choice a saved conversation resumes on, or nil
    # 
    # Immutable.
    class Models
      # _@param_ `config`
      # 
      # _@return_ — every `[[llm]]`, in the file's order
      def self.from_config: (Puri::Core::Config config) -> Puri::Core::Models

      # A connection's identity: two `[[llm]]` on one model and one server differ in `params`
      # alone, as the titler's thinking-off twin does. The probe fills in the context window,
      # so a whole transport never `==` the one it started as.
      # 
      # _@param_ `transport`
      def self.key: (Pikuri::Agent::ChatTransport transport) -> [String, String, ::Hash[String, Object]]

      # _@param_ `choices` — the first is the default; never empty
      def initialize: (::Array[Puri::Core::Models::Choice] choices) -> void

      # _@return_ — the first
      def default: () -> Puri::Core::Models::Choice

      def names: () -> ::Array[String]

      # _@param_ `name`
      def find: (String name) -> Puri::Core::Models::Choice

      # _@param_ `transport`
      # 
      # _@return_ — its connection's name; the bare model id for one the config lacks
      def name_for: (Pikuri::Agent::ChatTransport transport) -> String

      # `meta.json` keeps the model and the server, not the params, so of two connections that
      # differ only in params the first in the file wins. The llama-server Puri runs gets a new
      # port every run, so failing the server, a connection to it on the same model will do.
      # 
      # _@param_ `entry`
      # 
      # _@return_ — the connection it was saved on; nil when the
      # config no longer has it, or it was never saved
      def saved: (Pikuri::Conversations::Store::Entry entry) -> Puri::Core::Models::Choice?

      # @!attribute [r] name
      #   @return [String]
      # @!attribute [r] transport
      #   @return [Pikuri::Agent::ChatTransport]
      # @!attribute [r] embedded
      #   @return [Boolean] whether it runs on the llama-server Puri runs itself
      class Choice
        # _@param_ `name`
        # 
        # _@param_ `transport`
        # 
        # _@param_ `embedded`
        def initialize: (name: String, transport: Pikuri::Agent::ChatTransport, ?embedded: bool) -> void

        attr_reader name: String

        attr_reader transport: Pikuri::Agent::ChatTransport

        # _@return_ — whether it runs on the llama-server Puri runs itself
        attr_reader embedded: bool
      end
    end

    # Where a place is, what's near it, how far by car: the `place_search` and `route` tools, on
    # OpenStreetMap's public services, and the map under the answer (`D_places`).
    # 
    #   osm = Places::Osm.new                                  # one per process: it paces requests
    #   notebook = Places::Notebook.new(tiles: config.maps.tiles)   # one per conversation
    #   configurator.add_tools([Places::SearchTool.new(osm:, notebook:), Places::RouteTool.new(osm:, notebook:)])
    #   notebook.map_for(tool_result.content)                  # => the Protocol::Map that call drew
    # 
    # Every place a tool finds gets a number in the {Notebook}, the handle the model passes back.
    # Each call also draws its map there, keyed by the text the model got, so {TurnListener} and
    # {Replay} find a call's map from its result alone.
    module Places
      LICENSE: String

      # OpenStreetMap's public services, the ones GNOME Maps asks too: Photon finds a place by its
      # name, Nominatim what's nearby by its kind, its opening hours, and the address at a point,
      # and FOSSGIS's OSRM drives between points.
      # 
      #   osm = Osm.new
      #   jumbo = osm.search('Jumbo Vantaa').first
      #   shop = osm.search('Vantaan Musiikki', near: jumbo).first
      #   osm.route(jumbo, shop)            # => Route(distance: 6315.1, duration: 530.4, line: […])
      #   cafes = osm.nearby('cafe', near: shop)
      #   osm.drives(shop, cafes)           # => [Route(distance: 939.4, …), …], one per café
      # 
      # Every call may raise {Http::Error}, and takes the turn's `cancellable`, which a wait for the
      # host's turn honours.
      # 
      # Thread-safe.
      class Osm
        PHOTON: String
        NOMINATIM: String
        OSRM: String
        TYPES: ::Hash[String, String]

        # _@param_ `http` — shared, so its pacing covers every caller
        # 
        # _@param_ `photon` — a spec points these at its own server
        # 
        # _@param_ `nominatim`
        # 
        # _@param_ `osrm`
        def initialize: (
                          ?http: Puri::Core::Http,
                          ?photon: String,
                          ?nominatim: String,
                          ?osrm: String
                        ) -> void

        # Places matching `query`, likeliest first: a name, an address, or both. Without `near`,
        # "Prisma" finds Bolivia's.
        # 
        # _@param_ `query`
        # 
        # _@param_ `near` — what the likeliest is near
        # 
        # _@param_ `limit`
        # 
        # _@param_ `cancellable`
        def search: (
                      String query,
                      ?near: Puri::Core::Places::Place?,
                      ?limit: Integer,
                      ?cancellable: Pikuri::Agent::Control::Cancellable
                    ) -> ::Array[Puri::Core::Places::Place]

        # Places of one kind within about `radius` metres of `near`, in no order, with their opening
        # hours and websites.
        # 
        # _@param_ `kind` — OSM's type: "cafe", "pharmacy", "supermarket"…
        # 
        # _@param_ `near`
        # 
        # _@param_ `radius` — metres, each way: a box, not a circle
        # 
        # _@param_ `limit`
        # 
        # _@param_ `cancellable`
        def nearby: (
                      String kind,
                      near: Puri::Core::Places::Place,
                      ?radius: Integer,
                      ?limit: Integer,
                      ?cancellable: Pikuri::Agent::Control::Cancellable
                    ) -> ::Array[Puri::Core::Places::Place]

        # `places` with their opening hours and websites, in one Nominatim lookup. A bare point, or
        # a place Nominatim doesn't return, comes back as it was.
        # 
        # _@param_ `places`
        # 
        # _@param_ `cancellable`
        # 
        # _@return_ — in the same order
        def details: (::Array[Puri::Core::Places::Place] places, ?cancellable: Pikuri::Agent::Control::Cancellable) -> ::Array[Puri::Core::Places::Place]

        # The address at a point, for coordinates the user gave. The point stays where it was given,
        # nameless: a shop at the address would be a guess.
        # 
        # _@param_ `lat`
        # 
        # _@param_ `lon`
        # 
        # _@param_ `cancellable`
        # 
        # _@return_ — with no address where Nominatim knows none
        def reverse: (Float lat, Float lon, ?cancellable: Pikuri::Agent::Control::Cancellable) -> Puri::Core::Places::Place

        # Driving from one place to another.
        # 
        # _@param_ `from`
        # 
        # _@param_ `to`
        # 
        # _@param_ `cancellable`
        def route: (Puri::Core::Places::Place from, Puri::Core::Places::Place to, ?cancellable: Pikuri::Agent::Control::Cancellable) -> Puri::Core::Places::Route

        # Driving from one place to each of several, in one request.
        # 
        # _@param_ `from`
        # 
        # _@param_ `places`
        # 
        # _@param_ `cancellable`
        # 
        # _@return_ — one per place, nil where no road leads; their
        # lines empty
        def drives: (Puri::Core::Places::Place from, ::Array[Puri::Core::Places::Place] places, ?cancellable: Pikuri::Agent::Control::Cancellable) -> ::Array[Puri::Core::Places::Route?]

        # _@param_ `base` — up to the query
        # 
        # _@param_ `params`
        # 
        # _@param_ `cancellable`
        def get: (String base, ::Hash[Symbol, Object] params, Pikuri::Agent::Control::Cancellable cancellable) -> (::Hash[String, Object] | ::Array[Object])

        # _@param_ `places`
        # 
        # _@return_ — OSRM's "lon,lat;lon,lat"
        def points: (*::Array[Puri::Core::Places::Place] places) -> String

        # _@param_ `near`
        # 
        # _@param_ `radius` — metres
        # 
        # _@return_ — Nominatim's "left,top,right,bottom"
        def viewbox: (Puri::Core::Places::Place near, Integer radius) -> String

        # _@param_ `feature` — one of Photon's GeoJSON features
        def photon_place: (::Hash[String, Object] feature) -> Puri::Core::Places::Place

        # _@param_ `found` — one of Nominatim's `jsonv2` results
        def nominatim_place: (::Hash[String, Object] found) -> Puri::Core::Places::Place

        # _@param_ `place`
        # 
        # _@param_ `tags` — Nominatim's `extratags`
        def detailed: (Puri::Core::Places::Place place, ::Hash[String, Object] tags) -> Puri::Core::Places::Place

        # _@param_ `parts` — Nominatim's `address`
        # 
        # _@return_ — "Peltolantie 2, 01300 Vantaa"
        def address: (::Hash[String, Object] parts) -> String

        # _@param_ `value` — an OSM value, "musical_instrument"
        # 
        # _@return_ — "musical instrument"; nil for OSM's "yes", which says nothing
        def readable: (String? value) -> String?
      end

      # Turns what the model wrote for a route's end, or for where a search is near, into a place:
      # 
      #   Ends.resolve('3', osm:, notebook:)                        # place [3] a search found
      #   Ends.resolve('60.2931, 25.0307', osm:, notebook:)         # the address at that point
      #   Ends.resolve('Kielotie 4, Vantaa', osm:, notebook:, near:) # Photon's likeliest, near `near`
      # 
      # Each comes back numbered in the notebook, so the result can name it "[5] …" and the model
      # can pass 5 next time.
      module Ends
        HANDLE: Regexp
        COORDINATES: Regexp

        # _@param_ `text`
        # 
        # _@param_ `osm`
        # 
        # _@param_ `notebook`
        # 
        # _@param_ `near` — what an address is looked up near
        # 
        # _@param_ `cancellable`
        # 
        # _@return_ — its number, and the place
        def resolve: (
                       String text,
                       osm: Puri::Core::Places::Osm,
                       notebook: Puri::Core::Places::Notebook,
                       ?near: Puri::Core::Places::Place?,
                       ?cancellable: Pikuri::Agent::Control::Cancellable
                     ) -> [Integer, Puri::Core::Places::Place]

        # _@param_ `text`
        # 
        # _@param_ `osm`
        # 
        # _@param_ `notebook`
        # 
        # _@param_ `near` — what an address is looked up near
        # 
        # _@param_ `cancellable`
        # 
        # _@return_ — its number, and the place
        def self.resolve: (
                            String text,
                            osm: Puri::Core::Places::Osm,
                            notebook: Puri::Core::Places::Notebook,
                            ?near: Puri::Core::Places::Place?,
                            ?cancellable: Pikuri::Agent::Control::Cancellable
                          ) -> [Integer, Puri::Core::Places::Place]

        # _@param_ `number`
        # 
        # _@param_ `notebook`
        def handle: (Integer number, Puri::Core::Places::Notebook notebook) -> Puri::Core::Places::Place

        # _@param_ `number`
        # 
        # _@param_ `notebook`
        def self.handle: (Integer number, Puri::Core::Places::Notebook notebook) -> Puri::Core::Places::Place

        # _@param_ `lat`
        # 
        # _@param_ `lon`
        # 
        # _@param_ `osm`
        # 
        # _@param_ `cancellable`
        def point: (
                     Float lat,
                     Float lon,
                     Puri::Core::Places::Osm osm,
                     Pikuri::Agent::Control::Cancellable cancellable
                   ) -> Puri::Core::Places::Place

        # _@param_ `lat`
        # 
        # _@param_ `lon`
        # 
        # _@param_ `osm`
        # 
        # _@param_ `cancellable`
        def self.point: (
                          Float lat,
                          Float lon,
                          Puri::Core::Places::Osm osm,
                          Pikuri::Agent::Control::Cancellable cancellable
                        ) -> Puri::Core::Places::Place

        # _@param_ `text`
        # 
        # _@param_ `osm`
        # 
        # _@param_ `near`
        # 
        # _@param_ `cancellable`
        def address: (
                       String text,
                       Puri::Core::Places::Osm osm,
                       Puri::Core::Places::Place? near,
                       Pikuri::Agent::Control::Cancellable cancellable
                     ) -> Puri::Core::Places::Place

        # _@param_ `text`
        # 
        # _@param_ `osm`
        # 
        # _@param_ `near`
        # 
        # _@param_ `cancellable`
        def self.address: (
                            String text,
                            Puri::Core::Places::Osm osm,
                            Puri::Core::Places::Place? near,
                            Pikuri::Agent::Control::Cancellable cancellable
                          ) -> Puri::Core::Places::Place

        # The model's text names nothing: a number no search gave, coordinates off the globe, an
        # address nothing matches. The message is for the model, to correct itself.
        class Unresolved < StandardError
        end
      end

      # A place a service found, or a point given as coordinates.
      # 
      #   place.label   # => "Vantaan Musiikki (musical instrument), Peltolantie 2, 01300 Vantaa"
      #   place.url     # => "https://www.openstreetmap.org/node/9444805490"
      #   place.pin(3)  # => Protocol::Pin(label: "3", …), for the map
      # 
      # @!attribute [r] name
      #   @return [String, nil] nil for an address or a bare point
      # @!attribute [r] category
      #   @return [String, nil] OSM's type of it, readable: "musical instrument", "cafe"
      # @!attribute [r] address
      #   @return [String] street, number, postcode and town, as far as known; "" for none
      # @!attribute [r] lat
      #   @return [Float]
      # @!attribute [r] lon
      #   @return [Float]
      # @!attribute [r] osm
      #   @return [String, nil] the OSM object, "node/9444805490"; nil for a bare point
      # @!attribute [r] hours
      #   @return [String, nil] its `opening_hours`, OSM's syntax verbatim
      # @!attribute [r] website
      #   @return [String, nil]
      class Place
        # _@param_ `name`
        # 
        # _@param_ `lat`
        # 
        # _@param_ `lon`
        # 
        # _@param_ `category`
        # 
        # _@param_ `address`
        # 
        # _@param_ `osm`
        # 
        # _@param_ `hours`
        # 
        # _@param_ `website`
        def initialize: (
                          name: String?,
                          lat: Float,
                          lon: Float,
                          ?category: String?,
                          ?address: String,
                          ?osm: String?,
                          ?hours: String?,
                          ?website: String?
                        ) -> void

        # _@return_ — "name (category), address", as much as is known; the coordinates for a
        # bare point
        def label: () -> String

        # _@return_ — "60.29311, 25.03075"
        def coordinates: () -> String

        # _@return_ — the OSM object's page, or a marker on the point; GNOME Maps opens both
        def url: () -> String

        # _@param_ `number` — what the pin shows; nil draws a dot
        def pin: (Integer? number) -> Puri::Protocol::Pin

        # _@param_ `other`
        # 
        # _@return_ — metres in a straight line, along the Earth's surface
        def distance_to: (Puri::Core::Places::Place other) -> Float

        # _@param_ `text`
        # 
        # _@return_ — nil for blank
        def blank: (String? text) -> String?

        # _@return_ — nil for an address or a bare point
        attr_reader name: String?

        # _@return_ — OSM's type of it, readable: "musical instrument", "cafe"
        attr_reader category: String?

        # _@return_ — street, number, postcode and town, as far as known; "" for none
        attr_reader address: String

        attr_reader lat: Float

        attr_reader lon: Float

        # _@return_ — the OSM object, "node/9444805490"; nil for a bare point
        attr_reader osm: String?

        # _@return_ — its `opening_hours`, OSM's syntax verbatim
        attr_reader hours: String?

        attr_reader website: String?
      end

      # A drive OSRM worked out: how far, how long, and the road it takes.
      # 
      #   route.words   # => "6.3 km, 9 min"
      # 
      # @!attribute [r] distance
      #   @return [Float] metres
      # @!attribute [r] duration
      #   @return [Float] seconds, without traffic
      # @!attribute [r] line
      #   @return [Array<Array<Float>>] the road's `[lat, lon]` points, simplified; empty when only
      #     the distance was asked
      class Route
        # _@return_ — "850 m, 2 min", "6.3 km, 9 min", "42 km, 1 h 5 min"
        def words: () -> String

        def distance_words: () -> String

        def duration_words: () -> String

        # _@return_ — metres
        attr_reader distance: Float

        # _@return_ — seconds, without traffic
        attr_reader duration: Float

        # _@return_ — the road's `[lat, lon]` points, simplified; empty when only
        # the distance was asked
        attr_reader line: ::Array[::Array[Float]]
      end

      # What one conversation's place tools found: a number for each place, the handle the model
      # passes back, and the map each call drew. Saved with the conversation, so after a restart a
      # number still means its place and an old answer redraws its map.
      # 
      #   notebook = Notebook.new(tiles: config.maps.tiles)
      #   notebook.number(place)                  # => 3: numbers count up through the conversation
      #   notebook[3]                             # => that place
      #   notebook.draw(result.content, pins:)    # the call's map, under the text the model got
      #   notebook.map_for(event.content)         # => that Protocol::Map; nil for any other tool's
      #   store.save(…, extra: { 'places' => notebook.to_h })
      #   Notebook.new(tiles:, saved: entry.extra['places'])
      # 
      # A place found twice keeps its first number. Without tiles — no `[maps]` table — it still
      # keeps what it saved, but draws no map.
      # 
      # Thread-safe.
      class Notebook
        LOGGER: Logger

        # _@param_ `tiles` — the `[maps]` tile URL template; nil draws no map
        # 
        # _@param_ `saved` — what {#to_h} saved, as `meta.json` read it back; nil for a new conversation. One that doesn't read is logged and dropped.
        def initialize: (tiles: String?, ?saved: Object?) -> void

        # _@param_ `place`
        # 
        # _@return_ — its number, the one it had if it was found before
        def number: (Puri::Core::Places::Place place) -> Integer

        # _@param_ `number`
        def []: (Integer number) -> Puri::Core::Places::Place?

        # Keeps a call's map under the text its result gave the model.
        # 
        # _@param_ `content` — the result's `content`
        # 
        # _@param_ `pins`
        # 
        # _@param_ `line`
        # 
        # _@param_ `note` — Pango markup
        def draw: (
                    String content,
                    pins: ::Array[Puri::Protocol::Pin],
                    ?line: ::Array[::Array[Float]],
                    ?note: String?
                  ) -> void

        # _@param_ `content` — a tool result's `content`, live or saved
        # 
        # _@return_ — the map that call drew, with no id; nil for a call that
        # drew none, or with no tiles
        def map_for: (String content) -> Puri::Protocol::Map?

        # _@return_ — whether it holds nothing to save
        def empty?: () -> bool

        # _@return_ — JSON-able, for `meta.json`
        def to_h: () -> ::Hash[String, Object]

        # _@param_ `saved`
        def load: (Object saved) -> void

        # _@param_ `known`
        # 
        # _@param_ `place`
        def same?: (Puri::Core::Places::Place known, Puri::Core::Places::Place place) -> bool

        # _@param_ `content`
        def key: (String content) -> String

        # _@param_ `fields`
        def stringify: (::Hash[Symbol, Object] fields) -> ::Hash[String, Object]

        # A map as drawn, before it knows its tiles.
        # 
        # @!attribute [r] pins
        #   @return [Array<Puri::Protocol::Pin>]
        # @!attribute [r] line
        #   @return [Array<Array<Float>>]
        # @!attribute [r] note
        #   @return [String, nil] Pango markup
        class Drawing
          attr_reader pins: ::Array[Puri::Protocol::Pin]

          attr_reader line: ::Array[::Array[Float]]

          # _@return_ — Pango markup
          attr_reader note: String?
        end
      end

      # `route`: how far and how long by car from one place to another, through FOSSGIS's OSRM.
      # Each end is a number a search gave, an address, or coordinates, and the result names what
      # each turned out to be, so a wrong match shows. Draws its map: both ends and the road.
      # 
      #   RouteTool.new(osm:, notebook:).run('from' => '1', 'to' => 'Peltolantie 2, Vantaa').content
      #   # => From: [1] Jumbo (mall), Vantaanportinkatu 3, 01510 Vantaa
      #   #    To: [2] Peltolantie 2, 01300 Vantaa
      #   #    By car: 6.3 km, 9 min, without traffic.
      # 
      # An address is looked up near the other end, or "Prisma" could be Bolivia's.
      # 
      # Sharing: P_one_agent, through its {Notebook}, which is one conversation's.
      class RouteTool < Pikuri::Tool
        NOTE: String
        DESCRIPTION: String

        # _@param_ `osm`
        # 
        # _@param_ `notebook` — the conversation's
        def initialize: (osm: Puri::Core::Places::Osm, notebook: Puri::Core::Places::Notebook) -> void

        # _@param_ `arguments` — the model's
        # 
        # _@return_ — "1 → Peltolantie 2, Vantaa"
        def describe_call: (::Hash[untyped, untyped] arguments) -> String

        # _@param_ `from`
        # 
        # _@param_ `to`
        # 
        # _@param_ `cancellable`
        def route: (String from, String to, Pikuri::Agent::Control::Cancellable cancellable) -> Pikuri::Tool::Result

        # Resolves a number or coordinates first, so an address at the other end has a place to be
        # looked up near.
        # 
        # _@param_ `from`
        # 
        # _@param_ `to`
        # 
        # _@param_ `cancellable`
        def ends: (String from, String to, Pikuri::Agent::Control::Cancellable cancellable) -> [[Integer, Puri::Core::Places::Place], [Integer, Puri::Core::Places::Place]]

        # _@param_ `text`
        # 
        # _@return_ — whether it is a number or coordinates, which need no place to be near
        def fixed?: (String text) -> bool
      end

      # `place_search`: where a place is, or what's of one kind near a place, each hit numbered,
      # with its distance and time by car, its opening hours and website. Draws its map: the hits
      # as numbered pins, the point it searched near as a dot.
      # 
      #   tool = SearchTool.new(osm:, notebook:)
      #   tool.run('query' => 'Vantaan Musiikki', 'near' => 'Jumbo Vantaa').content
      #   # => Near: [1] Jumbo (mall), Vantaanportinkatu 3, 01510 Vantaa
      #   #
      #   #    [2] Musiikki Silfverberg Oy Vantaan Musiikki (musical instrument), Peltolantie 2, 01300 Vantaa
      #   #        — 6.3 km, 9 min by car. Opening hours: Mo-Fr 10:00-17:00. …
      # 
      # A name goes to Photon, then one Nominatim lookup adds the hits' hours; a category goes to
      # Nominatim, which has them; one OSRM request drives to every hit. Where OSRM fails, a hit's
      # distance is the straight line.
      # 
      # Sharing: P_one_agent, through its {Notebook}, which is one conversation's.
      class SearchTool < Pikuri::Tool
        CATEGORIES: ::Array[String]
        DESCRIPTION: String

        # _@param_ `osm`
        # 
        # _@param_ `notebook` — the conversation's
        def initialize: (osm: Puri::Core::Places::Osm, notebook: Puri::Core::Places::Notebook) -> void

        # _@param_ `arguments` — the model's
        # 
        # _@return_ — "cafe near Kielotie 4, Vantaa"
        def describe_call: (::Hash[untyped, untyped] arguments) -> String

        # _@param_ `near`
        # 
        # _@param_ `query`
        # 
        # _@param_ `category`
        # 
        # _@param_ `context`
        def search: (
                      near: String,
                      query: String?,
                      category: String?,
                      context: Pikuri::Tool::ExecuteContext
                    ) -> Pikuri::Tool::Result

        # _@param_ `query`
        # 
        # _@param_ `category`
        # 
        # _@param_ `origin`
        # 
        # _@param_ `cancellable`
        # 
        # _@return_ — each hit
        # and the drive to it; a category's nearest by road first
        def find: (
                    String? query,
                    String? category,
                    Puri::Core::Places::Place origin,
                    Pikuri::Agent::Control::Cancellable cancellable
                  ) -> ::Array[[Puri::Core::Places::Place, Puri::Core::Places::Route, NilClass]]

        # _@param_ `origin`
        # 
        # _@param_ `places`
        # 
        # _@param_ `cancellable`
        def drives: (Puri::Core::Places::Place origin, ::Array[Puri::Core::Places::Place] places, Pikuri::Agent::Control::Cancellable cancellable) -> ::Array[Puri::Core::Places::Route?]

        # _@param_ `origin_number`
        # 
        # _@param_ `origin`
        # 
        # _@param_ `hits`
        # 
        # _@param_ `asked` — the query or the category
        def answer: (
                      Integer origin_number,
                      Puri::Core::Places::Place origin,
                      ::Array[[Puri::Core::Places::Place, Puri::Core::Places::Route, NilClass]] hits,
                      String asked
                    ) -> Pikuri::Tool::Result

        # _@param_ `number`
        # 
        # _@param_ `place`
        # 
        # _@param_ `drive`
        # 
        # _@param_ `origin`
        def line: (
                    Integer number,
                    Puri::Core::Places::Place place,
                    Puri::Core::Places::Route? drive,
                    Puri::Core::Places::Place origin
                  ) -> String

        # _@param_ `origin`
        # 
        # _@param_ `place`
        # 
        # _@return_ — "1.2 km"
        def straight: (Puri::Core::Places::Place origin, Puri::Core::Places::Place place) -> String
      end
    end

    # A saved conversation's blocks, rebuilt from its pikuri history:
    # 
    #   Replay.blocks(store.history(id), notebook:)   # => [UserMessage, ToolLine, Reply, Map, UserMessage, Reply]
    # 
    # Each user message becomes a {Protocol::UserMessage}, each assistant message with text a
    # {Protocol::Reply}, as {TurnListener} renders one when it finishes, so a reloaded reply gets
    # today's renderer; each tool answer becomes the {Protocol::ToolLine} {ToolWording} words for
    # its call, as it did live. The map of a turn's last place tool closes the turn, as live, once
    # an answer followed it. What never became a message is gone: notices, and the partial reply a
    # cancel cut off. The blocks' ids are nil, for {Conversation#restore} to assign.
    module Replay
      # _@param_ `history`
      # 
      # _@param_ `notebook` — where a place tool's map is found
      # 
      # _@return_ — user messages, replies, tool lines and maps
      def self.blocks: (Pikuri::Agent::History history, ?notebook: Puri::Core::Places::Notebook?) -> ::Array[Puri::Protocol::Block]
    end

    # The `[documents]` folder, for every conversation at once: the `Notes/` folder the agent
    # writes in, its memory note, and the desktop's own file index the agent searches it through.
    # 
    #   library = Library.new(config.documents)   # creates Notes/, picks the file index
    #   library.file_index_tools   # => [fileindex_search, fileindex_read], or [] with no index
    #   library.memory             # => Notes/PURI.md's text, "" when absent
    # 
    # The index is the desktop's, not ours (`D_documents`): localsearch, else recoll, as
    # `Pikuri::Fileindex.pick` picks it. Both tools reach only the documents folder, though the
    # index usually covers the whole home. It already holds the text of every PDF and office file
    # its extractors read (README), so `fileindex_read` reads those too. No index holding the folder
    # leaves the agent the file tools alone, and a warning in the log.
    # 
    # Thread-safe.
    class Library
      LOGGER: Logger

      # Creates `Notes/`, and asks each backend in turn whether its index holds the folder.
      # 
      # _@param_ `documents`
      # 
      # _@param_ `backends` — file-index backends, most preferred first; a spec passes its own
      def initialize: (Puri::Core::Config::Documents documents, ?backends: ::Array[Module]) -> void

      # _@return_ — the memory note's text, stripped; "" when it doesn't exist yet
      def memory: () -> String

      attr_reader documents: Puri::Core::Config::Documents

      # _@return_ — `fileindex_search` and `fileindex_read`, stateless, so every
      # agent shares them; empty when no index holds the folder
      attr_reader file_index_tools: ::Array[Pikuri::Tool]
    end

    # "What's the weather like in Lisbon?": the `weather` tool, a forecast from Open-Meteo at a
    # place OpenStreetMap finds, in GNOME's units (`D_weather`).
    # 
    #   open_meteo = Weather::OpenMeteo.new(http:)   # one per process, on the place tools' Http
    #   configurator.add_tool(Weather::ForecastTool.new(open_meteo:, osm:, notebook:, units: Weather::Units.gnome,
    #                                                   today: Date.today))
    # 
    # {OpenMeteo} asks for the whole forecast and reads it into a {Forecast}; {ForecastTool}
    # finds the place through the place tools' `Places::Ends`, cuts the days asked for out of it
    # and words them.
    module Weather
      CREDIT: String
      CREDIT_URL: String

      # What a forecast is shown in: GNOME's choice, so Puri says what GNOME Weather and the
      # shell's clock say.
      # 
      #   Units.gnome   # => Units(temperature: :celsius, wind: :kmh, precipitation: :mm) on a metric desktop
      #   units.wind_label        # => "km/h"
      #   units.wind_speed(17.24) # => 17; with wind: :bft, Open-Meteo's 9.2 m/s => force 5
      # 
      # GNOME keeps temperature and wind in `org.gnome.GWeather4`; precipitation follows its
      # distance unit, miles meaning inches. Each key's `default` follows the locale's
      # `LC_MEASUREMENT`: imperial gives °F, mph and inches, anything else °C, km/h and mm.
      # 
      # @!attribute [r] temperature
      #   @return [Symbol] `:celsius` or `:fahrenheit`
      # @!attribute [r] wind
      #   @return [Symbol] `:kmh`, `:ms`, `:mph`, `:kn` or `:bft`
      # @!attribute [r] precipitation
      #   @return [Symbol] `:mm` or `:inch`
      class Units
        LOGGER: Logger
        SCHEMA: String
        WINDS: ::Hash[String, Symbol]
        WIND_LABELS: ::Hash[Symbol, String]
        BEAUFORT: ::Array[Float]

        # _@param_ `settings` — the `temperature-unit`, `speed-unit` and `distance-unit` keys, as `gsettings get` prints them, quotes stripped; a key missing is `default`
        # 
        # _@param_ `imperial` — whether the locale measures in imperial units
        def self.from: (::Hash[String, String] settings, imperial: bool) -> Puri::Core::Weather::Units

        # This desktop's units. A machine without GNOME's schema, or without `gsettings`, gets the
        # locale's.
        def self.gnome: () -> Puri::Core::Weather::Units

        # _@param_ `key`
        # 
        # _@return_ — its value, quotes stripped; nil when it can't be read
        def self.gsetting: (String key) -> String?

        # _@return_ — whether `LC_MEASUREMENT` says imperial: glibc's `measurement=2`
        def self.imperial_locale?: () -> bool

        # _@return_ — "°C" or "°F"
        def temperature_label: () -> String

        # _@return_ — "km/h", "m/s", "mph", "kn" or "Bft"
        def wind_label: () -> String

        # _@return_ — "mm" or "in"
        def precipitation_label: () -> String

        # _@return_ — Open-Meteo's `temperature_unit`
        def open_meteo_temperature: () -> String

        # _@return_ — Open-Meteo's `wind_speed_unit`; Beaufort, which it lacks, comes as m/s
        def open_meteo_wind: () -> String

        # _@return_ — Open-Meteo's `precipitation_unit`
        def open_meteo_precipitation: () -> String

        # _@param_ `speed` — as Open-Meteo answered it
        # 
        # _@return_ — rounded in these units: m/s become a Beaufort force
        def wind_speed: (Float? speed) -> Integer?

        # _@param_ `metres_per_second`
        # 
        # _@return_ — 0 to 12
        def beaufort: (Float metres_per_second) -> Integer

        # _@return_ — `:celsius` or `:fahrenheit`
        attr_reader temperature: Symbol

        # _@return_ — `:kmh`, `:ms`, `:mph`, `:kn` or `:bft`
        attr_reader wind: Symbol

        # _@return_ — `:mm` or `:inch`
        attr_reader precipitation: Symbol
      end

      # One place's weather as Open-Meteo answered it, in the place's own time and in the
      # {Units} asked for: now, a line a day, and each hour.
      # 
      #   forecast = open_meteo.forecast(lat: 38.72, lon: -9.14, units:)
      #   forecast.today              # => #<Date 2026-11-22>, the place's
      #   forecast.days.last.date     # => #<Date 2026-12-06>: the last day with data, 14 or 15 ahead
      #   forecast.hours_of(forecast.today).first.clock   # => "00:00"
      # 
      # Any value but a time may be nil, where the weather models have none.
      # 
      # @!attribute [r] timezone
      #   @return [String] the place's, "Europe/Lisbon"
      # @!attribute [r] now
      #   @return [Puri::Core::Weather::Forecast::Now]
      # @!attribute [r] days
      #   @return [Array<Puri::Core::Weather::Forecast::Day>] in order, past days first
      # @!attribute [r] hours
      #   @return [Array<Puri::Core::Weather::Forecast::Hour>] in order, over the same days
      class Forecast
        # _@return_ — the place's today, which may not be the machine's
        def today: () -> Date

        # _@param_ `date`
        def day: (Date date) -> Puri::Core::Weather::Forecast::Day?

        # _@param_ `date`
        def hours_of: (Date date) -> ::Array[Puri::Core::Weather::Forecast::Hour]

        # _@return_ — the place's, "Europe/Lisbon"
        attr_reader timezone: String

        attr_reader now: Puri::Core::Weather::Forecast::Now

        # _@return_ — in order, past days first
        attr_reader days: ::Array[Puri::Core::Weather::Forecast::Day]

        # _@return_ — in order, over the same days
        attr_reader hours: ::Array[Puri::Core::Weather::Forecast::Hour]

        # The weather at the moment, from Open-Meteo's 15-minute data.
        # 
        # @!attribute [r] time
        #   @return [String] local, "2026-11-22T15:15"
        # @!attribute [r] condition
        #   @return [String, nil] "overcast"
        # @!attribute [r] temperature
        #   @return [Float, nil]
        # @!attribute [r] feels_like
        #   @return [Float, nil]
        # @!attribute [r] wind
        #   @return [Integer, nil] in {Units#wind_label}
        class Now
          def date: () -> Date

          # _@return_ — "15:15"
          def clock: () -> String

          # _@return_ — local, "2026-11-22T15:15"
          attr_reader time: String

          # _@return_ — "overcast"
          attr_reader condition: String?

          attr_reader temperature: Float?

          attr_reader feels_like: Float?

          # _@return_ — in {Units#wind_label}
          attr_reader wind: Integer?
        end

        # @!attribute [r] date
        #   @return [Date]
        # @!attribute [r] condition
        #   @return [String, nil] the day's most significant weather, "slight rain showers"
        # @!attribute [r] high
        #   @return [Float, nil]
        # @!attribute [r] low
        #   @return [Float, nil]
        # @!attribute [r] precipitation
        #   @return [Float, nil] rain and snow together, as water
        # @!attribute [r] chance
        #   @return [Integer, nil] the likeliest hour's chance of any, in per cent
        # @!attribute [r] wind
        #   @return [Integer, nil] the strongest, in {Units#wind_label}
        # @!attribute [r] sunrise
        #   @return [String, nil] "07:39"
        # @!attribute [r] sunset
        #   @return [String, nil] "16:04"
        class Day
          attr_reader date: Date

          # _@return_ — the day's most significant weather, "slight rain showers"
          attr_reader condition: String?

          attr_reader high: Float?

          attr_reader low: Float?

          # _@return_ — rain and snow together, as water
          attr_reader precipitation: Float?

          # _@return_ — the likeliest hour's chance of any, in per cent
          attr_reader chance: Integer?

          # _@return_ — the strongest, in {Units#wind_label}
          attr_reader wind: Integer?

          # _@return_ — "07:39"
          attr_reader sunrise: String?

          # _@return_ — "16:04"
          attr_reader sunset: String?
        end

        # @!attribute [r] time
        #   @return [String] local, "2026-11-22T15:00"
        # @!attribute [r] condition
        #   @return [String, nil]
        # @!attribute [r] temperature
        #   @return [Float, nil]
        # @!attribute [r] precipitation
        #   @return [Float, nil] over the hour before
        # @!attribute [r] chance
        #   @return [Integer, nil] in per cent
        # @!attribute [r] wind
        #   @return [Integer, nil] in {Units#wind_label}
        class Hour
          def date: () -> Date

          # _@return_ — "15:00"
          def clock: () -> String

          # _@return_ — local, "2026-11-22T15:00"
          attr_reader time: String

          attr_reader condition: String?

          attr_reader temperature: Float?

          # _@return_ — over the hour before
          attr_reader precipitation: Float?

          # _@return_ — in per cent
          attr_reader chance: Integer?

          # _@return_ — in {Units#wind_label}
          attr_reader wind: Integer?
        end
      end

      # Open-Meteo's forecast API: free, keyless, the data CC BY 4.0 (`R_open_meteo`).
      # 
      #   open_meteo = OpenMeteo.new(http: Http.new)
      #   forecast = open_meteo.forecast(lat: 38.7223, lon: -9.1393, units: Units.gnome, cancellable:)
      #   forecast.days.size   # => 15 or 16: today and what follows, in Lisbon's time
      # 
      # Every call asks for the whole forecast, so asking again about the same place within
      # {MAX_AGE} costs no request. The point goes out rounded to {PRECISION} decimals, about a
      # kilometre, finer than the weather models' grid, so a home address's exact point never
      # reaches Open-Meteo.
      # 
      # Thread-safe.
      class OpenMeteo
        URL: String
        MAX_AGE: Integer
        PRECISION: Integer
        FORECAST_DAYS: Integer
        AHEAD: Integer
        PAST_DAYS: Integer
        CONDITIONS: ::Hash[Integer, String]
        CURRENT: String
        DAILY: String
        HOURLY: String

        # _@param_ `http` — shared with the place tools, so its pacing covers all
        # 
        # _@param_ `url` — the API's base, without `/v1`
        def initialize: (http: Puri::Core::Http, ?url: String) -> void

        # _@param_ `lat`
        # 
        # _@param_ `lon`
        # 
        # _@param_ `units`
        # 
        # _@param_ `past_days` — days before today to include, up to {PAST_DAYS}
        # 
        # _@param_ `cancellable`
        def forecast: (
                        lat: Float,
                        lon: Float,
                        units: Puri::Core::Weather::Units,
                        ?past_days: Integer,
                        ?cancellable: Pikuri::Agent::Control::Cancellable
                      ) -> Puri::Core::Weather::Forecast

        # _@param_ `json`
        # 
        # _@param_ `units`
        def read: (::Hash[String, Object] json, Puri::Core::Weather::Units units) -> Puri::Core::Weather::Forecast

        # _@param_ `current`
        # 
        # _@param_ `units`
        def now: (::Hash[String, Object] current, Puri::Core::Weather::Units units) -> Puri::Core::Weather::Forecast::Now

        # _@param_ `daily` — columns, one per variable
        # 
        # _@param_ `units`
        def days: (::Hash[String, ::Array[Object]] daily, Puri::Core::Weather::Units units) -> ::Array[Puri::Core::Weather::Forecast::Day]

        # _@param_ `hourly` — columns, one per variable
        # 
        # _@param_ `units`
        def hours: (::Hash[String, ::Array[Object]] hourly, Puri::Core::Weather::Units units) -> ::Array[Puri::Core::Weather::Forecast::Hour]

        # _@param_ `code`
        def condition: (Integer? code) -> String?
      end

      # `weather`: the weather at a place, now and over the days asked, from Open-Meteo.
      # 
      #   tool = ForecastTool.new(open_meteo:, osm:, notebook:, units: Units.gnome, today: Date.today)
      #   tool.run('place' => 'Jumbo Vantaa').content
      #   # => Weather for [1] Jumbo (mall), Vantaanportinkatu 3, 01510 Vantaa, in its local time (Europe/Helsinki).
      #   #
      #   #    Now, 16:45: partly cloudy, 0 °C, feels like -5 °C, wind 17 km/h.
      #   #    Sun 22 Nov: light drizzle, 0 to 1 °C, precipitation 0.7 mm, 61 % chance, wind up to 18 km/h.
      #   #    Mon 23 Nov: …
      # 
      # No dates: today and the {DAYS} after it, a line a day, so "tomorrow" and "this weekend" are
      # lines to read, not dates to work out. `from` alone: that one day every {STEP} hours, with
      # its sunrise and sunset. Both: the range, a trip's say. `to` alone: today until then, or
      # that one day when it's past. Days are the place's own, and a range past the forecast's
      # last day is cut there, and says so.
      # 
      # The place resolves as `route`'s ends do, so it gets a number, and the result names what it
      # matched (`D_places`).
      # 
      # Sharing: P_one_agent, through its {Places::Notebook}, which is one conversation's.
      class ForecastTool < Pikuri::Tool
        DAYS: Integer
        STEP: Integer
        DESCRIPTION: String

        # _@param_ `open_meteo`
        # 
        # _@param_ `osm` — what finds the place
        # 
        # _@param_ `notebook` — the conversation's, which numbers the place
        # 
        # _@param_ `units`
        # 
        # _@param_ `today` — the machine's, for the description's last date
        def initialize: (
                          open_meteo: Puri::Core::Weather::OpenMeteo,
                          osm: Puri::Core::Places::Osm,
                          notebook: Puri::Core::Places::Notebook,
                          units: Puri::Core::Weather::Units,
                          today: Date
                        ) -> void

        # _@param_ `arguments` — the model's
        # 
        # _@return_ — "Lisbon, 3–6 Dec"
        def describe_call: (::Hash[untyped, untyped] arguments) -> String

        # _@param_ `text` — the model's place
        # 
        # _@param_ `from_text`
        # 
        # _@param_ `to_text`
        # 
        # _@param_ `cancellable`
        def weather: (
                       String text,
                       String? from_text,
                       String? to_text,
                       Pikuri::Agent::Control::Cancellable cancellable
                     ) -> Pikuri::Tool::Result

        # _@param_ `text`
        # 
        # _@param_ `name` — the parameter's
        def date: (String? text, String name) -> Date?

        # _@param_ `earliest` — the earliest day asked
        # 
        # _@return_ — days back to ask for, a day to spare where the place's today is ahead
        # of the machine's
        def past_days: (Date? earliest) -> Integer

        # _@param_ `head`
        # 
        # _@param_ `forecast`
        # 
        # _@param_ `from`
        # 
        # _@param_ `to`
        def answer: (
                      String head,
                      Puri::Core::Weather::Forecast forecast,
                      Date? from,
                      Date? to
                    ) -> Pikuri::Tool::Result

        # _@param_ `forecast`
        # 
        # _@param_ `day`
        # 
        # _@return_ — the day's line, its hours every {STEP} from now on, its sun
        def one_day: (Puri::Core::Weather::Forecast forecast, Puri::Core::Weather::Forecast::Day day) -> ::Array[String]

        # _@param_ `now`
        # 
        # _@return_ — "Now, 16:45: partly cloudy, 0 °C, feels like -5 °C, wind 17 km/h."
        def now_line: (Puri::Core::Weather::Forecast::Now now) -> String

        # _@param_ `day`
        # 
        # _@return_ — "Sun 22 Nov: light drizzle, 0 to 1 °C, precipitation 0.7 mm, 61 % chance, …"
        def day_line: (Puri::Core::Weather::Forecast::Day day) -> String

        # _@param_ `hour`
        # 
        # _@return_ — "15:00: overcast, 5 °C, precipitation 0.2 mm, 40 % chance, wind 12 km/h."
        def hour_line: (Puri::Core::Weather::Forecast::Hour hour) -> String

        # _@param_ `days`
        # 
        # _@return_ — "Light drizzle, 0 to 1 °C" for one day, "7 days, -11 to 2 °C" for more
        def summary: (::Array[Puri::Core::Weather::Forecast::Day] days) -> String

        # _@param_ `words`
        # 
        # _@return_ — the given ones, comma-separated
        def parts: (*::Array[String?] words) -> String

        # _@param_ `day`
        # 
        # _@return_ — "0 to 1 °C"
        def spread: (Puri::Core::Weather::Forecast::Day day) -> String?

        # _@param_ `value`
        # 
        # _@return_ — "-5 °C"
        def degrees: (Float? value) -> String?

        # _@param_ `amount`
        # 
        # _@param_ `chance`
        # 
        # _@return_ — "precipitation 0.7 mm", "61 % chance", either missing
        def precipitation: (Float? amount, Integer? chance) -> ::Array[String]

        # _@param_ `words` — "wind" or "wind up to"
        # 
        # _@param_ `speed`
        # 
        # _@return_ — "wind up to 18 km/h"
        def wind: (String words, Integer? speed) -> String?

        # _@param_ `date`
        # 
        # _@return_ — "Sun 22 Nov"
        def day_name: (Date date) -> String

        # _@param_ `from`
        # 
        # _@param_ `to`
        # 
        # _@return_ — "3–6 Dec", "30 Nov – 2 Dec", "3 Dec", "until 6 Dec"; a date that
        # doesn't parse as the model wrote it
        def span: (String? from, String? to) -> String?

        # _@param_ `text`
        # 
        # _@return_ — "3 Dec"
        def short: (String? text) -> String?

        # A date the model wrote that isn't one; the message is for the model.
        class BadDate < StandardError
        end
      end
    end

    # Asks the user in the transcript: a tool's `ask` shows a {Protocol::Confirmation} and waits
    # on the turn's thread until the user answers from the main loop.
    # 
    #   confirmer.ask(request:, cancellable:)  # turn thread: a pending Confirmation, activity confirming
    #   confirmer.answer('b4', true)           # main loop: Update → Approved
    #   confirmer.answer('b4', false)          # Cancel → Rejected
    #   confirmer.redirect('make it Wed')      # typed text → Redirected('make it Wed')
    #   cancellable.cancel!                    # Escape, close, quit → ask raises Cancellable::Cancelled
    # 
    # Whichever way it ends, the Confirmation is re-sent with its final state. `D_confirmation_answers`
    # has why each gesture is the answer it is.
    # 
    # One per conversation, built with its agent, since tools take their confirmer when they're
    # built. An answer meant for a confirmation that no longer waits is dropped.
    # 
    # == Implementation details
    # 
    # The pending confirmation is guarded by the core's lock, which {Conversation} takes too, so
    # showing it and marking it pending are one step for {#pending?}. A parked `ask` waits in a
    # `Pikuri::Agent::Control::Handoff` on the asking turn's Cancellable, so any cancel of that
    # turn reaches it.
    # 
    # Thread-safe.
    class Confirmer < Pikuri::Workspace::Confirmer
      # _@param_ `conversation` — where the question shows
      # 
      # _@param_ `lock` — the core's
      def initialize: (Puri::Core::Conversation conversation, lock: Monitor) -> void

      # The question is the tool's, sanitized; its detail follows it, and a spoof the sanitizer
      # found leads it. The button always says "Approve", never destructive: pikuri's `Request`
      # carries no label, and the first tool that needs one adds it there, not a table here.
      # 
      # _@param_ `request`
      # 
      # _@param_ `cancellable` — the asking turn's
      def ask: (request: Pikuri::Workspace::Confirmer::Request, cancellable: Pikuri::Agent::Control::Cancellable) -> (Pikuri::Workspace::Confirmer::Approved | Pikuri::Workspace::Confirmer::Rejected | Pikuri::Workspace::Confirmer::Redirected)

      # _@param_ `confirmation` — the block id the user answered
      # 
      # _@param_ `approved`
      def answer: (String confirmation, bool approved) -> void

      # _@param_ `text` — what the user typed while the confirmation waits
      # 
      # _@return_ — false when no confirmation waits for an answer, and `text` is the
      # caller's to send on
      def redirect: (String text) -> bool

      # _@return_ — whether a confirmation waits for the user
      def pending?: () -> bool

      # Hands the waiting `ask` its answer; the caller holds the lock.
      # 
      # _@param_ `answer`
      # 
      # _@return_ — false when no question waits for one, or it has its answer already
      def hand: ((Symbol | [Symbol, String]) answer) -> bool

      # _@param_ `request`
      # 
      # _@param_ `handoff`
      def decide: (Pikuri::Workspace::Confirmer::Request request, Pikuri::Agent::Control::Handoff handoff) -> (Pikuri::Workspace::Confirmer::Approved | Pikuri::Workspace::Confirmer::Rejected | Pikuri::Workspace::Confirmer::Redirected)

      # _@param_ `state` — the Confirmation's final state
      # 
      # _@param_ `decision`
      # 
      # _@return_ — `decision`
      def settle: (String state, Object? decision) -> Object?

      # _@param_ `request`
      # 
      # _@return_ — plain text
      def question: (Pikuri::Workspace::Confirmer::Request request) -> String
    end

    # The mic in the prompt (`D_dictation`): one clip per press, recorded by {Recorder},
    # transcribed by {Transcriber} on the user's own server or by {WhisperCli} on this machine,
    # every step a {Protocol::DictationChanged}.
    # 
    #   dictation = Dictation.new(transcriber: Dictation.transcriber(config.dictation)) { |event| … }
    #   dictation.toggle   # listening, its level ~15 times a second
    #   dictation.toggle   # transcribing, then idle with text: "Buy avocados."
    #   dictation.cancel   # Escape: idle, nothing inserted; a late transcription is dropped
    # 
    # A clip under {MIN_SECONDS} isn't sent: a stray press would cost the server's 7 s floor.
    # 
    # Thread-safe; {#toggle} and {#cancel} return at once, the recorder stopping and the server
    # answering on a thread of their own.
    class Dictation
      LISTENING: String
      TRANSCRIBING: String
      MIN_SECONDS: Float
      LOGGER: Logger

      # _@param_ `table`
      # 
      # _@return_ — the
      # server's with a `url`, else `whisper-cli`
      def self.transcriber: (Puri::Core::Config::DictationTable table) -> (Puri::Core::Dictation::Transcriber | Puri::Core::Dictation::WhisperCli)

      # What to insert of Whisper's text:
      # 
      #   Dictation.squeeze(" Buy avocados\n and limes.\n")   # => "Buy avocados and limes."
      #   Dictation.squeeze(" [BLANK_AUDIO]\n")                # => ""
      # 
      # _@param_ `text` — as Whisper wrote it, a segment a line
      # 
      # _@return_ — squeezed to single spaces; empty when Whisper heard only its bracketed tags
      def self.squeeze: (String text) -> String

      # _@param_ `transcriber`
      # 
      # _@param_ `command` — the {Recorder}'s
      def initialize: (transcriber: (Puri::Core::Dictation::Transcriber | Puri::Core::Dictation::WhisperCli | untyped), ?command: ::Array[String]) ?{ (Puri::Protocol::DictationChanged event) -> void } -> void

      # F5: starts listening, or stops and transcribes what was heard; a press while it
      # transcribes does nothing. {DictationChanged} reports each step, its `idle` carrying the
      # text.
      def toggle: () -> void

      # Escape: drops the recording, or the transcription on its way, and clears a failure;
      # nothing is inserted.
      def cancel: () -> void

      # Stops the mic, waiting for the recorder to exit.
      def close: () -> void

      # _@return_ — the one recording, now forgotten
      def drop: () -> Puri::Core::Dictation::Recorder?

      def listen: () -> void

      # _@param_ `clip`
      # 
      # _@param_ `level`
      def heard: (Integer clip, Float level) -> void

      def stop: () -> void

      # _@param_ `recorder`
      # 
      # _@param_ `clip`
      def transcribe: (Puri::Core::Dictation::Recorder recorder, Integer clip) -> void

      # _@param_ `clip`
      # 
      # _@param_ `state`
      # 
      # _@return_ — whether `clip` is still the one in `state`, not cancelled or replaced
      def current?: (Integer clip, String state) -> bool

      # _@param_ `status`
      def failed: (String status) -> void

      # _@param_ `state`
      # 
      # _@param_ `fields` — the rest of the {Protocol::DictationChanged}
      def change: (String state, **::Hash[Symbol, Object] fields) -> void

      # One clip from the mic: `pw-record`'s raw PCM, 16 kHz mono s16le, read as it records,
      # its level reported on the way.
      # 
      #   recorder = Recorder.new { |level| show(level) }   # 0..1, ~15 times a second
      #   pcm = recorder.stop                               # or recorder.cancel
      #   pcm.bytesize / Recorder::BYTES_PER_SECOND         # => seconds heard
      # 
      # The command is any that writes such PCM to stdout and stops on SIGINT; specs `cat` a
      # file, which ends by itself, and the clip then waits for {#stop} all the same.
      # 
      # Thread-safe.
      class Recorder
        COMMAND: ::Array[String]
        BYTES_PER_SECOND: Integer
        LEVEL_INTERVAL: Float
        FLOOR_DB: Float
        STOP_SECONDS: Integer

        # _@param_ `command`
        def initialize: (?command: ::Array[String]) ?{ (Float level) -> void } -> void

        # Stops recording.
        # 
        # _@return_ — the PCM heard, binary; empty when stopped before the first chunk
        def stop: () -> String

        # Stops recording and forgets the clip.
        def cancel: () -> void

        def finish: () -> void

        # _@param_ `name`
        def signal: (String name) -> void

        def read: () -> void

        # _@param_ `chunk`
        def measure: (String chunk) -> void

        # _@return_ — the RMS since the last level, in dBFS mapped from {FLOOR_DB}..0 to 0..1
        def level: () -> Float

        # _@return_ — the command's first line on stderr, or its exit status
        def failure: () -> String

        def clock: () -> Float

        # Raised when the command can't start, or dies before giving any sound.
        class Error < StandardError
        end
      end

      # Turns a clip into text on the `[dictation]` server, OpenAI's `/v1/audio/transcriptions`,
      # through a RubyLLM context of its own rather than pikuri (`D_dictation`).
      # 
      #   transcriber = Transcriber.new(config.dictation)
      #   transcriber.transcribe(pcm)   # => "Buy avocados and limes."
      #   transcriber.transcribe(hush)  # => "" for whisper-server's " [BLANK_AUDIO]\n"
      # 
      # == Implementation details
      # 
      # whisper-server reports a failure as HTTP 200 with `{"error": …}`, which RubyLLM reads as
      # `text: nil`, its message lost; that raises here. No retries: a dead server should say so
      # at once, and a retry would cost the encoder's 7 s floor again.
      # 
      # Thread-safe.
      class Transcriber
        TIMEOUT: Integer

        # _@param_ `table`
        # 
        # _@param_ `faraday_adapter` — what specs script the server with; nil for RubyLLM's own
        def initialize: (Puri::Core::Config::DictationTable table, ?faraday_adapter: (Class | Symbol)?) -> void

        # _@param_ `pcm` — 16 kHz mono s16le, as {Recorder#stop} returns it
        # 
        # _@return_ — the text squeezed to single spaces; empty when Whisper heard only its
        # bracketed tags, `[BLANK_AUDIO]` and the like
        def transcribe: (String pcm) -> String

        # _@param_ `pcm` — 16 kHz mono s16le
        # 
        # _@return_ — `pcm` behind a 44-byte WAV header, binary
        def self.wav: (String pcm) -> String

        # Raised when the server can't be reached or transcribes nothing.
        class Error < StandardError
        end
      end

      # Turns a clip into text with apt's `whisper-cli`, run once per clip on the `[dictation]`
      # model, so no process holds that model between clips (`D_embedded`):
      # 
      #   whisper = WhisperCli.new(config.dictation)
      #   whisper.transcribe(pcm)   # => "Buy avocados and limes."
      # 
      # The WAV goes in on stdin and the text comes out on stdout, so the voice never touches the
      # disk. The model is looked up in the {HubCache} at every clip: one downloaded while Puri runs
      # works from the next press.
      # 
      # == Implementation details
      # 
      # `-np` keeps whisper.cpp's log off stderr, its own reason for a failure with it: a missing
      # model reads only "failed to initialize whisper context", hence the lookup first
      # (`R_whisper_cli`).
      # 
      # Thread-safe.
      class WhisperCli
        COMMAND: ::Array[String]
        TIMEOUT: Integer

        # _@param_ `table` — one with no `url`
        # 
        # _@param_ `cache` — where the model is
        # 
        # _@param_ `command` — what runs `whisper-cli`; specs run a stand-in
        # 
        # _@param_ `timeout` — seconds a clip may take; specs shorten it
        def initialize: (
                          Puri::Core::Config::DictationTable table,
                          ?cache: Puri::Core::HubCache,
                          ?command: ::Array[String],
                          ?timeout: Numeric
                        ) -> void

        # _@param_ `pcm` — 16 kHz mono s16le, as {Recorder#stop} returns it
        # 
        # _@return_ — see {Dictation.squeeze}
        def transcribe: (String pcm) -> String

        # _@param_ `model` — the file's path
        # 
        # _@param_ `wav`
        # 
        # _@return_ — stdout, stderr and how it ended
        def run: (String model, String wav) -> [String, String, Process::Status]

        # _@param_ `stdin`
        # 
        # _@param_ `wav`
        def feed: (IO stdin, String wav) -> void

        # _@param_ `pid`
        def kill: (Integer pid) -> void

        # _@param_ `err`
        def last_line: (String err) -> String?

        # Raised when the model isn't downloaded, or whisper-cli can't run or fails.
        class Error < StandardError
        end
      end
    end

    # Hugging Face's hub cache, where llama-server's `-hf` keeps the models it downloads: Puri
    # looks there for the models it runs itself, llama-server's and whisper-cli's alike.
    # 
    #   cache = HubCache.new
    #   cache.gguf('ggml-org/Qwen3.5-4B-GGUF:Q4_K_M')      # => ".../snapshots/8d43…/Qwen3.5-4B-Q4_K_M.gguf"
    #   cache.file('ggerganov/whisper.cpp:ggml-small.bin')  # => ".../snapshots/5359…/ggml-small.bin"
    #   cache.file('ggerganov/whisper.cpp:ggml-base.bin')   # => nil: not downloaded
    # 
    # The layout is `huggingface_hub`'s: `models--<org>--<repo>/refs/main` names a commit, and
    # `snapshots/<commit>/<file>` links to the file's blob. Offline, llama.cpp finds a file the
    # same way (`R_hub_cache`).
    # 
    # Immutable.
    class HubCache
      GGUF_MODEL: Regexp
      FILE_MODEL: Regexp
      DEFAULT_QUANT: String

      # _@param_ `env` — where `LLAMA_CACHE`, `HF_HUB_CACHE`, `HF_HOME`, `XDG_CACHE_HOME` and `HOME` come from, in that order, as llama.cpp reads them; specs pass their own
      def initialize: (?env: untyped) -> void

      # _@param_ `env`
      def self.root: (untyped env) -> String

      # Which of a repo's files `-hf org/repo:quant` loads: the first GGUF, sorted, whose path holds
      # the quant, case aside, never a vision projector. A big model's split parts may sit in a
      # folder named for the quant, `UD-Q4_K_XL/…-00001-of-00003.gguf`.
      # 
      #   HubCache.pick_gguf(%w[mmproj-Q4_K_M.gguf Qwen-Q4_K_M.gguf Qwen-Q8_0.gguf], 'q4_k_m')   # => "Qwen-Q4_K_M.gguf"
      # 
      # _@param_ `paths` — the repo's files, relative to it
      # 
      # _@param_ `quant` — nil for {DEFAULT_QUANT}
      # 
      # _@return_ — one of `paths`; nil when none fits
      def self.pick_gguf: (::Array[String] paths, String? quant) -> String?

      # The GGUF file `-hf model` loads, by {.pick_gguf}.
      # 
      # _@param_ `model` — matching {GGUF_MODEL}
      # 
      # _@return_ — its path; nil when it isn't downloaded
      def gguf: (String model) -> String?

      # _@param_ `model` — matching {FILE_MODEL}
      # 
      # _@return_ — its path; nil when it isn't downloaded
      def file: (String model) -> String?

      # _@param_ `repo` — `org/repo`
      # 
      # _@return_ — the repo's folder in the cache, perhaps missing
      def repo_dir: (String repo) -> String

      # _@param_ `repo` — `org/repo`
      # 
      # _@return_ — the snapshot `refs/main` names, when it exists
      def snapshot: (String repo) -> String?

      # _@return_ — the cache's directory, perhaps missing
      attr_reader root: String
    end

    # The backend: each conversation a pikuri agent on the configured model, hosted by
    # `Pikuri::Conversations`, everything reported as {Protocol} events.
    # 
    #   core = PikuriCore.new(config:, models: Models.from_config(config), titler:, store:) { |event| … }
    #   id = core.ask(nil, 'how do I keep an avocado?')
    #   core.select_model(id, 'Qwen 3.6')   # its next turn, and every new conversation's
    #   core.load_conversation(id).blocks   # => [UserMessage, Reply] once it has answered
    #   core.list_conversations.first.title  # => "Keeping An Avocado Fresh", once titled
    #   core.close                           # stops every turn, closes every agent
    # 
    # Every conversation the store holds is listed from the start, and read in when it's first
    # loaded or asked in; each is saved after every turn, and deleting one removes it from disk. A
    # new conversation is "New conversation" until the titler names it, once its first turn has
    # ended; a title that fails is logged, and the name stays until a later turn.
    # 
    # A new conversation starts on the model picked last, the first `[[llm]]` until a pick; a
    # saved one resumes on the connection it was saved on, while the config still has it.
    # 
    # Thread-safe.
    class PikuriCore
      include Puri::Protocol::Backend
      SHELL: String
      LOGGER: Logger
      CLOSE_SECONDS: Integer

      # The core `config` describes: conversations on its first `[[llm]]`, titles on its
      # `[titler]`, and `web_search` and `web_read_cached` on its `[search]` engines, which
      # return the page text the reader reads (`D_search_engines`). Without a Brave or Exa key it
      # logs an error and wires no web tools, and the system prompt says so. With `[documents]`,
      # builds that folder's {Library}; with `[maps]`, the place tools, and with `[weather]` too,
      # the weather tool, both on one {Http}; with `[dictation]`, the mic's transcriber. Starts
      # the {LlamaServer} of a `[[server]]` with no `url`, which {#close} stops. Also sets each
      # `[[server]]`'s `max_concurrent_requests` as that server's
      # `Pikuri::Conversations::Throttle.limit`, which is process-wide; a server stating none is
      # sized from its own slot count.
      # 
      #   core = PikuriCore.from_config(Config.load, store: PikuriCore.store) { |event| … }
      # 
      # _@param_ `config`
      # 
      # _@param_ `store`
      def self.from_config: (Puri::Core::Config config, store: Pikuri::Conversations::Store) ?{ (Data event) -> void } -> Puri::Core::PikuriCore

      # Plugs the document extractors into pikuri's registry, process-wide, so `read`,
      # `web_read_cached` and `mail_attachment_read` turn a PDF or an office file into text.
      # 
      #   PikuriCore.register_extractors   # => Pikuri::Extractors::DOCUMENTS where podman or docker is
      # 
      # With podman or docker on `PATH`, pikuri-extractors' office files and PDFs, converted in a
      # networkless container; without, pikuri-pdf's PDFs alone (`D_extractors`). Registering twice
      # is harmless.
      # 
      # _@return_ — the extractor registered
      def self.register_extractors: () -> (Pikuri::Extractors::Documents | Module)

      # The saved conversations, in pikuri-web's folder format (`D_port_pikuri_web`).
      # 
      # _@param_ `env` — where `XDG_STATE_HOME` comes from
      # 
      # _@return_ — at `$XDG_STATE_HOME/puri/conversations`,
      # `~/.local/state` by default
      def self.store: (?env: untyped) -> Pikuri::Conversations::Store

      # Puri's cache; not created here.
      # 
      # _@param_ `env` — where `XDG_CACHE_HOME` comes from
      # 
      # _@return_ — `$XDG_CACHE_HOME/puri`, `~/.cache/puri` by default
      def self.cache_dir: (?env: untyped) -> String

      # _@param_ `config` — what each conversation's agent is built from
      # 
      # _@param_ `models` — where conversations run
      # 
      # _@param_ `titler` — names each new conversation from its first message
      # 
      # _@param_ `store` — where conversations are saved
      # 
      # _@param_ `library` — the documents folder every agent searches
      # 
      # _@param_ `osm` — what every agent's place tools ask, with `[maps]`; one for all, so its pacing covers them all
      # 
      # _@param_ `open_meteo` — what every agent's weather tool asks, with `[weather]`
      # 
      # _@param_ `rhythmbox` — what every agent's `play_music` plays in; nil wires none
      # 
      # _@param_ `transcriber` — what the mic's clips go to; nil, and the prompt has no mic
      # 
      # _@param_ `llama_server` — the one Puri runs, started; {#close} stops it
      def initialize: (
                        config: Puri::Core::Config,
                        models: Puri::Core::Models,
                        titler: Pikuri::Conversations::Titler,
                        store: Pikuri::Conversations::Store,
                        ?library: Puri::Core::Library?,
                        ?osm: Puri::Core::Places::Osm?,
                        ?open_meteo: Puri::Core::Weather::OpenMeteo?,
                        ?rhythmbox: Puri::Core::Music::Rhythmbox?,
                        ?transcriber: (Puri::Core::Dictation::Transcriber | Puri::Core::Dictation::WhisperCli)?,
                        ?llama_server: Puri::Core::LlamaServer?
                      ) ?{ (Data event) -> void } -> void

      # Sends the user's message. With a confirmation pending, the message answers it as a
      # redirect: the model follows the words and proposes again. With a turn running, it waits,
      # in {PendingChanged}, until the turn reads it.
      # 
      # _@param_ `conversation` — the conversation to continue; nil starts a new one
      # 
      # _@param_ `text` — what the user typed
      # 
      # _@return_ — the conversation's id, new when `conversation` was nil
      def ask: (String? conversation, String text) -> String

      # Stops the running turn, if any; a pending confirmation ends as `cancelled`.
      # 
      # _@param_ `conversation`
      def cancel: (String conversation) -> void

      # Answers a pending {Confirmation}; one already answered is left alone.
      # 
      # _@param_ `conversation`
      # 
      # _@param_ `confirmation` — the {Confirmation}'s block id
      # 
      # _@param_ `approved` — true for its approve button, false for Cancel
      def answer: (String conversation, String confirmation, bool approved) -> void

      # _@return_ — newest first
      def list_conversations: () -> ::Array[Puri::Protocol::ConversationSummary]

      # _@param_ `conversation`
      def load_conversation: (String conversation) -> Puri::Protocol::Transcript

      def list_models: () -> Puri::Protocol::Models

      # Picks the model for a conversation's next turn, and for every new conversation after; a
      # running turn ends on its own. A {StatusChanged} follows.
      # 
      # _@param_ `conversation` — nil picks for new conversations only
      # 
      # _@param_ `model` — one of {Models#names}
      def select_model: (String? conversation, String model) -> void

      # Forgets a conversation, cancelling its turn first.
      # 
      # _@param_ `conversation`
      def delete_conversation: (String conversation) -> void

      # _@return_ — whether the prompt has a mic: false, and the dictation methods do
      # nothing, without a transcription server
      def dictation_available?: () -> bool

      # F5: starts listening, or stops and transcribes what was heard; a press while it
      # transcribes does nothing. {DictationChanged} reports each step, its `idle` carrying the
      # text.
      def toggle_dictation: () -> void

      # Escape: drops the recording, or the transcription on its way, and clears a failure;
      # nothing is inserted.
      def cancel_dictation: () -> void

      # Closes every conversation, cancelling its turn, and waits for each turn to be saved and
      # its agent closed; stops the mic, then the llama-server Puri runs. Not under the core's
      # lock: a turn's save takes it.
      def close: () -> void

      # _@param_ `id`
      # 
      # _@return_ — a saved conversation's, read in on first use
      def session: (String id) -> Puri::Core::AgentSession

      # _@return_ — the new conversation's id
      def create: () -> String

      # Lists a saved conversation; {#session} reads it in.
      # 
      # _@param_ `entry`
      def saved: (Pikuri::Conversations::Store::Entry entry) -> void

      # _@param_ `iso` — a `meta.json` value
      # 
      # _@return_ — local time; nil for anything but an ISO 8601 string
      def time: (Object iso) -> Time?

      # _@param_ `entry`
      # 
      # _@param_ `state` — a saved one's {Conversation#initialize} `title:`, `last_question:` and `asked_at:`
      def add: (Pikuri::Conversations::Store::Entry entry, **::Hash[Symbol, Object] state) -> Puri::Core::Conversation

      # _@param_ `conversation`
      # 
      # _@param_ `entry`
      # 
      # _@param_ `saved`
      def agent_session: (Puri::Core::Conversation conversation, Pikuri::Conversations::Store::Entry entry, saved: bool) -> Puri::Core::AgentSession

      # _@param_ `entry`
      # 
      # _@param_ `saved`
      # 
      # _@return_ — the connection a conversation opens on
      def start_on: (Pikuri::Conversations::Store::Entry entry, saved: bool) -> Puri::Core::Models::Choice

      def publish: () -> void
    end

    # One conversation as Desktop sees it: its blocks, its activity, its status, its title and its last
    # question, each change emitted as a {Protocol} event. Whatever runs its turns reports
    # through {#add}, {#put}, {#activity=} and {#step}, so {PikuriCore} and the dummy backend in
    # `dev/` share it:
    # 
    #   conversation = Conversation.new(id:, lock:, emit:, changed:)
    #   conversation.asked('how do I keep an avocado?')     # the question, for the history row
    #   reply = conversation.add(Protocol::Reply.new(id: nil, parts: []))   # => the block, id "b1"
    #   conversation.put(reply.with(parts:))                 # re-sent whole
    #   conversation.step(Protocol::Activity.new(state: 'streaming'))
    #   conversation.cancelling                              # "Cancelling…", until it goes idle
    #   conversation.activity = Protocol::Activity::IDLE
    #   conversation.status = Protocol::Status.new(model: 'Ornith 1.5')
    #   conversation.pending = ['and bananas?']             # typed during the turn, not yet read
    # 
    # == Threading
    # 
    # Thread-safe: every method runs under the monitor its core shares with it.
    class Conversation
      NEW_TITLE: String
      CANCELLING: Puri::Protocol::Activity

      # _@param_ `id`
      # 
      # _@param_ `lock` — the core's
      # 
      # _@param_ `emit` — takes a {Protocol} event
      # 
      # _@param_ `changed` — called when {#summary} changed
      # 
      # _@param_ `started_at`
      # 
      # _@param_ `title`
      # 
      # _@param_ `last_question`
      # 
      # _@param_ `asked_at` — when `last_question` was asked
      def initialize: (
                        id: String,
                        lock: Monitor,
                        emit: Proc,
                        changed: Proc,
                        ?started_at: Time,
                        ?title: String,
                        ?last_question: String?,
                        ?asked_at: Time?
                      ) -> void

      # Records the user's latest question, which the history shows under the title.
      # 
      # _@param_ `text`
      def asked: (String text) -> void

      # Fills in blocks from before Core started, giving each the next id; emits nothing, since
      # whoever shows this conversation loads it after.
      # 
      # _@param_ `blocks` — their ids nil
      def restore: (::Array[Puri::Protocol::Block] blocks) -> void

      # _@param_ `title`
      def title=: (String title) -> void

      # _@return_ — whether a turn runs
      def running?: () -> bool

      def summary: () -> Puri::Protocol::ConversationSummary

      def transcript: () -> Puri::Protocol::Transcript

      # Appends a block, giving it the next id.
      # 
      # _@param_ `block` — its id nil
      # 
      # _@return_ — the block as stored, id set
      def add: (Puri::Protocol::Block block) -> Puri::Protocol::Block

      # Replaces the block with this id, or appends it.
      # 
      # _@param_ `block`
      def put: (Puri::Protocol::Block block) -> Puri::Protocol::Block

      # _@param_ `activity`
      def activity=: (Puri::Protocol::Activity activity) -> void

      # Shows {CANCELLING} until the turn goes idle, which can take a while: a turn notices a
      # cancel only at its next token or tool call, and a cold prefill is up to 25 s of
      # uninterruptible HTTP read. Does nothing once the turn is idle.
      def cancelling: () -> void

      # Shows a running turn's step, unless {#cancelling} said the turn is stopping: a step it
      # still reports before it notices — a tool's call or result — must not take that back.
      # 
      # _@param_ `activity`
      def step: (Puri::Protocol::Activity activity) -> void

      # Emits nothing when it is the status already: each token count re-reads the whole.
      # 
      # _@param_ `status`
      def status=: (Puri::Protocol::Status status) -> void

      # Emits nothing when they are the texts already.
      # 
      # _@param_ `texts` — the messages the agent hasn't read yet, in its order
      def pending=: (::Array[String] texts) -> void

      attr_reader id: String

      attr_reader started_at: Time
    end

    # The llama-server Puri runs itself, for the `[[server]]` with no `url` (`D_embedded`): apt's
    # binary as a child on loopback, behind the run's key, restarted when it crashes and stopped
    # when Puri quits.
    # 
    #   server = LlamaServer.new(config.embedded_server)
    #   server.start                  # returns at once; the model loads in the child's own time
    #   server.serves?(transport)     # => true for a connection to it
    #   server.wait_ready             # once /health answers; raises Error saying why it can't
    #   server.close
    # 
    # A model missing from the {HubCache} fails without a child, saying what to download, since
    # `--offline` alone says only "exactly one out metadata, path_model, and file must be defined".
    # A crash restarts the child after {BACKOFF} seconds, doubling, and the {CRASHES}th within
    # {CRASH_WINDOW} seconds gives up, the log's tail in the error. Either way the next
    # {#wait_ready} starts over, so a model downloaded since, or memory freed since, works without
    # restarting Puri. The log is `$XDG_STATE_HOME/puri/llama-server.log`, emptied at each {#start}.
    # 
    # == Implementation details
    # 
    # One thread spawns the child and waits on it, and another polls `/health` until it answers.
    # The child runs under `setpriv --pdeathsig TERM`, which the kernel ties to the thread that
    # spawned it: the waiting one, which ends only after the child, so a killed Puri leaves no
    # model loaded (`R_llama_server_embedded`). The key goes in `LLAMA_API_KEY`, never on the
    # command line, which `/proc` shows every user.
    # 
    # Thread-safe.
    class LlamaServer
      COMMAND: ::Array[String]
      DEATH_SIGNAL: ::Array[String]
      CONTEXT: Integer
      BACKOFF: Float
      CRASHES: Integer
      CRASH_WINDOW: Integer
      READY_TIMEOUT: Integer
      STOP_SECONDS: Integer
      POLL: Float
      LOGGER: Logger

      # _@param_ `embedded`
      # 
      # _@param_ `cache` — where the model is
      # 
      # _@param_ `env` — where `XDG_STATE_HOME` comes from, for the log
      # 
      # _@param_ `command` — what runs `llama-server`; specs run a stand-in
      # 
      # _@param_ `backoff` — seconds before the first restart; specs shorten it
      def initialize: (
                        Puri::Core::Config::EmbeddedServer embedded,
                        ?cache: Puri::Core::HubCache,
                        ?env: untyped,
                        ?command: ::Array[String],
                        ?backoff: Float
                      ) -> void

      # Starts the child, unless it runs already; returns at once.
      def start: () -> void

      # _@param_ `transport`
      # 
      # _@return_ — whether it connects to this server
      def serves?: (Pikuri::Agent::ChatTransport transport) -> bool

      # _@return_ — whether `/health` has answered since the child last started
      def ready?: () -> bool

      # Blocks until the model is loaded, starting over a server that failed: Puri is resident, and
      # a cause gone since must not need its restart.
      # 
      # _@param_ `timeout` — seconds
      def wait_ready: (?timeout: Numeric) -> void

      # Stops the child and any restart, killing it after {STOP_SECONDS}.
      def close: () -> void

      # The watcher thread: the child's whole life, and each restart.
      def watch: () -> void

      # _@return_ — the child's pid; nil once closed, or when it can't start
      def launch: () -> Integer?

      def command_line: () -> ::Array[String]

      # Under the lock.
      # 
      # _@param_ `status`
      # 
      # _@return_ — seconds to wait before the restart; nil for none
      def exited: (Process::Status status) -> Float?

      # The poller thread, killed when the child exits.
      # 
      # _@param_ `pid`
      def poll: (Integer pid) -> void

      def healthy?: () -> bool

      # Under the lock.
      # 
      # _@param_ `error`
      def failed: (String error) -> void

      # _@param_ `pid`
      # 
      # _@param_ `name`
      def signal: (Integer? pid, String name) -> void

      # _@return_ — the log's last lines
      def tail: () -> String

      def clock: () -> Float

      # _@return_ — where the child's output goes
      attr_reader log: String

      # Raised by {#wait_ready} when the model can't be served.
      class Error < StandardError
      end
    end

    # A reply's Markdown as it streams in, as {Protocol::Reply} parts: each finished block is
    # converted once, and only the open tail again per delta.
    # 
    #   stream = ReplyStream.new
    #   stream.append("Keep it **cold**.\n\nOr fre")   # => [Prose("Keep it <b>cold</b>."), Prose("Or fre")]
    #   stream.append("eze it.\n")                     # => [Prose("Keep it <b>cold</b>."), Prose("Or freeze it.")]
    #   stream.finish                                   # => [Prose("Keep it <b>cold</b>.\n\nOr freeze it.")]
    # 
    # {#finish} is {ReplyRenderer.render} of the whole text; until then, {ReplyRenderer.merge} of
    # the parts equals it for the text so far, except that a reference link or footnote whose
    # definition is a block away stays literal (the gem's README, *When is a block finished?*),
    # and the footnotes' text waits for the end ({ReplyRenderer.footnotes}).
    # 
    # == Implementation details
    # 
    # The open tail stays its own part rather than merging into the finished prose before it:
    # Desktop lays out a changed part whole, at ~4 ms per KB on the main loop, so a merged run
    # would grow per delta until it stalls the UI (`D_whole_reply`). A selection reaches across the
    # tail only once the reply is finished.
    class ReplyStream
      include StreamingMarkdownParser::Listener

      def initialize: () -> void

      # _@param_ `delta`
      def append: (String delta) -> ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]

      # Renders the whole reply once more, as only the whole text resolves every reference.
      # 
      # _@param_ `final` — the reply's final text, nil for the deltas as they came
      def finish: (?String? final) -> ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]

      def parts: () -> ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]

      # _@param_ `root`
      def on_block: (Kramdown::Element root) -> void

      # _@param_ `root`
      def on_open: (Kramdown::Element root) -> void
    end

    # How a tool call reads in the transcript: the status under the progress bar while it runs,
    # and the {Protocol::ToolLine} that stays once it has answered.
    # 
    #   ToolWording.status(call)                          # => "Searching the web…"
    #   ToolWording.line(call, content:, summary:)        # => ToolLine(text: '🔍 Searched: "avocado"')
    #   ToolWording.line(weather, content:, summary:).markup
    #   # => '🌦 Weather from <a href="https://open-meteo.com/">Open-Meteo</a>: Lisbon', its {CREDITS} linked
    # 
    # `call` is the live `Pikuri::Agent::Event::ToolCall` or the saved
    # `Pikuri::Agent::History::ToolCall`, so {TurnListener} and {Replay} word a line alike. Only the
    # icon and the verb are ours: what follows them is the tool's own `argument` or `summary`
    # (pikuri's display-line seam, `Pikuri::Tool`'s *Display lines*), never the model's text.
    # 
    # A failed call is the tool's `Error:` observation, and its line is red with the tool's
    # summary, which for a failure is that message. A call a cancel cut short says so, not red.
    # A call the user declined isn't an `Error:`, so it reads as done: no tool here asks yet, and
    # the first that does needs pikuri to say the outcome, not a match on the observation's words.
    # The tool's strings are the model's arguments, so a line is flattened and defanged as
    # pikuri asks of every chrome: `Pikuri::Sanitizer` shows an escape byte, it never runs it.
    module ToolWording
      WORDINGS: ::Hash[String, Wording]
      CREDITS: ::Hash[String, [String, String]]
      BARE: ::Array[String]
      SUMMED: ::Array[String]

      # _@param_ `call`
      # 
      # _@return_ — what the turn is doing while the call runs
      def status: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call) -> String

      # _@param_ `call`
      # 
      # _@return_ — what the turn is doing while the call runs
      def self.status: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call) -> String

      # _@param_ `call`
      # 
      # _@param_ `content` — the observation the model got
      # 
      # _@param_ `summary` — the tool's one-line summary of it
      # 
      # _@return_ — with no id, for {Conversation#add} or
      # {Conversation#restore} to assign
      def line: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call, content: String, summary: String?) -> Puri::Protocol::ToolLine

      # _@param_ `call`
      # 
      # _@param_ `content` — the observation the model got
      # 
      # _@param_ `summary` — the tool's one-line summary of it
      # 
      # _@return_ — with no id, for {Conversation#add} or
      # {Conversation#restore} to assign
      def self.line: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call, content: String, summary: String?) -> Puri::Protocol::ToolLine

      # _@param_ `call`
      # 
      # _@param_ `text` — its line
      # 
      # _@return_ — the line as Pango markup with its {CREDITS} linked; nil for a tool
      # with none
      def markup: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call, String text) -> String?

      # _@param_ `call`
      # 
      # _@param_ `text` — its line
      # 
      # _@return_ — the line as Pango markup with its {CREDITS} linked; nil for a tool
      # with none
      def self.markup: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call, String text) -> String?

      # _@param_ `call`
      # 
      # _@param_ `outcome` — the tool's summary of a call that failed or was cut short, or of a {SUMMED} one; nil for any other that answered
      def text: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call, String? outcome) -> String

      # _@param_ `call`
      # 
      # _@param_ `outcome` — the tool's summary of a call that failed or was cut short, or of a {SUMMED} one; nil for any other that answered
      def self.text: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call, String? outcome) -> String

      # _@param_ `call`
      # 
      # _@return_ — its {WORDINGS} line, or pikuri's name behind a gear
      def worded: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call) -> String

      # _@param_ `call`
      # 
      # _@return_ — its {WORDINGS} line, or pikuri's name behind a gear
      def self.worded: ((Pikuri::Agent::Event::ToolCall | Pikuri::Agent::History::ToolCall) call) -> String

      # One tool's wording.
      # 
      # @!attribute [r] status
      #   @return [String] what the turn is doing while the call runs
      # @!attribute [r] line
      #   @return [String] the line once it answered, the call's argument after a colon when
      #     there is one
      class Wording
        # _@return_ — what the turn is doing while the call runs
        def status: () -> String

        # _@return_ — the line once it answered, the call's argument after a colon when
        # there is one
        def line: () -> String

        # _@return_ — what the turn is doing while the call runs
        def self.status: () -> String

        # _@return_ — the line once it answered, the call's argument after a colon when
        # there is one
        def self.line: () -> String
      end
    end

    # One {PikuriCore} conversation's pikuri side: its live `Pikuri::Conversations::Conversation`,
    # opened on the first question, the {Confirmer} its tools and extensions ask through, and its folder in the
    # store. It opens that conversation as its listener and its saver, its agents built by its
    # {Initializer}:
    # 
    #   session = AgentSession.new(conversation, entry:, store:, conversations:, transport:, models:, config:,
    #                              lock:, saved: true)
    #   session.restore                        # a saved one's blocks, once, before anyone reads them
    #   session.ask('how do I keep an avocado?')
    #   session.select_model(models.find('Qwen 3.6'))   # for the next turn
    #   session.cancel
    #   session.delete                         # closes it, and removes it from disk
    # 
    # Every turn is saved once it ends, a cancelled or failed one too, the {Places::Notebook} of
    # what its place tools found with it; a save that fails ends in an error notice. The gem
    # titles a conversation opened `untitled:` after its first turn, and the title is saved too.
    # The conversation's {Protocol::Status} follows the model picked and the tokens each reply
    # reports, through a {ContextReadout}.
    # 
    # == Threading
    # 
    # {#ask}, {#cancel}, {#answer}, {#select_model}, {#restore} and {#delete} come from the core,
    # under its lock.
    # {#on_event} and {#save} run on the gem's threads; {#save} and a title's write take this
    # session's own lock, so a save never carries a title older than the one on disk. A save
    # still ending after {#delete} writes nothing: `Store#delete` is final.
    class AgentSession < Pikuri::Agent::Listener::Base
      include Pikuri::Conversations::Saver
      LOGGER: Logger

      # _@param_ `conversation` — where the turns show
      # 
      # _@param_ `entry` — its folder
      # 
      # _@param_ `store`
      # 
      # _@param_ `conversations` — the live ones, which this one joins on its first question
      # 
      # _@param_ `transport` — the connection it starts on
      # 
      # _@param_ `models` — what names the connection in its status
      # 
      # _@param_ `config` — what its agents are built from
      # 
      # _@param_ `lock` — the core's
      # 
      # _@param_ `saved` — whether the store holds this conversation already
      # 
      # _@param_ `library` — the `[documents]` folder its agents search
      # 
      # _@param_ `osm` — what its place tools ask; nil wires none
      # 
      # _@param_ `open_meteo` — what its weather tool asks; nil, or no `[weather]`, wires none
      # 
      # _@param_ `rhythmbox` — what `play_music` plays in; nil wires none
      # 
      # _@param_ `llama_server` — the one Puri runs, which an agent on it waits for
      def initialize: (
                        Puri::Core::Conversation conversation,
                        entry: Pikuri::Conversations::Store::Entry,
                        store: Pikuri::Conversations::Store,
                        conversations: Pikuri::Conversations,
                        transport: Pikuri::Agent::ChatTransport,
                        models: Puri::Core::Models,
                        config: Puri::Core::Config,
                        lock: Monitor,
                        saved: bool,
                        ?library: Puri::Core::Library?,
                        ?osm: Puri::Core::Places::Osm?,
                        ?open_meteo: Puri::Core::Weather::OpenMeteo?,
                        ?rhythmbox: Puri::Core::Music::Rhythmbox?,
                        ?llama_server: Puri::Core::LlamaServer?
                      ) -> void

      # Fills a saved conversation's blocks from its history, the first time only; the agent
      # resumes from that history. One that can't be read ends in an error notice, and the
      # conversation is never saved over it.
      def restore: () -> void

      # Answers a waiting confirmation with the text, or else sends it to the agent: it starts a
      # turn, or the running turn reads it after its current step.
      # 
      # _@param_ `text`
      def ask: (String text) -> void

      # Stops the running turn, which says "Cancelling…" until it notices; a message it hasn't
      # read yet moves from the queue into the transcript, and is dropped.
      def cancel: () -> void

      # The next turn runs on `choice`; a running one ends on its own model.
      # 
      # _@param_ `choice`
      def select_model: (Puri::Core::Models::Choice choice) -> void

      # _@param_ `confirmation` — the block id the user answered
      # 
      # _@param_ `approved`
      def answer: (String confirmation, bool approved) -> void

      # Closes the live conversation, cancelling its turn, and removes it from disk; the turn's
      # own save, still to come, writes nothing.
      def delete: () -> void

      # Any failure, not only a disk's, ends in the error notice: a history that won't serialize
      # is as lost as one that won't write.
      # 
      # _@param_ `_conversation` — this session's
      # 
      # _@param_ `history`
      def save: (Pikuri::Conversations::Conversation _conversation, Pikuri::Agent::History history) -> void

      # Shows the event, then goes idle once the gem says no work is under way. `TurnEnded` goes
      # through the limiter too: it flushes a failed turn's tail ahead of the failure notice.
      # 
      # _@param_ `event` — an agent's `Pikuri::Agent::Event` or a `Pikuri::Conversations::Event`
      def on_event: (Object event) -> void

      # _@return_ — opened on first use
      def live: () -> Pikuri::Conversations::Conversation

      # Under the core's lock, so two threads' updates land in the order they read the gem.
      def publish_status: () -> void

      # _@param_ `title`
      def retitle: (String title) -> void

      # A boot that ends with no work under way was cancelled, its message dropped: every boot
      # here has one waiting, since a conversation opens on its first {#ask}.
      def cancelled_boot: () -> void

      # The messages that waited for the agent are shown, then dropped with the error.
      # 
      # _@param_ `error`
      def failed_boot: (StandardError error) -> void

      # Shows what the user sent that the agent hasn't read; the system items the gem queues are
      # the agent's own. An event can arrive stale: a mid-turn submit emits its queue once the
      # gem's lock drops, and the turn's drain, on its own thread, may get there first. So an
      # empty queue, by the gem's count, wins over the event's items.
      # 
      # _@param_ `items`
      def pending: (::Array[Pikuri::Agent::Control::Interloper::Item] items) -> void

      # Idle once `Status#busy?` says so, re-read on every event rather than inferred from which
      # events came: a boot cancelled before its turn ends in `Ready` alone. Under the core's lock,
      # so it never undoes the "Thinking…" {#ask} shows before its message reaches the gem.
      def settle: () -> void

      # Takes the messages the agent hasn't read, showing each, so none vanishes unseen.
      def drop_pending: () -> void

      # Builds each of a session's agents from the config: our system prompt, the web tools
      # `[search]` keys, the Thunderbird profile `[thunderbird]` names, and the {Confirmer} the
      # agent's tools ask through.
      # 
      #   initializer = Initializer.new(config, conversation, lock:)
      #   conversations.open(id:, transport:, listener:, initializer:)
      #   initializer.confirmer   # the latest agent's, once one has booted
      # 
      # Called on the boot's thread, once per agent: a clear or a failed boot builds another, with
      # a {Confirmer} of its own.
      class Initializer
        include Pikuri::Conversations::AgentInitializer
        PROMPTS: String
        STARTING_MODEL: Puri::Protocol::Activity

        # Our system prompt, and the fragments that say what the agent can reach; {#system_prompt}
        # appends the date, and the memory.
        # 
        # _@param_ `web` — whether the agent has the web tools
        # 
        # _@param_ `documents` — whether it has the documents folder
        # 
        # _@param_ `places` — whether it has the place tools
        # 
        # _@param_ `weather` — whether it has `weather`
        # 
        # _@param_ `music` — whether it has `play_music`
        def self.system_prompt: (
                                  web: bool,
                                  documents: bool,
                                  ?places: bool,
                                  ?weather: bool,
                                  ?music: bool
                                ) -> String

        # _@param_ `config`
        # 
        # _@param_ `conversation` — where a confirmation shows
        # 
        # _@param_ `lock` — the core's
        # 
        # _@param_ `library` — the `[documents]` folder; nil without one
        # 
        # _@param_ `cache_dir` — where each agent's Thunderbird snapshots go, in a folder of their own
        # 
        # _@param_ `osm` — what the place tools ask; nil wires none
        # 
        # _@param_ `notebook` — the conversation's places, which the place tools number and draw in
        # 
        # _@param_ `open_meteo` — what `weather` asks, beside the place tools; nil wires none
        # 
        # _@param_ `rhythmbox` — what `play_music` plays in; nil wires none
        # 
        # _@param_ `llama_server` — the one Puri runs, which an agent on it waits for
        def initialize: (
                          Puri::Core::Config config,
                          Puri::Core::Conversation conversation,
                          lock: Monitor,
                          ?library: Puri::Core::Library?,
                          ?cache_dir: String,
                          ?osm: Puri::Core::Places::Osm?,
                          ?notebook: Puri::Core::Places::Notebook?,
                          ?open_meteo: Puri::Core::Weather::OpenMeteo?,
                          ?rhythmbox: Puri::Core::Music::Rhythmbox?,
                          ?llama_server: Puri::Core::LlamaServer?
                        ) -> void

        # The machine's time zone, for the prompt:
        # 
        #   Initializer.time_zone(Time.now)   # => "Europe/Helsinki (UTC+02:00)"
        # 
        # Just "UTC+02:00" when neither `TZ` nor the `/etc/localtime` link names a zone.
        # 
        # _@param_ `now` — local
        # 
        # _@param_ `tz_env` — the `TZ` variable
        # 
        # _@param_ `localtime` — the zoneinfo link
        def self.time_zone: (Time now, ?tz_env: String?, ?localtime: String) -> String

        # _@param_ `_conversation` — this session's
        # 
        # _@return_ — {.system_prompt} for the tools the config gives, then today's date, the
        # time zone, and with documents their folder and the memory; the agent appends its
        # extensions' own fragments
        def system_prompt: (Pikuri::Conversations::Conversation _conversation) -> String

        # Adds the calculator, the web tools, the place tools, `weather`, `play_music`, the Thunderbird
        # extension, and the documents' search and file tools. An extension is built afresh for
        # each agent as pikuri asks, and one that asks before it acts takes {#confirmer}.
        # 
        # An agent on the llama-server Puri runs first waits for its model to load, showing
        # {STARTING_MODEL}: its turn's first request would fail, and the gem's probe would then
        # forget the server for a minute (`D_embedded`). A cancel waits for the load too.
        # 
        # _@param_ `configurator`
        # 
        # _@param_ `conversation` — this session's
        def configure: (Pikuri::Agent::Configurator configurator, Pikuri::Conversations::Conversation conversation) -> void

        # _@param_ `conversation` — the one booting
        def await_model: (Pikuri::Conversations::Conversation conversation) -> void

        # The memory is read once per agent, so a change the agent makes reaches the prompt in
        # the next conversation: rewriting this one's would cost the server's cache of it, for a
        # fact the write already told the model.
        # 
        # _@return_ — "" without documents
        def library_prompt: () -> String

        # Reads the whole documents folder, and writes only its `Notes/`, unasked (owner,
        # 2026-11-17): the folder is the gate, and each write's line names its file. No `grep`: it
        # can't see inside a PDF, and would answer "no match" where `fileindex_search` finds it.
        def workspace: () -> Pikuri::Workspace::Extension

        # Mail, contacts and calendar, read from the local profile, and both hand-offs: a drafted
        # mail opens in Thunderbird's compose window, an event in its import wizard, and the user
        # sends or adds it there, so neither asks through {#confirmer}. No profile on the machine
        # wires nothing; two installs with a mail account fail the boot, naming both.
        # 
        # Its snapshots go in a fresh folder under {#initialize}'s `cache_dir`, removed when the
        # agent closes: two extensions sharing one copy each other's under an open database.
        # 
        # _@param_ `configurator`
        def thunderbird: (Pikuri::Agent::Configurator configurator) -> Pikuri::Thunderbird::Extension

        # GNOME's units are read afresh for each agent, so a change shows in the next conversation.
        def forecast_tool: () -> Puri::Core::Weather::ForecastTool

        # _@return_ — `web_search` with page text, and `web_read_cached`; none
        # without a keyed `[search]`
        def web_tools: () -> ::Array[Pikuri::Tool]

        # _@return_ — the latest agent's; nil until one has booted
        attr_reader confirmer: Confirmer?
      end
    end

    # Turns a pikuri conversation's events into a {Conversation}'s blocks and activity, the one
    # place that decides which block an event becomes:
    # 
    #   TurnStarted(user_message:) → a UserMessage; ActivityChanged(working, "Thinking…")
    #   UserTurn(mid_loop: true)  → a UserMessage: a message sent during the turn, as the model reads it
    #   ThinkingDelta             → ActivityChanged(working, "Thinking…")
    #   AssistantDelta            → appended to the Reply, opened on the first; ActivityChanged(streaming)
    #   Assistant                 → that Reply, rendered whole from the final text
    #   ToolCall                  → ActivityChanged(working, "Searching the web…")
    #   ToolResult                → a ToolLine; ActivityChanged(working, "Thinking…")
    #   TurnEnded                 → a Notice when cancelled or failed; when completed, the Map of
    #                               the turn's last place tool, under its answer
    #   ModelSwitched             → nothing shown; a later failure names the new server
    # 
    # It renders every delta it gets, so it sits behind the gem's limiter, which coalesces them:
    # 
    #   listener = TurnListener.new(conversation, server:, notebook:)
    #   conversations.open(id:, transport:, listener: Pikuri::Conversations::RateLimitedListener.new(listener, fps: 15))
    # 
    # Going idle is not an event's: {AgentSession} asks the gem whether work is under way. Each
    # step goes through {Conversation#step}, so a cancelled turn says "Cancelling…" until it ends.
    # {ToolWording} words a tool's status and line, as {Replay} does a saved one's.
    # 
    # == Threading
    # 
    # Its state is the turn thread's, with no lock: only the agent's events, `TurnStarted` and
    # `TurnEnded` touch it, and the gem emits those on the turn's thread. Every other
    # conversation event — `PendingChanged`, `CancelRequested`, `Cleared`… — may come from the
    # thread that submits or cancels, so it must do nothing here.
    class TurnListener < Pikuri::Agent::Listener::Base
      THINKING: Puri::Protocol::Activity

      # _@param_ `conversation`
      # 
      # _@param_ `server` — the model's `api_base`, which a failure names
      # 
      # _@param_ `notebook` — where a place tool's map is found
      def initialize: (Puri::Core::Conversation conversation, server: String?, ?notebook: Puri::Core::Places::Notebook?) -> void

      # _@param_ `event` — a `Pikuri::Agent::Event` or `Pikuri::Conversations::Event` variant, or an extension's own
      def on_event: (Object event) -> void

      # _@param_ `text` — nil for a turn that only delivers what was sent during the last
      def started: (String? text) -> void

      # Drops a reply a cancel left open; a mid-turn message shows where the model reads it.
      # 
      # _@param_ `event`
      def user_turn: (Pikuri::Agent::Event::UserTurn event) -> void

      def thinking: () -> void

      # _@param_ `event`
      def ended: (Pikuri::Conversations::Event::TurnEnded event) -> void

      # _@param_ `event`
      def tool_call: (Pikuri::Agent::Event::ToolCall event) -> void

      # A result whose call never showed — one a cancel answered before it ran — shows nothing.
      # 
      # _@param_ `event`
      def tool_result: (Pikuri::Agent::Event::ToolResult event) -> void

      # _@param_ `error`
      # 
      # _@return_ — what the user reads
      def failure: (StandardError error) -> String

      def reset: () -> void

      # _@param_ `text`
      def delta: (String text) -> void

      # The final text is authoritative: deltas need not add up to it. A reply shorter than one
      # frame comes with no delta at all, the limiter having dropped them at this bookend.
      # 
      # _@param_ `text`
      def finish: (String text) -> void

      def open_reply: () -> void
    end

    # The model's Markdown as {Protocol::Reply} parts: prose as Pango markup, code blocks and
    # tables as parts of their own. pikuri-web's MarkdownRenderer with Pango for HTML.
    # Not in pikuri, which stays Markdown-free: kramdown already is the shared parser, and the
    # converter is per target.
    # 
    #   ReplyRenderer.render("Keep it **cold**:\n\n- fridge\n- freezer")
    #   # => [Prose(markup: "Keep it <b>cold</b>:\n\n• fridge\n• freezer")]
    # 
    # A streamed reply goes through {ReplyStream}, which converts each finished block once.
    # Unfinished Markdown (`**bol`) renders as the literal text.
    # 
    # Links are plain text and images only their alt text: a model-chosen URL is egress
    # (`design/ideas/trifecta-and-tools.md`, *Links in the reply*).
    # 
    # A footnote keeps the model's label as its marker, and the notes close the reply:
    # 
    #   ReplyRenderer.render("Ripe in days[^1].\n\n[^1]: USDA, 2024.")
    #   # => [Prose(markup: "Ripe in days<sup>1</sup>.\n\n<span alpha=\"40%">―――</span>\n<sup>1</sup> USDA, 2024.")]
    module ReplyRenderer
      OPTIONS: ::Hash[Symbol, Object]
      SYMBOLS: ::Hash[Symbol, String]
      RULE: String
      QUOTES: ::Hash[Symbol, String]
      HTML: ::Hash[String, String]

      # _@param_ `markdown`
      def render: (String markdown) -> ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]

      # _@param_ `markdown`
      def self.render: (String markdown) -> ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]

      # The footnotes' text under a rule, each by its marker, in the order first cited. Not part of
      # {.parts}: a block alone can't tell which footnotes the whole reply cites.
      # 
      # _@param_ `root`
      # 
      # _@return_ — one part, or none for a reply without footnotes
      def footnotes: (Kramdown::Element root) -> ::Array[Puri::Protocol::Prose]

      # The footnotes' text under a rule, each by its marker, in the order first cited. Not part of
      # {.parts}: a block alone can't tell which footnotes the whole reply cites.
      # 
      # _@param_ `root`
      # 
      # _@return_ — one part, or none for a reply without footnotes
      def self.footnotes: (Kramdown::Element root) -> ::Array[Puri::Protocol::Prose]

      # _@param_ `node`
      # 
      # _@return_ — every `:footnote` under `node`, in reading order
      def cited: (Kramdown::Element node) -> ::Array[Kramdown::Element]

      # _@param_ `node`
      # 
      # _@return_ — every `:footnote` under `node`, in reading order
      def self.cited: (Kramdown::Element node) -> ::Array[Kramdown::Element]

      # _@param_ `node` — a `:footnote`
      def marker: (Kramdown::Element node) -> String

      # _@param_ `node` — a `:footnote`
      def self.marker: (Kramdown::Element node) -> String

      # A part per top-level block, prose not yet merged.
      # 
      # _@param_ `root` — from {StreamingMarkdownParser}, blank lines dropped
      def parts: (Kramdown::Element root) -> ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]

      # A part per top-level block, prose not yet merged.
      # 
      # _@param_ `root` — from {StreamingMarkdownParser}, blank lines dropped
      def self.parts: (Kramdown::Element root) -> ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]

      # _@param_ `parts`
      # 
      # _@return_ — with
      # each run of prose joined into one part, a paragraph apart
      def merge: (::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)] parts) -> ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]

      # _@param_ `parts`
      # 
      # _@return_ — with
      # each run of prose joined into one part, a paragraph apart
      def self.merge: (::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)] parts) -> ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]

      # _@param_ `node` — a block-level element
      # 
      # _@param_ `depth` — list nesting
      # 
      # _@return_ — Pango markup
      def block: (Kramdown::Element node, Integer depth) -> String

      # _@param_ `node` — a block-level element
      # 
      # _@param_ `depth` — list nesting
      # 
      # _@return_ — Pango markup
      def self.block: (Kramdown::Element node, Integer depth) -> String

      # _@param_ `node` — a `:header`
      def heading: (Kramdown::Element node) -> String

      # _@param_ `node` — a `:header`
      def self.heading: (Kramdown::Element node) -> String

      # _@param_ `node` — a `:ul` or `:ol`
      # 
      # _@param_ `depth`
      def list: (Kramdown::Element node, Integer depth) -> String

      # _@param_ `node` — a `:ul` or `:ol`
      # 
      # _@param_ `depth`
      def self.list: (Kramdown::Element node, Integer depth) -> String

      # _@param_ `node` — a `:table`
      def table: (Kramdown::Element node) -> Puri::Protocol::Table

      # _@param_ `node` — a `:table`
      def self.table: (Kramdown::Element node) -> Puri::Protocol::Table

      # _@param_ `node`
      # 
      # _@return_ — its children as Pango markup
      def inline: (Kramdown::Element node) -> String

      # _@param_ `node`
      # 
      # _@return_ — its children as Pango markup
      def self.inline: (Kramdown::Element node) -> String

      # _@param_ `node` — a span-level element
      def span: (Kramdown::Element node) -> String

      # _@param_ `node` — a span-level element
      def self.span: (Kramdown::Element node) -> String

      # Raw HTML keeps its text; a formatting tag becomes its Pango twin, any other is dropped.
      # GFM's `~~strike~~` arrives this way too, as a `del` element.
      # 
      # _@param_ `node` — an `:html_element`
      def html: (Kramdown::Element node) -> String

      # Raw HTML keeps its text; a formatting tag becomes its Pango twin, any other is dropped.
      # GFM's `~~strike~~` arrives this way too, as a `del` element.
      # 
      # _@param_ `node` — an `:html_element`
      def self.html: (Kramdown::Element node) -> String

      # _@param_ `text`
      # 
      # _@return_ — safe inside Pango markup
      def escape: (String text) -> String

      # _@param_ `text`
      # 
      # _@return_ — safe inside Pango markup
      def self.escape: (String text) -> String
    end

    # A conversation's context use, worded for its {Protocol::Status}. Fed the agent's and the
    # gem's events; the counting is pikuri's `TokenLog`, as in pikuri-tui and pikuri-web:
    # 
    #   readout = ContextReadout.new
    #   readout.on_event(event)          # Tokens, HistoryLoaded, ContextCap; Booting zeroes it
    #   readout.status('Ornith 1.5')
    #   # => Status(model: "Ornith 1.5", context: "7.4k of 64.0k tokens", fill: 0.116,
    #   #           detail: "msg #2  Δ+1.6k  ↑1.0k  ↓0.6k")
    # 
    # The detail is `TokenLog`'s line without its `ctx=`: Δ the context's growth since the
    # last reply, ↑ the prompt tokens this reply processed afresh, ↓ the tokens it wrote.
    # 
    # Thread-safe.
    class ContextReadout
      # _@param_ `cap` — the context window, until a `ContextCap` says otherwise
      def initialize: (?cap: Integer?) -> void

      # _@param_ `event` — any agent or conversation event; the rest are ignored
      # 
      # _@return_ — whether the readout changed
      def on_event: (Object event) -> bool

      # _@param_ `cap` — the window of a model picked before the agent boots
      def cap=: (Integer? cap) -> void

      # _@param_ `model` — the connection's name
      def status: (String model) -> Puri::Protocol::Status

      # _@param_ `measured`
      # 
      # _@param_ `used` — tokens
      def context: (bool measured, Integer used) -> String

      # As `TokenLog` writes a count: 1024-scaled.
      # 
      # _@param_ `tokens`
      # 
      # _@return_ — `12_453` → `"12.2k"`
      def k: (Integer tokens) -> String
    end
  end

  # `bin/setup`, the one command that installs Puri and, run again, is its doctor: each check in
  # the install guide's order, a fix for each that needs no sudo once the user says yes, and the
  # rest printed for the user to do.
  # 
  #   ✓ The packages from Ubuntu's archive          {Packages}, then stop if any is missing
  #   ✓ Puri's Ruby libraries                       {Bundle}: `bundle install`
  #   ✓ Puri is on your desktop: Super+Alt+Space    {Install}, what `rake install` writes
  #   ✓ The config, ~/.config/puri/config.toml      written only when there is none
  #   ✓ The model, ggml-org/Qwen3.5-4B-GGUF:Q4_K_M  {HubDownload}, after {Hardware}'s warning
  #   ✗ Thunderbird's global search is off: …       {Calendars} too, printed as where to click
  #   ✓ Your documents, ~/Documents, are indexed    {SearchLocations}, {FileIndex}
  # 
  # Two processes: `bin/setup` runs the first two on Ruby's standard library alone, since the
  # gems are one of its fixes, then hands over to {Doctor} under the bundle. The checks never
  # write the config but when it is missing, and never run sudo.
  module Setup
    # Puri's Ruby libraries, the Gemfile's, which Bundler fetches into the checkout:
    # 
    #   Bundle.new(root: '/home/u/puri').check(terminal)   # => true once `bundle check` passes
    # 
    # Missing, they are installed once the user says yes, into `vendor/bundle` unless Bundler
    # already has a path, as the install guide's `bundle config set --local path` sets it.
    # 
    # Ruby's standard library only: `bin/setup` loads it before `bundle install`.
    class Bundle
      # _@param_ `root` — the checkout, which holds the Gemfile
      def initialize: (root: String) -> void

      # _@param_ `terminal`
      # 
      # _@return_ — whether the bundle is complete now
      def check: (Puri::Setup::Terminal terminal) -> bool

      # _@param_ `args`
      # 
      # _@return_ — whether `bundle` succeeded, quietly
      def bundle?: (*::Array[String] args) -> bool

      # _@return_ — whether Bundler has a path to install into, from any of its settings
      def path?: () -> bool
    end

    # The checks `bin/setup` runs once the packages and the gems are in, each with its fix:
    # 
    #   ✓ Puri is on your desktop: Super+Alt+Space opens it
    #   ✓ The config, ~/.config/puri/config.toml
    #   ✓ The model, ggml-org/Qwen3.5-4B-GGUF:Q4_K_M
    #   ✓ Dictation's model, ggerganov/whisper.cpp:ggml-small.bin
    #   ✗ Thunderbird's global search is off, so Puri finds no mail: in Thunderbird, …
    #   ✓ Your documents, ~/Documents, in GNOME's file index
    # 
    #   One thing above, marked ✗, needs you. Run bin/setup again once it's done.
    # 
    #   exit Doctor.new.run
    # 
    # The config decides the rest: the models are the ones it names, downloaded where it runs them
    # here, and Thunderbird and the documents are checked where it turns them on. A broken config
    # stops the checks after it. The config is written only when there is none, the install guide's
    # `docs/config.toml` as it is.
    class Doctor
      SITE: String
      QWEN: String
      ROOT: String

      # _@param_ `terminal`
      # 
      # _@param_ `env` — where the XDG folders, `HOME`, the hub cache's and `HF_ENDPOINT` come from
      def initialize: (?terminal: Puri::Setup::Terminal, ?env: untyped) -> void

      # _@return_ — the exit status: 0 when nothing needs the user, 1 when something does,
      # 130 after Ctrl+C
      def run: () -> Integer

      def desktop: () -> void

      # _@return_ — nil when it is broken
      def config: () -> Puri::Core::Config?

      # _@param_ `config`
      def models: (Puri::Core::Config config) -> void

      # _@return_ — nil when llama-server can't say
      def probe: () -> Puri::Setup::Hardware?

      # _@param_ `hardware`
      def gpu: (Puri::Setup::Hardware? hardware) -> void

      # _@param_ `title`
      # 
      # _@param_ `model`
      # 
      # _@param_ `path` — where the cache has it; nil when it hasn't
      # 
      # _@param_ `download`
      def model: (
                   String title,
                   String model,
                   String? path,
                   Puri::Setup::HubDownload download
                 ) ?{ () -> Puri::Setup::HubDownload::Plan } -> void

      # _@param_ `hardware`
      def ornith: (Puri::Setup::Hardware? hardware) -> void

      # _@param_ `table`
      def mail: (Puri::Core::Config::ThunderbirdTable table) -> void

      # _@param_ `folder` — the config's documents folder
      def documents: (String folder) -> void

      # _@param_ `index`
      # 
      # _@param_ `folder`
      def index_text: (Puri::Setup::FileIndex index, String folder) -> void

      # _@return_ — the exit status
      def finish: () -> Integer

      # _@param_ `path`
      def tilde: (String path) -> String
    end

    # Puri on the user's desktop, run from this checkout: no root, no copy, so a `git pull`
    # updates it. The session bus starts Puri on the first `gapplication launch`, the command the
    # global shortcut runs; with `autostart:`, the session also starts it hidden at login.
    # 
    #   install = Install.new
    #   install.write(hotkey: Install::DEFAULT_HOTKEY, autostart: true)   # => the files it wrote
    #   install.installed?    # => true: the entry and the service run this checkout's exe/puri
    #   install.hotkey        # => "<Super><Alt>space", what the shortcut is bound to now
    #   install.remove
    # 
    # Declarative: {#write} sets everything from its arguments, so `autostart: false` removes an
    # earlier autostart entry, and `hotkey: nil` the shortcut. The shortcut is a GNOME custom
    # keybinding at a fixed path, so a reinstall finds it.
    class Install
      APP_ID: String
      DEFAULT_HOTKEY: String
      MEDIA_KEYS: String
      KEYBINDING: String
      EXE: String

      # _@param_ `value` — an accelerator such as `<Super>p`, or empty for none
      # 
      # _@return_ — `value`; nil for none
      def self.hotkey: (String value) -> String?

      # _@param_ `hotkey` — an accelerator
      # 
      # _@return_ — as a person reads it: `<Super><Alt>space` is "Super+Alt+Space"
      def self.label: (String hotkey) -> String

      # _@param_ `env` — where `HOME`, `XDG_DATA_HOME` and `XDG_CONFIG_HOME` come from
      def initialize: (?env: untyped) -> void

      # _@return_ — each file {#write} may write, by role
      def paths: () -> ::Hash[Symbol, String]

      # _@param_ `hotkey` — see {.hotkey}; nil binds none
      # 
      # _@param_ `autostart`
      # 
      # _@return_ — the files it wrote, each in full
      def write: (hotkey: String?, autostart: bool) -> ::Array[String]

      # Removes every file {#write} wrote, and the shortcut.
      def remove: () -> void

      # _@return_ — whether the desktop entry and the D-Bus service run this checkout
      def installed?: () -> bool

      # _@return_ — whether a desktop entry or a service is there, perhaps another checkout's
      def present?: () -> bool

      # _@return_ — whether Puri starts at login
      def autostart?: () -> bool

      # _@return_ — what Puri's shortcut is bound to; nil for none
      def hotkey: () -> String?

      # `exe/puri` in quotes, as both a desktop entry's and a D-Bus service's `Exec=` take it. A path
      # that would need escaping inside the quotes is refused rather than escaped.
      def exec_line: () -> String

      # _@param_ `path`
      # 
      # _@param_ `content`
      # 
      # _@return_ — `path`
      def file: (String path, String content) -> String

      # _@param_ `path`
      # 
      # _@return_ — its content; empty when it's missing
      def read: (String path) -> String

      # _@return_ — the schema and path of Puri's keybinding
      def entry: () -> String

      # Binds Puri's custom keybinding to `hotkey`, or removes it.
      # 
      # _@param_ `hotkey`
      def bind: (String? hotkey) -> void

      # Makes the session bus re-read its service files, or `gapplication launch` may find Puri "not
      # activatable" until the next login (`R_gnome_activation`).
      def reload_bus: () -> void
    end

    # What the model would run on here, as llama.cpp sees it, for the setup's two words of advice:
    # a warning where there's no GPU, and where Ornith fits, the hint that it does
    # (`docs/models.html`, "Which computer runs which").
    # 
    #   hardware = Hardware.probe
    #   hardware.gpu?             # => false: the model runs on the processor alone
    #   hardware.ornith?          # => true where a GPU has the memory for Ornith
    #   hardware.ornith_share     # => 48, the GB integrated Radeon graphics may be lent for it, or nil
    # 
    # A GPU is a device `llama-server --list-devices` lists (`R_llama_list_devices`), never a
    # software one such as Mesa's lavapipe, which runs on the processor too.
    # 
    # Immutable.
    class Hardware
      ORNITH_MIB: Integer
      ORNITH_RAM_GB: Integer
      DESKTOP_GB: Integer
      SOFTWARE: Regexp

      # _@param_ `command` — what runs `llama-server`; specs run a stand-in
      # 
      # _@param_ `meminfo`
      # 
      # _@param_ `cmdline`
      def self.probe: (?command: ::Array[String], ?meminfo: String, ?cmdline: String) -> Puri::Setup::Hardware

      # _@param_ `output` — `llama-server --list-devices`'s, log lines and all
      def self.parse: (String output) -> ::Array[Puri::Setup::Hardware::Gpu]

      # _@param_ `gpus`
      # 
      # _@param_ `ram_gb`
      # 
      # _@param_ `ttm`
      def initialize: (gpus: ::Array[Puri::Setup::Hardware::Gpu], ram_gb: Integer, ?ttm: bool) -> void

      # _@return_ — whether the model runs on anything but the processor
      def gpu?: () -> bool

      # _@return_ — whether a GPU has the memory to hold Ornith
      def ornith?: () -> bool

      # _@return_ — the GB integrated Radeon graphics would need lent before they run
      # Ornith, the rest of the RAM bar the desktop's; nil when they hold it already, when there's
      # too little RAM, or no such graphics
      def ornith_share: () -> Integer?

      # _@param_ `gigabytes`
      # 
      # _@return_ — the kernel options that lend AMD's graphics that much RAM, as
      # `docs/models.html` has them: 4 KiB pages
      def self.ttm_options: (Integer gigabytes) -> String

      # _@return_ — never a software device
      attr_reader gpus: ::Array[Puri::Setup::Hardware::Gpu]

      # _@return_ — GB of RAM, rounded up to the next 8 as it is sold: `MemTotal` misses
      # what the firmware keeps
      attr_reader ram_gb: Integer

      # _@return_ — whether the kernel's command line sets `ttm.pages_limit` already
      attr_reader ttm: bool

      # One device llama.cpp runs a model on, as `--list-devices` prints it:
      # 
      #   Vulkan0: AMD Radeon 890M Graphics (RADV STRIX1) (32768 MiB, 31000 MiB free)
      # 
      # @!attribute [r] name
      #   @return [String] `Vulkan0`
      # @!attribute [r] description
      #   @return [String] `AMD Radeon 890M Graphics (RADV STRIX1)`
      # @!attribute [r] mib
      #   @return [Integer] its memory in all, in MiB: an integrated GPU's share of the RAM
      class Gpu
        # _@return_ — whether it is AMD graphics built into the processor, whose share of the
        # RAM the kernel's `ttm` options set: "AMD Radeon 890M Graphics", "AMD Radeon Graphics",
        # never a card's "AMD Radeon RX 7900 XTX"
        def integrated_radeon?: () -> bool

        # _@return_ — `Vulkan0`
        attr_reader name: String

        # _@return_ — `AMD Radeon 890M Graphics (RADV STRIX1)`
        attr_reader description: String

        # _@return_ — its memory in all, in MiB: an integrated GPU's share of the RAM
        attr_reader mib: Integer
      end
    end

    # The packages from Ubuntu's archive that Puri runs on, the install guide's `apt install` line:
    # 
    #   Packages.new.missing                # => ["whisper.cpp", "rhythmbox"]
    #   Packages.new.check(terminal)        # => false, printing the `sudo apt install` line
    # 
    # Only checked, never installed: that needs sudo, which the setup leaves to the user.
    # 
    # Ruby's standard library only: `bin/setup` loads it before `bundle install`.
    class Packages
      LIST: ::Array[String]

      # _@param_ `list`
      # 
      # _@param_ `command` — what runs `dpkg-query`; specs run a stand-in
      def initialize: (?list: ::Array[String], ?command: ::Array[String]) -> void

      # _@return_ — those of the list not installed, in its order
      def missing: () -> ::Array[String]

      # _@param_ `terminal`
      # 
      # _@return_ — whether every package is installed
      def check: (Puri::Setup::Terminal terminal) -> bool
    end

    # What `bin/setup` prints and asks, a line per check, marked:
    # 
    #   ✓ The packages from Ubuntu's archive
    #   ! No graphics for the model to run on, so it runs on the processor alone …
    #   → This computer's graphics have the memory for Ornith 1.5, a smarter model …
    #   ✗ Thunderbird's global search is off, so Puri finds no mail: in Thunderbird, …
    #   ? Download it from Hugging Face, 3.0 GB? [Y/n]
    #     [=============                 ]  42 %  1.3 of 3.0 GB  11 MB/s
    # 
    #   terminal.done("The packages from Ubuntu's archive")
    #   terminal.note('No graphics …')       # a warning that needs nothing of the user
    #   terminal.tip('This computer …')      # a way to more, for the user to take or not
    #   terminal.todo('Thunderbird's …')     # needs the user; counted in #todos
    #   terminal.ask?('Download it?')        # => true for Enter, y or yes; false at end of input
    #   bar = terminal.progress(total, already)
    #   bar.update(fetched)
    #   bar.finish
    # 
    # A message wraps at the terminal's width, at most {WIDTH}, its later lines indented under the
    # mark; a line that starts with spaces, such as a command to copy, is never wrapped. The bar
    # draws only on a terminal.
    # 
    # Ruby's standard library only: `bin/setup` loads it before `bundle install`.
    class Terminal
      WIDTH: Integer

      # _@param_ `input` — where answers come from
      # 
      # _@param_ `output`
      def initialize: (?input: IO, ?output: IO) -> void

      # _@param_ `text`
      def say: (String text) -> void

      # _@param_ `text` — a check that passed
      def done: (String text) -> void

      # _@param_ `text` — a warning the user may act on, or not
      def note: (String text) -> void

      # _@param_ `text` — a way to more, which the user may take
      def tip: (String text) -> void

      # _@param_ `text` — what the user must do before Puri works fully
      def todo: (String text) -> void

      # Asks until the answer is yes or no. Reads no further than the answer's line, so the
      # answers piped in after it are left for the doctor `bin/setup` execs into.
      # 
      # _@param_ `question`
      # 
      # _@param_ `default` — what Enter alone answers
      # 
      # _@return_ — false at the end of input, whatever the default, so a script piping
      # nothing in agrees to nothing
      def ask?: (String question, ?default: bool) -> bool

      # _@param_ `total` — bytes
      # 
      # _@param_ `start` — bytes already there, a download that stopped halfway
      def progress: (Integer total, ?Integer start) -> Puri::Setup::Terminal::Progress

      # _@param_ `path`
      # 
      # _@return_ — `path` with the home folder as `~`
      def self.tilde: (String path) -> String

      # _@param_ `bytes`
      # 
      # _@return_ — in decimal units, as the site states sizes: "3.0 GB", "488 MB"
      def self.size: (Integer bytes) -> String

      # A byte at a time: `gets` reads ahead from a pipe, into a buffer `exec` drops.
      # 
      # _@return_ — nil at the end of input
      def read_line: () -> String?

      # _@param_ `mark` — one character, or '' for none
      # 
      # _@param_ `text` — perhaps several lines
      def emit: (String mark, String text) -> void

      # _@param_ `text` — one paragraph
      # 
      # _@param_ `columns`
      # 
      # _@return_ — never empty
      def wrap: (String text, Integer columns) -> ::Array[String]

      def width: () -> Integer

      # _@return_ — how many {#todo}s were printed
      attr_reader todos: Integer

      # A download's bar, redrawn in place at most five times a second.
      class Progress
        BAR: Integer

        # _@param_ `output`
        # 
        # _@param_ `total` — bytes
        # 
        # _@param_ `start` — bytes there before this run
        def initialize: (IO output, Integer total, Integer start) -> void

        # _@param_ `fetched` — bytes there now, {#initialize}'s `start` included
        def update: (Integer fetched) -> void

        def finish: () -> void

        # Ends the bar's line where the download stopped short.
        def stop: () -> void

        # _@param_ `fetched`
        def draw: (Integer fetched) -> void

        def clock: () -> Float
      end
    end

    # Thunderbird's calendars, as its `prefs.js` registers them, for the one thing Puri needs of
    # each: a copy on disk, which only Offline Support keeps of a calendar on a server or in a file.
    # 
    #   user_pref("calendar.registry.3f2a….name", "Work");
    #   user_pref("calendar.registry.3f2a….type", "caldav");
    #   user_pref("calendar.registry.3f2a….cache.enabled", true);
    # 
    #   Calendars.uncached(profile.prefs_path)   # => ["Holidays"]
    # 
    # A local calendar, Thunderbird's own `storage`, always has its copy, and a disabled one is
    # skipped.
    module Calendars
      # _@param_ `prefs` — a profile's `prefs.js`
      # 
      # _@return_ — the names of the calendars Puri can't read, in the file's order;
      # empty when there is no file
      def self.uncached: (String prefs) -> ::Array[String]

      # _@param_ `prefs`
      # 
      # _@return_ — each calendar's properties, by its id
      def self.registry: (String prefs) -> ::Hash[String, ::Hash[String, Object]]

      # _@param_ `literal` — a pref's value as `prefs.js` writes it
      # 
      # _@return_ — a String, a Boolean or an Integer; the literal itself when it is none
      def self.value: (String literal) -> Object
    end

    # GNOME's file index, localsearch, asked what the setup needs to know of the documents folder:
    # 
    #   index = FileIndex.new
    #   index.unavailable_reason('/home/u/Documents')   # => nil once anything under it is indexed
    #   index.idle?                                     # => false while it reads files
    #   index.office_without_text('/home/u/Documents')  # => ".../lease.docx": indexed, no text
    #   index.reindex('/home/u/Documents')              # reads the folder anew, office text and all
    # 
    # An office file indexed without its text is what `localsearch-extractor-office` installed
    # after the index read it leaves: localsearch never reads it again by itself.
    class FileIndex
      OFFICE: ::Array[String]
      SAMPLE: Integer

      # _@param_ `backend` — answers `unavailable_reason(folders:)` and `read_text(path)`, as pikuri-fileindex's do; specs pass a fake
      # 
      # _@param_ `command` — what runs `localsearch`; specs run a stand-in
      def initialize: (?backend: Module, ?command: ::Array[String]) -> void

      # _@param_ `folder` — absolute
      # 
      # _@return_ — why a search there finds nothing, for the user; nil when it can
      def unavailable_reason: (String folder) -> String?

      # _@return_ — whether localsearch has read every file it knows of
      def idle?: () -> bool

      # _@param_ `folder` — absolute
      # 
      # _@return_ — an office file under it that the index holds without its text; nil
      # when one of the newest has its text, or none is indexed
      def office_without_text: (String folder) -> String?

      # _@param_ `folder` — absolute
      # 
      # _@return_ — whether localsearch took the request
      def reindex: (String folder) -> bool

      # In English whatever the desktop's language, since {#idle?} reads its words.
      # 
      # _@param_ `args`
      # 
      # _@return_ — stdout and stderr, and how it ended
      def localsearch: (*::Array[String] args) -> [String, Process::Status]
    end

    # The `gsettings` command, for the keys the setup reads and writes, the GNOME shortcut and
    # localsearch's folders:
    # 
    #   GSettings.strv('org.freedesktop.Tracker3.Miner.Files', 'index-recursive-directories')
    #   # => ["&DOCUMENTS", "/home/u/My 'Papers'"]
    #   GSettings.set_strv(schema, key, [*list, '/home/u/Papers'])
    #   GSettings.string("#{schema}.custom-keybinding:#{path}", 'binding')   # => "<Super>p", or nil for ''
    # 
    # Values cross in GVariant's text form, which quotes a string in single quotes, or in double
    # ones when it holds a single quote.
    module GSettings
      # _@param_ `args` — gsettings' arguments
      # 
      # _@return_ — its stdout
      def self.run: (*::Array[String] args) -> String

      # _@param_ `schema`
      # 
      # _@param_ `key` — of type `as`
      def self.strv: (String schema, String key) -> ::Array[String]

      # _@param_ `schema`
      # 
      # _@param_ `key` — of type `as`
      # 
      # _@param_ `list`
      def self.set_strv: (String schema, String key, ::Array[String] list) -> void

      # _@param_ `schema`
      # 
      # _@param_ `key` — of type `s`
      # 
      # _@return_ — nil for the empty string
      def self.string: (String schema, String key) -> String?

      # _@param_ `schema`
      # 
      # _@param_ `key` — of type `s`
      # 
      # _@param_ `value`
      def self.set_string: (String schema, String key, String value) -> void

      # _@param_ `schema`
      # 
      # _@param_ `key`
      def self.reset: (String schema, String key) -> void

      # _@param_ `value`
      # 
      # _@return_ — a GVariant string
      def self.quote: (String value) -> String

      # _@param_ `text` — a GVariant string or array of strings, as `gsettings get` prints it
      # 
      # _@return_ — every string in it, in order
      def self.parse: (String text) -> ::Array[String]

      # Raised when `gsettings` fails, its message gsettings' own: a schema that isn't installed,
      # or a key it lacks.
      class Error < StandardError
      end
    end

    # Downloads a model from Hugging Face into the {Core::HubCache}, laid out as `hf download` and
    # llama-server's `-hf` lay it out, so each finds what the others fetched (`R_hub_cache`):
    # 
    #   download = HubDownload.new(Core::HubCache.new)
    #   plan = download.gguf('ggml-org/Qwen3.5-4B-GGUF:Q4_K_M')   # or .file('ggerganov/whisper.cpp:ggml-small.bin')
    #   plan.size        # => 3032091584
    #   plan.fetched     # => what an earlier run left, complete or not
    #   download.fetch(plan) { |fetched| bar.update(fetched) }
    # 
    # {#gguf} picks the file `-hf` would ({Core::HubCache.pick_gguf}), a split model's every part;
    # {#file} takes one file by name. `HF_ENDPOINT`, as `hf` reads it, moves the server.
    # 
    # == Implementation details
    # 
    # The API lists the repo's commit and each file's size and SHA-256 (`?blobs=true`); a file comes
    # from `resolve/<commit>/<file>`, which redirects to a CDN. It goes to
    # `blobs/<sha256>.incomplete`, so a download that stopped halfway resumes with a `Range`
    # request, which `hf` doesn't do; it becomes `blobs/<sha256>` once its SHA-256 checks out, and
    # a blob already there is only linked. Then `snapshots/<commit>/<file>` links to it and
    # `refs/main` names the commit. Each file is `flock`ed at `hf`'s own lock path, so the two
    # never download one file at once.
    class HubDownload
      ENDPOINT: String
      REDIRECTS: Integer

      # _@param_ `cache`
      # 
      # _@param_ `env` — where `HF_ENDPOINT` comes from
      def initialize: (Puri::Core::HubCache cache, ?env: untyped) -> void

      # _@param_ `model` — `org/repo:quant`, matching {Core::HubCache::GGUF_MODEL}
      def gguf: (String model) -> Puri::Setup::HubDownload::Plan

      # _@param_ `model` — `org/repo:file`, matching {Core::HubCache::FILE_MODEL}
      def file: (String model) -> Puri::Setup::HubDownload::Plan

      # Downloads what isn't in the cache yet, then links the snapshot to it.
      # 
      # _@param_ `plan`
      def fetch: (Puri::Setup::HubDownload::Plan plan) ?{ (Integer fetched) -> void } -> void

      # _@param_ `repo`
      # 
      # _@return_ — the API's answer
      def api: (String repo) -> ::Hash[String, Object]

      # _@param_ `first` — a GGUF of the repo
      # 
      # _@param_ `names` — the repo's files
      # 
      # _@return_ — `first`, or every part of the split model it starts
      def parts: (String first, ::Array[String] names) -> ::Array[String]

      # _@param_ `repo`
      # 
      # _@param_ `info` — the API's answer
      # 
      # _@param_ `names`
      def plan: (String repo, ::Hash[String, Object] info, ::Array[String] names) -> Puri::Setup::HubDownload::Plan

      # _@param_ `blob`
      # 
      # _@return_ — bytes of it on disk, or of its `.incomplete` file
      def on_disk: (String blob) -> Integer

      # _@param_ `repo`
      # 
      # _@param_ `file`
      def blob: (String repo, Puri::Setup::HubDownload::RepoFile file) -> String

      # _@param_ `plan`
      # 
      # _@param_ `file`
      def fetch_file: (Puri::Setup::HubDownload::Plan plan, Puri::Setup::HubDownload::RepoFile file) ?{ (Integer bytes) -> void } -> void

      # Hashes what an earlier run left, so the download carries on from its end.
      # 
      # _@param_ `sink` — the `.incomplete` file
      # 
      # _@param_ `file`
      # 
      # _@param_ `digest`
      # 
      # _@return_ — bytes kept
      def resume: (File sink, Puri::Setup::HubDownload::RepoFile file, Digest::SHA256 digest) -> Integer

      # _@param_ `uri`
      # 
      # _@param_ `sink` — at its end
      # 
      # _@param_ `offset` — bytes in it
      # 
      # _@param_ `file`
      # 
      # _@param_ `digest` — of the bytes in it
      def download: (
                      URI::Generic uri,
                      File sink,
                      Integer offset,
                      Puri::Setup::HubDownload::RepoFile file,
                      Digest::SHA256 digest
                    ) ?{ (Integer bytes) -> void } -> void

      # Follows redirects, as `resolve/` sends a file to its CDN.
      # 
      # _@param_ `uri`
      # 
      # _@param_ `headers`
      def get: (URI::Generic uri, ?::Hash[String, String] headers) ?{ (Net::HTTPResponse response) -> void } -> void

      # _@param_ `repo`
      # 
      # _@param_ `file`
      def locked: (String repo, Puri::Setup::HubDownload::RepoFile file) -> void

      # _@param_ `plan`
      def link: (Puri::Setup::HubDownload::Plan plan) -> void

      # _@param_ `name` — a path in the repo
      # 
      # _@return_ — each segment escaped for a URL
      def escape: (String name) -> String

      # Raised when Hugging Face can't be reached, lacks the model, or sends a file that doesn't
      # match its SHA-256; the message says which, for the user.
      class Error < StandardError
      end

      # One file of a repo.
      # 
      # @!attribute [r] name
      #   @return [String] its path in the repo
      # @!attribute [r] size
      #   @return [Integer] bytes
      # @!attribute [r] sha256
      #   @return [String] hex, which names its blob
      class RepoFile
        # _@return_ — its path in the repo
        attr_reader name: String

        # _@return_ — bytes
        attr_reader size: Integer

        # _@return_ — hex, which names its blob
        attr_reader sha256: String
      end

      # What a model takes to download.
      # 
      # @!attribute [r] repo
      #   @return [String] `org/repo`
      # @!attribute [r] commit
      #   @return [String] the revision every file comes from
      # @!attribute [r] files
      #   @return [Array<Puri::Setup::HubDownload::RepoFile>]
      # @!attribute [r] fetched
      #   @return [Integer] bytes in the cache already, a download stopped halfway included
      class Plan
        # _@return_ — bytes in all
        def size: () -> Integer

        # _@return_ — `org/repo`
        attr_reader repo: String

        # _@return_ — the revision every file comes from
        attr_reader commit: String

        attr_reader files: ::Array[Puri::Setup::HubDownload::RepoFile]

        # _@return_ — bytes in the cache already, a download stopped halfway included
        attr_reader fetched: Integer
      end
    end

    # The folders GNOME's file index reads, which Settings → Search → Search Locations lists:
    # 
    #   locations = SearchLocations.new
    #   locations.covers?('/home/u/Documents')   # => true under the default '&DOCUMENTS'
    #   locations.add('/home/u/Papers')          # Puri's documents folder, indexed from now on
    # 
    # An entry is a path, `$HOME` or `~`, or the name of one of the desktop's own folders,
    # `&DOCUMENTS`, as `~/.config/user-dirs.dirs` records it in the desktop's language.
    class SearchLocations
      SCHEMA: String
      KEY: String

      # _@param_ `env` — where `HOME` and `XDG_CONFIG_HOME` come from
      def initialize: (?env: untyped) -> void

      # _@param_ `folder` — absolute
      # 
      # _@return_ — whether the index reads it, being it or under one of its folders
      def covers?: (String folder) -> bool

      # Adds `folder`, as `&DOCUMENTS` when it is the desktop's own Documents folder, as Settings
      # names it there.
      # 
      # _@param_ `folder` — absolute
      def add: (String folder) -> void

      # _@param_ `entry`
      # 
      # _@return_ — the folder it names; nil for a desktop folder that isn't set
      def resolve: (String entry) -> String?

      # _@param_ `name` — `DOCUMENTS`, `DOWNLOAD`, `PUBLICSHARE`, …
      # 
      # _@return_ — the folder `user-dirs.dirs` gives it; `~/Documents` for Documents
      # when the file doesn't say, as for Puri's own default, and nil for another; nil, too, when
      # it names the home, which is how a folder is switched off
      def user_dir: (String name) -> String?

      # _@param_ `path`
      # 
      # _@return_ — its real path when it exists, so a link to a folder counts as the folder
      def real: (String path) -> String
    end
  end

  # The GTK4 UI: the widgets and {BackendClient}, nothing else. It holds no state beyond view
  # state, so it can be rewritten in Vala as its own process if the Ruby binding fails.
  # 
  # Desktop never names Pikuri or {Core}; it reaches Core only through {BackendClient} and
  # {Protocol}. `spec/boundaries_spec.rb` holds it to that.
  module Desktop
    # Puri's CSS on top of Adwaita's, installed once for the display.
    module Style
      CSS: String

      # Safe to call twice.
      def self.install: () -> void
    end

    # A {Protocol::Map} under an answer: its tiles, a numbered pin per place, a dot where a search
    # started, a route's line, the view fitted to all of them, and the map's note under it.
    # 
    #   PlaceMap.new(block)                              # a pin click opens the place in GNOME Maps
    #   PlaceMap.new(block) { |url| opened << url }      # a spec's
    # 
    # The wheel over the map zooms it and a drag pans it; neither scrolls the answer nor moves the
    # window.
    class PlaceMap < Gtk::Box
      HEIGHT: Integer
      ASSUMED_WIDTH: Integer
      COPYRIGHT: String
      ROUTE: Gdk::RGBA

      # _@param_ `block`
      def initialize: (Puri::Protocol::Map block) ?{ (String url) -> void } -> void

      # _@param_ `block`
      def block=: (Puri::Protocol::Map block) -> void

      # _@return_ — one per pin, in the block's order
      def pins: () -> ::Array[Gtk::Button]

      # The center and zoom that show every point with a margin around them, on a Web Mercator
      # map of `tile_size` tiles. The zoom is fractional, as libshumate takes it, so the points
      # fill the view.
      # 
      #   PlaceMap.fit([[60.2916, 24.9657], [60.2931, 25.0307]], width: 600, height: 280)
      #   # => [60.29236…, 24.99821…, 12.98…]
      # 
      # _@param_ `points` — `[lat, lon]`, at least one
      # 
      # _@param_ `width` — pixels
      # 
      # _@param_ `height` — pixels
      # 
      # _@param_ `tile_size` — pixels
      # 
      # _@param_ `margin` — pixels kept free on each side, for the pins and the zoom buttons
      # 
      # _@param_ `max_zoom` — for a single place, or places metres apart
      # 
      # _@return_ — latitude, longitude, zoom level
      def self.fit: (
                      ::Array[::Array[Float]] points,
                      width: Integer,
                      height: Integer,
                      ?tile_size: Integer,
                      ?margin: Integer,
                      ?max_zoom: Float
                    ) -> [Float, Float, Float]

      # _@param_ `lat`
      # 
      # _@return_ — 0 at the top of the world map, 1 at the bottom
      def self.mercator_y: (Float lat) -> Float

      # _@param_ `block`
      def source: (Puri::Protocol::Map block) -> Shumate::RasterRenderer

      # libshumate's pan never claims its drag, so past the drag threshold the popup's WindowHandle
      # would take it and move the window. Claimed there and not on press, a click still reaches a pin.
      def keep_the_drag: () -> void

      # _@param_ `points`
      def line_layer: (::Array[::Array[Float]] points) -> Shumate::PathLayer

      # _@param_ `pins`
      def pin_layer: (::Array[Puri::Protocol::Pin] pins) -> Shumate::MarkerLayer

      # _@param_ `width`
      def look: (Integer width) -> void

      # The real width is known only once laid out, at the first frame.
      def refit_once_sized: () -> void

      attr_reader map: Shumate::SimpleMap

      # _@return_ — the block's note
      attr_reader note: Gtk::Label
    end

    # A {Protocol::Code} part of a reply: monospace on a tinted background, scrolling sideways
    # rather than wrapping.
    class CodeBlock < Gtk::ScrolledWindow
      # _@param_ `part`
      def initialize: (Puri::Protocol::Code part) -> void

      # _@param_ `part`
      def part=: (Puri::Protocol::Code part) -> void
    end

    # A {Protocol::Notice}: Puri's own line, dimmed, or red for a failure.
    class NoticeRow < Gtk::Label
      # _@param_ `block`
      def initialize: (Puri::Protocol::Notice block) -> void

      # _@param_ `block`
      def block=: (Puri::Protocol::Notice block) -> void
    end

    # A {Protocol::Reply}: its parts top to bottom. A streamed reply arrives whole again with
    # every delta; a part that keeps its kind keeps its widget, so the update is in place and a
    # selection in an earlier part survives.
    class ReplyView < Gtk::Box
      WIDGETS: ::Hash[Class, Class]

      # _@param_ `block`
      def initialize: (Puri::Protocol::Reply block) -> void

      # _@param_ `block`
      def block=: (Puri::Protocol::Reply block) -> void

      # _@param_ `index`
      # 
      # _@param_ `widget`
      def replace: (Integer index, Gtk::Widget widget) -> void
    end

    # The line under the entry: the model the next turn runs on, a pick away, then how full the
    # conversation's context is.
    # 
    #   [Ornith 1.5 ▾]  ▰▰▱▱▱▱  7.4k of 64.0k tokens          msg #2  Δ+1.6k  ↑1.0k  ↓0.6k
    #    <model pick>   <fill>  <context>                                         <detail>
    # 
    #   bar = StatusBar.new(client)
    #   bar.show(id, transcript.status)   # a conversation loaded
    #   bar.show(nil)                     # a new one: the model it will start on
    #   bar.show(id)                      # the new one just asked in; its StatusChanged follows
    # 
    # Picking a model calls `select_model` on the conversation shown, or, in a new one, picks the
    # model it will start on.
    class StatusBar < Gtk::Box
      # _@param_ `client`
      def initialize: (Puri::Desktop::BackendClient client) -> void

      # _@param_ `conversation` — nil for a new one
      # 
      # _@param_ `status` — its status; nil keeps what is shown until the conversation's next {Protocol::StatusChanged}, but for a new one
      def show: (String? conversation, ?Puri::Protocol::Status? status) -> void

      # _@return_ — the model picked
      def model_name: () -> String?

      # _@param_ `status`
      def status=: (Puri::Protocol::Status status) -> void

      def picked: () -> void

      attr_reader model: Gtk::DropDown

      attr_reader context: Gtk::Label

      attr_reader detail: Gtk::Label
    end

    # One {Protocol::ConversationSummary} in the history: the title, when it started, and a `●`
    # while its turn runs.
    class HistoryRow < Gtk::ListBoxRow
      # _@param_ `summary`
      def initialize: (Puri::Protocol::ConversationSummary summary) -> void

      # _@param_ `query` — lowercase; empty matches everything
      def matches?: (String query) -> bool

      # _@param_ `time`
      # 
      # _@param_ `now`
      # 
      # _@return_ — "14:05" today, "Yesterday", "Mon" this week, "Nov 2" this year, else "Nov 2, 2025"
      def self.timestamp: (Time time, ?Time now) -> String

      attr_accessor summary: Puri::Protocol::ConversationSummary
    end

    # A {Protocol::Prose} part of a reply: Core's Pango markup in one selectable label.
    class ProseLabel < Gtk::Label
      # _@param_ `part`
      def initialize: (Puri::Protocol::Prose part) -> void

      # _@param_ `part`
      def part=: (Puri::Protocol::Prose part) -> void
    end

    # A {Protocol::Table} part of a reply: a grid of selectable cells, the header row bold,
    # scrolling sideways when it is wider than the reply.
    # 
    # == Implementation details
    # 
    # Cells never wrap. A wrapping label makes the grid height-for-width, and a streaming table
    # then gets measured against the height of its previous, shorter self: GTK warns "Trying to
    # measure GtkGrid for height of 58, but it needs at least 76" on every delta.
    class ReplyTable < Gtk::ScrolledWindow
      # _@param_ `part`
      def initialize: (Puri::Protocol::Table part) -> void

      # _@param_ `part`
      def part=: (Puri::Protocol::Table part) -> void

      # _@param_ `markup`
      # 
      # _@param_ `header`
      def cell: (String markup, header: bool) -> Gtk::Label

      # _@return_ — the cells
      attr_reader grid: Gtk::Grid
    end

    # The one window. It opens as a pill holding only the entry; the first question expands it
    # at once to a third of the screen's width and 70 % of its height, the conversation over the
    # entry; it never grows with the text, which looks restless. The history button widens it by
    # the sidebar of earlier conversations. Hiding it always brings back an empty pill next time.
    # 
    #   window = PopupWindow.new(app, client)
    #   window.present
    # 
    # Keys: Escape cancels a running turn and hides, except that while a reply streams the first
    # Escape only stops it, leaving the partial answer to read, and while dictating it only drops
    # the dictation; Ctrl+N starts a new conversation, Ctrl+F searches the history, F9 shows or
    # hides it, F5 starts dictating and stops; Ctrl+Q, the app's own, quits Puri. The header's ×
    # hides without cancelling a turn.
    # Losing focus hides only the empty pill, so a glance at another window never loses a
    # running answer. Hiding always drops a dictation: the mic never records behind a hidden
    # window.
    class PopupWindow < Adw::ApplicationWindow
      WIDTH: Float
      HEIGHT: Float
      MIN_WIDTH: Integer
      SIDEBAR_WIDTH: Integer

      # _@param_ `app`
      # 
      # _@param_ `client`
      def initialize: (Adw::Application app, Puri::Desktop::BackendClient client) -> void

      # _@return_ — false while it is the pill
      def expanded?: () -> bool

      def history_visible?: () -> bool

      # _@return_ — the header's title
      def header_title: () -> String

      # Shows or hides the history, widening or narrowing the window by it.
      # 
      # _@param_ `visible`
      def history_visible=: (bool visible) -> void

      # Escape: see the class doc.
      def escape: () -> void

      # Ctrl+N: an empty conversation, in the window as it is.
      def new_conversation: () -> void

      def layout: () -> Gtk::Widget

      def install_actions: () -> void

      # The empty pill, as every popup starts.
      def reset: () -> void

      def expand: () -> void

      # _@param_ `id`
      def asked: (String id) -> void

      # _@param_ `id`
      def open_conversation: (String id) -> void

      # Ctrl+F: the history, its search focused.
      def search: () -> void

      # _@param_ `conversations`
      def show_title: (::Array[Puri::Protocol::ConversationSummary] conversations) -> void

      # Hides the empty pill once it loses focus; a conversation on screen stays.
      def focus_changed: () -> void

      # Sizes the window for its state, from the size of the screen it is on.
      def resize: () -> void

      # _@return_ — the screen's width and height, in logical pixels
      def screen_size: () -> [Integer, Integer]

      attr_reader conversation_view: Puri::Desktop::ConversationView

      attr_reader sidebar: Puri::Desktop::HistorySidebar
    end

    # The indeterminate progress bar shown while a turn works, with the latest step under it.
    # 
    #   row = ProgressRow.new
    #   row.status = 'Searching the web…'
    # 
    # It pulses only while mapped.
    class ProgressRow < Gtk::Box
      PULSE: Integer

      def initialize: () -> void

      # _@param_ `text` — the step as Core words it
      def status=: (String text) -> void

      def status: () -> String

      def start: () -> void

      def stop: () -> void
    end

    # Where the user types. Enter submits the trimmed text and clears the entry; Enter on an
    # empty one does nothing, so a stray Enter never answers a confirmation. Up in an empty
    # entry recalls the last question, shell-style.
    # 
    #   entry = PromptEntry.new(recall: -> { transcript.last_question }) { |text| ask(text) }
    #   entry.on_mic { client.toggle_dictation }   # a mic icon at the end, F5's twin
    #   entry.dictation = event                    # red while listening; the text lands at the cursor
    class PromptEntry < Gtk::Entry
      # _@param_ `recall` — returns the question Up brings back, a String or nil
      def initialize: (recall: Proc) ?{ (String text) -> void } -> void

      # Puts the last question in an empty entry, the cursor at its end.
      # 
      # _@return_ — whether it did, which consumes the Up key
      def recall_question: () -> bool

      # Shows the mic.
      def on_mic: () -> void

      # _@param_ `event`
      def dictation=: (Puri::Protocol::DictationChanged event) -> void

      # Inserts dictated words, a space between them and any word they touch.
      # 
      # _@param_ `words`
      def insert_at_cursor: (String words) -> void

      def submit: () -> void
    end

    # The mic's state under the entry, shown only while dictating or after it failed:
    # 
    #   ▰▰▰▰▰▰▱▱▱▱▱▱▱▱▱▱             the mic's level while listening; a pulsing bar while transcribing
    #   Listening… press F5 when done
    # 
    #   row = DictationRow.new
    #   row.dictation = event   # each Protocol::DictationChanged
    # 
    # A level bar rather than a progress bar while listening: there is nothing to progress
    # toward, and a flat level shows a dead mic at once (`D_dictation`).
    class DictationRow < Gtk::Box
      def initialize: () -> void

      # _@param_ `event`
      def dictation=: (Puri::Protocol::DictationChanged event) -> void

      # _@param_ `on`
      def pulsing: (bool on) -> void

      attr_reader level: Gtk::LevelBar

      attr_reader status: Gtk::Label
    end

    # Opens a place's openstreetmap.org URL where the user can look around it: in GNOME Maps,
    # which reads the URL and shows the place itself, or in the browser where Maps isn't installed.
    # 
    #   MapsLauncher.open('https://www.openstreetmap.org/node/9444805490')
    # 
    # Maps by its desktop file, never as the URL's default handler, which is the browser.
    module MapsLauncher
      MAPS: String

      # A failure is printed, never raised: a click has no one to tell.
      # 
      # _@param_ `url`
      def self.open: (String url) -> void
    end

    # A {Protocol::ToolLine}: one dimmed line, red when the step failed. A line with markup draws
    # it, so its link opens in the browser on the user's click.
    class ToolLineRow < Gtk::Label
      # _@param_ `block`
      def initialize: (Puri::Protocol::ToolLine block) -> void

      # _@param_ `block`
      def block=: (Puri::Protocol::ToolLine block) -> void
    end

    # Desktop's one door to Core: the {Protocol::Backend} methods, forwarded, and Core's events,
    # handed to subscribers on the GTK main loop. Components call it and subscribe to it
    # themselves; there is no controller.
    # 
    #   client = BackendClient.new(core)
    #   core_listener = ->(event) { client.deliver(event) }       # Core's side, any thread
    #   client.subscribe { |event| show(event) }                  # in a component
    #   id = client.ask(nil, 'hi')
    # 
    # Every argument, result and event goes through {Protocol.round_trip}, so Desktop never holds
    # a Ruby object of Core's and a D-Bus connection could take this one's place.
    # 
    # == Implementation details
    # 
    # No unsubscribe on a widget's `destroy`: GTK also emits it while Ruby's GC finalizes the
    # widget, and a Ruby handler running inside the GC aborts the process ("object allocation
    # during garbage collection phase").
    # 
    # Main-loop-confined, with exceptions.
    class BackendClient
      include Puri::Protocol::Backend

      # _@param_ `backend` — Core, or anything that answers like it
      def initialize: (Puri::Protocol::Backend backend) -> void

      # Sends the user's message. With a confirmation pending, the message answers it as a
      # redirect: the model follows the words and proposes again. With a turn running, it waits,
      # in {PendingChanged}, until the turn reads it.
      # 
      # _@param_ `conversation` — the conversation to continue; nil starts a new one
      # 
      # _@param_ `text` — what the user typed
      # 
      # _@return_ — the conversation's id, new when `conversation` was nil
      def ask: (String? conversation, String text) -> String

      # Stops the running turn, if any; a pending confirmation ends as `cancelled`.
      # 
      # _@param_ `conversation`
      def cancel: (String conversation) -> void

      # Answers a pending {Confirmation}; one already answered is left alone.
      # 
      # _@param_ `conversation`
      # 
      # _@param_ `confirmation` — the {Confirmation}'s block id
      # 
      # _@param_ `approved` — true for its approve button, false for Cancel
      def answer: (String conversation, String confirmation, bool approved) -> void

      # _@return_ — newest first
      def list_conversations: () -> ::Array[Puri::Protocol::ConversationSummary]

      # _@param_ `conversation`
      def load_conversation: (String conversation) -> Puri::Protocol::Transcript

      def list_models: () -> Puri::Protocol::Models

      # Picks the model for a conversation's next turn, and for every new conversation after; a
      # running turn ends on its own. A {StatusChanged} follows.
      # 
      # _@param_ `conversation` — nil picks for new conversations only
      # 
      # _@param_ `model` — one of {Models#names}
      def select_model: (String? conversation, String model) -> void

      # Forgets a conversation, cancelling its turn first.
      # 
      # _@param_ `conversation`
      def delete_conversation: (String conversation) -> void

      # _@return_ — whether the prompt has a mic: false, and the dictation methods do
      # nothing, without a transcription server
      def dictation_available?: () -> bool

      # F5: starts listening, or stops and transcribes what was heard; a press while it
      # transcribes does nothing. {DictationChanged} reports each step, its `idle` carrying the
      # text.
      def toggle_dictation: () -> void

      # Escape: drops the recording, or the transcription on its way, and clears a failure;
      # nothing is inserted.
      def cancel_dictation: () -> void

      # Subscribes for good: a component's subscription lives as long as the client.
      def subscribe: () ?{ (Data event) -> void } -> void

      # Hands an event to the subscribers on the GTK main loop; safe from any thread, so Core's
      # threads call it directly and Core never learns GLib exists.
      # 
      # _@param_ `event` — a {Protocol} event
      def deliver: (Data event) -> void

      # _@param_ `method` — a {Protocol::Backend} method
      # 
      # _@param_ `args`
      # 
      # _@return_ — its result, round-tripped
      def call: (Symbol method, *::Array[Object] args) -> Object

      # {#call} for a method that returns nothing: whatever the backend returns stays behind.
      # 
      # _@param_ `method` — a {Protocol::Backend} method
      # 
      # _@param_ `args`
      def command: (Symbol method, *::Array[Object] args) -> void
    end

    # What the shortcut shows in place of the popup when Puri can't start: the error, and the
    # config to fix.
    # 
    #   FailureDialog.new(app, 'no [titler] names the connection that writes titles',
    #                     config: '/home/me/.config/puri/config.toml').present
    # 
    # It is the app's only window, and closing it ends Puri, so the next press of the shortcut
    # starts a fresh one, which reads the config again: fix the file, press the shortcut.
    class FailureDialog < Adw::AlertDialog
      # _@param_ `app`
      # 
      # _@param_ `message` — what went wrong, as Core words it
      # 
      # _@param_ `config` — the file to fix, which a button opens; nil offers none
      def initialize: (Adw::Application app, String message, ?config: String?) -> void

      # Shows it in a window of its own, the app's: no popup is there to hold it.
      def present: () -> void

      # Unfocusable, or it opens with all its text selected; selectable, for a search or a bug
      # report.
      # 
      # _@param_ `message`
      def message_label: (String message) -> Gtk::Label

      # In the user's editor. Puri is held until the launch is through: the dialog closes on the
      # click, and with it would go Puri, the launch half done.
      def open_config: () -> void
    end

    # Every earlier conversation, newest first, with a search over the titles. It fills itself
    # from Core and stays current through {Protocol::ConversationsChanged}.
    # 
    #   sidebar = HistorySidebar.new(client)
    #   sidebar.on_selected { |id| conversation_view.conversation = id }   # clicked, or arrowed to
    #   sidebar.on_activated { |_| entry.grab_focus }                       # clicked, or Enter
    #   sidebar.selected = id      # marks the conversation on screen
    # 
    # Delete on a selected row asks, then deletes it.
    class HistorySidebar < Gtk::Box
      # _@param_ `client`
      def initialize: (Puri::Desktop::BackendClient client) -> void

      # Fetches the list again.
      def refresh: () -> void

      # _@param_ `conversations` — newest first
      def conversations=: (::Array[Puri::Protocol::ConversationSummary] conversations) -> void

      def rows: () -> ::Array[Puri::Desktop::HistoryRow]

      # Marks the conversation on screen, without telling {#on_selected}.
      # 
      # _@param_ `id`
      def selected=: (String? id) -> void

      def on_selected: () ?{ (String id) -> void } -> void

      # A click, or Enter on a row: done browsing. Arrow keys only select.
      def on_activated: () ?{ (String id) -> void } -> void

      def focus_search: () -> void

      # Asks whether to delete the selected conversation, and does on Delete.
      # 
      # _@return_ — whether a row was selected
      def ask_to_delete: () -> bool

      # _@param_ `id`
      def select: (String id) -> void

      attr_reader search: Gtk::SearchEntry

      attr_reader list: Gtk::ListBox
    end

    # The messages the agent hasn't read yet, under the transcript: each a dimmed
    # {UserMessageRow}, "Queued" under the last; hidden while none waits.
    # 
    #   queued = QueuedMessages.new
    #   queued.texts = ['and bananas?']   # PendingChanged
    #   queued.texts = []                 # the turn read it
    class QueuedMessages < Gtk::Box
      def initialize: () -> void

      # _@return_ — the texts shown
      attr_accessor texts: ::Array[String]
    end

    # One conversation's blocks, top to bottom, the progress row under them while its turn
    # works, and last the messages the agent hasn't read yet. Pure view: told what to show, it
    # reaches nothing itself.
    # 
    #   view = TranscriptView.new { |id, approved| client.answer(conversation, id, approved) }
    #   view.transcript = client.load_conversation(id)   # or nil to empty it
    #   view.upsert(event.block)                         # BlockChanged
    #   view.remove(event.block)                         # BlockRemoved
    #   view.activity = event.activity                   # ActivityChanged
    #   view.pending = event.texts                       # PendingChanged
    # 
    # It follows the newest block only while scrolled to the bottom, so scrolling up to re-read
    # survives a streaming reply.
    class TranscriptView < Gtk::ScrolledWindow
      ROWS: ::Hash[Class, Class]
      STICKY: Integer

      def initialize: () ?{ (String confirmation, bool approved) -> void } -> void

      # _@param_ `transcript`
      def transcript=: (Puri::Protocol::Transcript? transcript) -> void

      # Replaces the block with the same id, or appends it.
      # 
      # _@param_ `block`
      def upsert: (Puri::Protocol::Block block) -> void

      # _@param_ `id` — a block's id; one never shown is ignored
      def remove: (String id) -> void

      # _@param_ `texts` — the messages the agent hasn't read yet
      def pending=: (::Array[String] texts) -> void

      # _@return_ — the messages shown as queued
      def pending: () -> ::Array[String]

      # _@return_ — the user's latest message here, for Up in the entry
      def last_question: () -> String?

      # _@param_ `id` — a block's id
      # 
      # _@return_ — the row showing it
      def row: (String id) -> Gtk::Widget?

      # _@return_ — the blocks shown, in order
      def blocks: () -> ::Array[Puri::Protocol::Block]

      # _@return_ — whether nothing is shown
      def empty?: () -> bool

      def scroll_to_bottom: () -> void

      # _@param_ `block`
      def row_class: (Puri::Protocol::Block block) -> Class

      # _@param_ `block`
      def new_row: (Puri::Protocol::Block block) -> Gtk::Widget

      # `upper` changes while GTK allocates the viewport, and a value set right then is applied only
      # at the next layout: a queued message shown while the model thinks stayed below the fold
      # until the reply streamed in. So the scroll waits for an idle, once per batch of changes.
      def follow_the_bottom: () -> void

      attr_accessor activity: Puri::Protocol::Activity
    end

    # A {Protocol::Confirmation}: the question in a card with Cancel and the approve button
    # while it is pending, then the outcome in their place.
    # 
    #   row = ConfirmationRow.new(block) { |id, approved| client.answer(conversation, id, approved) }
    # 
    # The buttons never take focus on their own, so a stray Enter in the entry can't press one.
    class ConfirmationRow < Gtk::Box
      OUTCOMES: ::Hash[String, String]

      # _@param_ `block`
      def initialize: (Puri::Protocol::Confirmation block) ?{ (String confirmation, bool approved) -> void } -> void

      # _@param_ `block`
      def block=: (Puri::Protocol::Confirmation block) -> void

      # _@param_ `approved`
      def answer: (bool approved) -> void

      attr_reader approve_button: Gtk::Button

      attr_reader cancel_button: Gtk::Button
    end

    # A {Protocol::UserMessage}: a grey bubble on the right.
    class UserMessageRow < Gtk::Box
      # _@param_ `block`
      def initialize: (Puri::Protocol::UserMessage block) -> void

      # _@param_ `block`
      def block=: (Puri::Protocol::UserMessage block) -> void
    end

    # One conversation, on screen: its transcript over the entry that continues it, the
    # {DictationRow} under the entry while dictating, and its {StatusBar} under them once the
    # window is expanded. It keeps which conversation it shows and nothing else; the blocks come
    # from Core, and stay current through Core's events for that conversation.
    # 
    #   view = ConversationView.new(client)
    #   view.on_asked { expand_the_window }
    #   view.conversation = id     # loads it; nil shows a new, empty one
    #   view.cancel                # Escape
    #   view.dictate               # F5; the words land in the entry, whichever conversation shows
    # 
    # Up in the empty entry recalls this conversation's last question or, in a new one, the last
    # question asked anywhere.
    class ConversationView < Gtk::Box
      # _@param_ `client`
      def initialize: (Puri::Desktop::BackendClient client) -> void

      # Shows the transcript over the entry, or the entry alone, as the popup's pill.
      # 
      # _@param_ `expanded`
      def expanded=: (bool expanded) -> void

      # _@return_ — what this conversation's turn is doing
      def activity: () -> Puri::Protocol::Activity

      # Stops this conversation's turn, if one runs.
      def cancel: () -> void

      # Starts listening, or stops and transcribes.
      def dictate: () -> void

      # Drops the recording or the transcription on its way, and clears a failure; harmless when
      # idle.
      def cancel_dictation: () -> void

      def on_asked: () ?{ (String conversation) -> void } -> void

      # _@param_ `text`
      def ask: (String text) -> void

      def recall: () -> String?

      # _@param_ `event` — a {Protocol} event
      def show: (Data event) -> void

      # _@param_ `event`
      def dictated: (Puri::Protocol::DictationChanged event) -> void

      # _@return_ — the conversation shown; nil until the first question
      attr_accessor conversation: String?

      attr_reader entry: Puri::Desktop::PromptEntry

      attr_reader transcript: Puri::Desktop::TranscriptView

      attr_reader status_bar: Puri::Desktop::StatusBar

      attr_reader dictation_row: Puri::Desktop::DictationRow

      # _@return_ — the mic's latest state
      attr_reader dictation: Puri::Protocol::DictationChanged
    end
  end

  # What {Core} and {Desktop} say to each other. Desktop calls the methods of {Backend}; Core
  # pushes events back. Arguments, results and events are `Data` of this namespace, strings,
  # numbers, booleans, nil and arrays of these, so all of it survives JSON, and a later split into
  # two processes over D-Bus maps the methods to D-Bus methods and the events to signals.
  # 
  #   transcript = client.load_conversation('3f2…')     # => Transcript, its blocks in order
  #   client.ask('3f2…', 'and bananas?')                # => "3f2…"
  #   # then, pushed: ActivityChanged(working), BlockChanged(UserMessage), BlockChanged(Reply)…
  # 
  # The transcript is pikuri-web's: Core renders, Desktop places. Every block carries an id and
  # its whole current content; {BlockChanged} upserts it by id, so streaming re-sends the growing
  # {Reply} and a stale event is overwritten by the next one.
  # 
  # Protocol names neither side, nor anything outside the stdlib.
  module Protocol
    # Serializes a value, each `Data` in it as its fields plus its class name under `type`.
    # 
    #   Protocol.encode(BlockRemoved.new(conversation: 'c1', block: 'b2'))
    #   # => {"conversation":"c1","block":"b2","type":"BlockRemoved"}
    # 
    # _@param_ `value` — a `Data` of this namespace, or JSON-able values and arrays of them
    # 
    # _@return_ — JSON
    def self.encode: (Object value) -> String

    # The inverse of {encode}.
    # 
    # _@param_ `json` — what {encode} produced
    # 
    # _@return_ — the value
    def self.decode: (String json) -> Object

    # Takes a value through JSON and back. {Desktop::BackendClient} does this to every argument,
    # result and event, so neither side ever holds a Ruby object of the other's, and swapping the
    # in-process call for D-Bus changes nothing else.
    # 
    # _@param_ `value` — see {encode}
    # 
    # _@return_ — an equal copy
    def self.round_trip: (Object value) -> Object

    # _@param_ `value`
    # 
    # _@return_ — JSON-able
    def self.dump: (Object value) -> Object

    # _@param_ `tree` — parsed JSON, keys symbolized
    def self.load: (Object tree) -> Object

    # _@param_ `tag` — the `type` field
    # 
    # _@param_ `tree` — the whole object, for the error
    def self.message_class: (Object tag, ::Hash[untyped, untyped] tree) -> Class

    # Transcript block: a map under a turn's answer, of what its last place tool found — the
    # places, or a route. Core decides what is on it and which tiles draw it; Desktop fits the
    # view to the pins and the line.
    # 
    #   Map.new(id: 'b5', tiles: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
    #           license: '© OpenStreetMap contributors',
    #           pins: [Pin.new(label: '1', name: 'Jumbo (mall)', lat: 60.2916, lon: 24.9657, url: '…'), …],
    #           line: [[60.291592, 24.966851], [60.292234, 24.96675], …],
    #           note: 'Route by <a href="https://routing.openstreetmap.de/">FOSSGIS</a> · …')
    # 
    # @!attribute [r] id
    #   @return [String] unique within its conversation
    # @!attribute [r] tiles
    #   @return [String] the tile server's URL template, with `{z}`, `{x}` and `{y}` in it
    # @!attribute [r] license
    #   @return [String] the tiles' attribution, plain text, which stays visible on the map
    # @!attribute [r] pins
    #   @return [Array<Puri::Protocol::Pin>]
    # @!attribute [r] line
    #   @return [Array<Array<Float>>] a route's `[lat, lon]` points, in order; empty for none
    # @!attribute [r] note
    #   @return [String, nil] Pango markup under the map, its links clickable
    class Map
      include Puri::Protocol::Block

      # _@return_ — unique within its conversation
      attr_reader id: String

      # _@return_ — the tile server's URL template, with `{z}`, `{x}` and `{y}` in it
      attr_reader tiles: String

      # _@return_ — the tiles' attribution, plain text, which stays visible on the map
      attr_reader license: String

      attr_reader pins: ::Array[Puri::Protocol::Pin]

      # _@return_ — a route's `[lat, lon]` points, in order; empty for none
      attr_reader line: ::Array[::Array[Float]]

      # _@return_ — Pango markup under the map, its links clickable
      attr_reader note: String?
    end

    # One place on a {Map}: a pin showing the place's number, or a dot for the point a search
    # started from.
    # 
    #   Pin.new(label: '3', name: 'Vantaan Musiikki (musical instrument), Peltolantie 2, 01300 Vantaa',
    #           lat: 60.2931102, lon: 25.0307498, url: 'https://www.openstreetmap.org/node/9444805490')
    # 
    # @!attribute [r] label
    #   @return [String, nil] what the pin shows, the place's number; nil draws a dot
    # @!attribute [r] name
    #   @return [String] what the place is, plain text, for its tooltip
    # @!attribute [r] lat
    #   @return [Float]
    # @!attribute [r] lon
    #   @return [Float]
    # @!attribute [r] url
    #   @return [String] the place on openstreetmap.org, which a click opens
    class Pin
      # _@return_ — what the pin shows, the place's number; nil draws a dot
      attr_reader label: String?

      # _@return_ — what the place is, plain text, for its tooltip
      attr_reader name: String

      attr_reader lat: Float

      attr_reader lon: Float

      # _@return_ — the place on openstreetmap.org, which a click opens
      attr_reader url: String
    end

    # Part of a {Reply}: a fenced code block.
    # 
    # @!attribute [r] text
    #   @return [String] plain text, never markup
    class Code
      # _@return_ — plain text, never markup
      attr_reader text: String
    end

    # What every transcript block is: {UserMessage}, {Reply}, {ToolLine}, {Confirmation}, {Notice}
    # or {Map}. Each has an `id`, unique within its conversation, which {BlockChanged} and
    # {BlockRemoved} address it by. A type name only, with nothing to share.
    module Block
    end

    # Part of a {Reply}: a run of paragraphs, headings and lists, as one piece of Pango markup,
    # so a selection can span them. Core escaped every character the model wrote.
    # 
    # @!attribute [r] markup
    #   @return [String] Pango markup, `"<b>Fridge</b>: 3–5 days\n\n• cut side down"`
    class Prose
      # _@return_ — Pango markup, `"<b>Fridge</b>: 3–5 days\n\n• cut side down"`
      attr_reader markup: String
    end

    # Transcript block: the model's answer, rendered by Core into parts Desktop only places.
    # While it streams, Core re-sends the whole reply with each delta.
    # 
    #   Reply.new(id: 'b3', parts: [
    #     Prose.new(markup: "<b>Avocados</b> keep for…\n\n• in the fridge"),
    #     Table.new(header: ['Where', 'Days'], rows: [['Fridge', '3–5']]),
    #   ])
    # 
    # @!attribute [r] id
    #   @return [String] unique within its conversation
    # @!attribute [r] parts
    #   @return [Array<Puri::Protocol::Prose, Puri::Protocol::Code, Puri::Protocol::Table>] in order
    class Reply
      include Puri::Protocol::Block

      # _@return_ — unique within its conversation
      attr_reader id: String

      # _@return_ — in order
      attr_reader parts: ::Array[(Puri::Protocol::Prose | Puri::Protocol::Code | Puri::Protocol::Table)]
    end

    # Part of a {Reply}: a table, each cell Pango markup.
    # 
    # @!attribute [r] header
    #   @return [Array<String>] one cell per column
    # @!attribute [r] rows
    #   @return [Array<Array<String>>] each as wide as {#header}
    class Table
      # _@return_ — one cell per column
      attr_reader header: ::Array[String]

      # _@return_ — each as wide as {#header}
      attr_reader rows: ::Array[::Array[String]]
    end

    # The models a conversation can run on, what {Backend#list_models} returns.
    # 
    #   Models.new(names: ['Ornith 1.5', 'Qwen 3.6'], selected: 'Ornith 1.5')
    # 
    # @!attribute [r] names
    #   @return [Array<String>] the config's connections, in its order; never empty
    # @!attribute [r] selected
    #   @return [String] the one a new conversation starts on
    class Models
      # _@return_ — the config's connections, in its order; never empty
      attr_reader names: ::Array[String]

      # _@return_ — the one a new conversation starts on
      attr_reader selected: String
    end

    # Transcript block: a line from Puri itself, not the model: "Cancelled", or why a turn failed.
    # 
    # @!attribute [r] id
    #   @return [String] unique within its conversation
    # @!attribute [r] text
    #   @return [String] plain text, never markup
    # @!attribute [r] error
    #   @return [Boolean] true for a failure, false for a plain note
    class Notice
      include Puri::Protocol::Block

      # _@return_ — unique within its conversation
      attr_reader id: String

      # _@return_ — plain text, never markup
      attr_reader text: String

      # _@return_ — true for a failure, false for a plain note
      attr_reader error: bool
    end

    # What a conversation's status bar shows: the model its next turn runs on, and how full its
    # context is, each worded by Core.
    # 
    #   Status.new(model: 'Ornith 1.5', context: '7.4k of 64.0k tokens', fill: 0.12,
    #              detail: 'msg #2  Δ+1.6k  ↑1.0k  ↓0.6k')
    #   Status.new(model: 'Ornith 1.5')   # nothing measured, the window unknown
    # 
    # @!attribute [r] model
    #   @return [String] a {Models#names} entry, the connection the next turn uses
    # @!attribute [r] context
    #   @return [String] the context used, against the window when known; empty when neither is
    # @!attribute [r] fill
    #   @return [Float, nil] the share of the window used, 0.0 to 1.0; nil while the window or
    #     the use is unknown
    # @!attribute [r] detail
    #   @return [String] the latest reply's tokens; empty before the first
    class Status
      # _@param_ `model`
      # 
      # _@param_ `context`
      # 
      # _@param_ `fill`
      # 
      # _@param_ `detail`
      def initialize: (
                        model: String,
                        ?context: String,
                        ?fill: Float?,
                        ?detail: String
                      ) -> void

      # _@return_ — a {Models#names} entry, the connection the next turn uses
      attr_reader model: String

      # _@return_ — the context used, against the window when known; empty when neither is
      attr_reader context: String

      # _@return_ — the share of the window used, 0.0 to 1.0; nil while the window or
      # the use is unknown
      attr_reader fill: Float?

      # _@return_ — the latest reply's tokens; empty before the first
      attr_reader detail: String
    end

    # The methods Desktop calls on Core. A backend includes this module and overrides every
    # method; the bodies here only raise. Calls come from the GTK main loop and return at once:
    # a turn runs on Core's own thread and reports through events ({BlockChanged},
    # {ActivityChanged}, {StatusChanged}, {PendingChanged}, {ConversationsChanged}), and so does
    # dictation ({DictationChanged}).
    # 
    #   id = backend.ask(nil, 'reschedule my dentist in the calendar')   # a new conversation
    #   # … BlockChanged(Confirmation(state: 'pending')) arrives …
    #   backend.answer(id, 'b4', true)            # Update; false is Cancel
    #   backend.ask(id, 'make it Wednesday')      # typed while it waits: a redirect
    #   backend.cancel(id)                        # Escape
    module Backend
      # Sends the user's message. With a confirmation pending, the message answers it as a
      # redirect: the model follows the words and proposes again. With a turn running, it waits,
      # in {PendingChanged}, until the turn reads it.
      # 
      # _@param_ `conversation` — the conversation to continue; nil starts a new one
      # 
      # _@param_ `text` — what the user typed
      # 
      # _@return_ — the conversation's id, new when `conversation` was nil
      def ask: (String? conversation, String text) -> String

      # Stops the running turn, if any; a pending confirmation ends as `cancelled`.
      # 
      # _@param_ `conversation`
      def cancel: (String conversation) -> void

      # Answers a pending {Confirmation}; one already answered is left alone.
      # 
      # _@param_ `conversation`
      # 
      # _@param_ `confirmation` — the {Confirmation}'s block id
      # 
      # _@param_ `approved` — true for its approve button, false for Cancel
      def answer: (String conversation, String confirmation, bool approved) -> void

      # _@return_ — newest first
      def list_conversations: () -> ::Array[Puri::Protocol::ConversationSummary]

      # _@param_ `conversation`
      def load_conversation: (String conversation) -> Puri::Protocol::Transcript

      def list_models: () -> Puri::Protocol::Models

      # Picks the model for a conversation's next turn, and for every new conversation after; a
      # running turn ends on its own. A {StatusChanged} follows.
      # 
      # _@param_ `conversation` — nil picks for new conversations only
      # 
      # _@param_ `model` — one of {Models#names}
      def select_model: (String? conversation, String model) -> void

      # Forgets a conversation, cancelling its turn first.
      # 
      # _@param_ `conversation`
      def delete_conversation: (String conversation) -> void

      # _@return_ — whether the prompt has a mic: false, and the dictation methods do
      # nothing, without a transcription server
      def dictation_available?: () -> bool

      # F5: starts listening, or stops and transcribes what was heard; a press while it
      # transcribes does nothing. {DictationChanged} reports each step, its `idle` carrying the
      # text.
      def toggle_dictation: () -> void

      # Escape: drops the recording, or the transcription on its way, and clears a failure;
      # nothing is inserted.
      def cancel_dictation: () -> void
    end

    # What a conversation's turn is doing.
    # 
    #   Activity.new(state: 'working', status: 'Searching the web…')   # progress bar, status under it
    #   Activity.new(state: 'streaming', status: '')                   # reply text arriving
    #   Activity.new(state: 'confirming', status: '')                  # a Confirmation waits
    #   Activity::IDLE                                                 # no turn
    # 
    # @!attribute [r] state
    #   @return [String] one of {STATES}
    # @!attribute [r] status
    #   @return [String] the latest step as Core words it; empty but while `working`
    class Activity
      STATES: ::Array[String]
      IDLE: Activity

      # _@param_ `state` — one of {STATES}
      # 
      # _@param_ `status`
      def initialize: (state: String, ?status: String) -> void

      # _@return_ — whether a turn runs, in whatever state
      def running?: () -> bool

      # _@return_ — one of {STATES}
      attr_reader state: String

      # _@return_ — the latest step as Core words it; empty but while `working`
      attr_reader status: String
    end

    # Transcript block: one step the agent took, worded by Core, drawn as one dimmed line. It
    # stays in the transcript to show what left the machine, and so a local model's slow steps
    # read as progress, not a stall.
    # 
    #   ToolLine.new(id: 'b2', text: '🔍 Searched: "avocado preservation"', error: false)
    #   ToolLine.new(id: 'b3', text: '🌦 Weather from Open-Meteo: Lisbon', error: false,
    #                markup: '🌦 Weather from <a href="https://open-meteo.com/">Open-Meteo</a>: Lisbon')
    # 
    # @!attribute [r] id
    #   @return [String] unique within its conversation
    # @!attribute [r] text
    #   @return [String] plain text, never markup
    # @!attribute [r] error
    #   @return [Boolean] whether the step failed
    # @!attribute [r] markup
    #   @return [String, nil] the same line as Pango markup, drawn in place of `text`, where a
    #     data source's terms want their credit linked beside the data; nil for a plain line
    class ToolLine
      include Puri::Protocol::Block

      # _@param_ `id`
      # 
      # _@param_ `text`
      # 
      # _@param_ `error`
      # 
      # _@param_ `markup`
      def initialize: (
                        id: String?,
                        text: String,
                        error: bool,
                        ?markup: String?
                      ) -> void

      # _@return_ — unique within its conversation
      attr_reader id: String

      # _@return_ — plain text, never markup
      attr_reader text: String

      # _@return_ — whether the step failed
      attr_reader error: bool

      # _@return_ — the same line as Pango markup, drawn in place of `text`, where a
      # data source's terms want their credit linked beside the data; nil for a plain line
      attr_reader markup: String?
    end

    # A whole conversation as Desktop draws it, what {Backend#load_conversation} returns. Later
    # changes arrive as {BlockChanged}, {BlockRemoved}, {ActivityChanged}, {StatusChanged} and
    # {PendingChanged}.
    # 
    # @!attribute [r] conversation
    #   @return [String] its id
    # @!attribute [r] title
    #   @return [String]
    # @!attribute [r] blocks
    #   @return [Array<Puri::Protocol::Block>] in order
    # @!attribute [r] activity
    #   @return [Puri::Protocol::Activity]
    # @!attribute [r] status
    #   @return [Puri::Protocol::Status]
    # @!attribute [r] pending
    #   @return [Array<String>] the messages the agent hasn't read yet, as {PendingChanged#texts}
    class Transcript
      # _@param_ `conversation`
      # 
      # _@param_ `title`
      # 
      # _@param_ `blocks`
      # 
      # _@param_ `activity`
      # 
      # _@param_ `status`
      # 
      # _@param_ `pending`
      def initialize: (
                        conversation: String,
                        title: String,
                        blocks: ::Array[Puri::Protocol::Block],
                        activity: Puri::Protocol::Activity,
                        status: Puri::Protocol::Status,
                        ?pending: ::Array[String]
                      ) -> void

      # _@return_ — its id
      attr_reader conversation: String

      attr_reader title: String

      # _@return_ — in order
      attr_reader blocks: ::Array[Puri::Protocol::Block]

      attr_reader activity: Puri::Protocol::Activity

      attr_reader status: Puri::Protocol::Status

      # _@return_ — the messages the agent hasn't read yet, as {PendingChanged#texts}
      attr_reader pending: ::Array[String]
    end

    # Transcript block: the agent asks before it acts. While `pending`, Desktop shows Cancel and
    # the approve button, and answers through {Backend#answer}; typed text answers it too
    # ({Backend#ask}). Answered, Core re-sends it with its final state.
    # 
    #   Confirmation.new(id: 'b4', question: 'Move “Dentist” (Personal) to Thursday 15:00?',
    #                    approve_label: 'Update', destructive: true, state: 'pending')
    # 
    # @!attribute [r] id
    #   @return [String] unique within its conversation
    # @!attribute [r] question
    #   @return [String] plain text naming everything that matters: which calendar, which note
    # @!attribute [r] approve_label
    #   @return [String] the approve button's word, "Update", "Open draft"
    # @!attribute [r] destructive
    #   @return [Boolean] true paints the approve button red, false blue
    # @!attribute [r] state
    #   @return [String] one of {STATES}
    class Confirmation
      include Puri::Protocol::Block
      STATES: ::Array[String]

      def pending?: () -> bool

      # _@return_ — unique within its conversation
      attr_reader id: String

      # _@return_ — plain text naming everything that matters: which calendar, which note
      attr_reader question: String

      # _@return_ — the approve button's word, "Update", "Open draft"
      attr_reader approve_label: String

      # _@return_ — true paints the approve button red, false blue
      attr_reader destructive: bool

      # _@return_ — one of {STATES}
      attr_reader state: String
    end

    # Transcript block: what the user typed.
    # 
    # @!attribute [r] id
    #   @return [String] unique within its conversation
    # @!attribute [r] text
    #   @return [String] plain text, never markup
    class UserMessage
      include Puri::Protocol::Block

      # _@return_ — unique within its conversation
      attr_reader id: String

      # _@return_ — plain text, never markup
      attr_reader text: String
    end

    # Event: a transcript block appeared or changed. Desktop replaces the block with this id, or
    # appends it when it has none.
    # 
    # @!attribute [r] conversation
    #   @return [String]
    # @!attribute [r] block
    #   @return [Puri::Protocol::Block]
    class BlockChanged
      attr_reader conversation: String

      attr_reader block: Puri::Protocol::Block
    end

    # Event: a transcript block is gone. An id Desktop never drew is not an error.
    # 
    # @!attribute [r] conversation
    #   @return [String]
    # @!attribute [r] block
    #   @return [String] the block's id
    class BlockRemoved
      attr_reader conversation: String

      # _@return_ — the block's id
      attr_reader block: String
    end

    # Event: a conversation's {Status} changed — a model picked, a reply's tokens counted.
    # 
    # @!attribute [r] conversation
    #   @return [String]
    # @!attribute [r] status
    #   @return [Puri::Protocol::Status]
    class StatusChanged
      attr_reader conversation: String

      attr_reader status: Puri::Protocol::Status
    end

    # Event: the messages the user sent that the agent hasn't read yet changed — one typed during
    # a turn, or the first one while the agent boots. It carries all of them, so the last one
    # alone says what waits; `[]` once the agent read them or a cancel dropped them.
    # 
    # @!attribute [r] conversation
    #   @return [String]
    # @!attribute [r] texts
    #   @return [Array<String>] plain text, in the order the agent will read them
    class PendingChanged
      attr_reader conversation: String

      # _@return_ — plain text, in the order the agent will read them
      attr_reader texts: ::Array[String]
    end

    # Event: a conversation's turn started, moved on, or ended.
    # 
    # @!attribute [r] conversation
    #   @return [String]
    # @!attribute [r] activity
    #   @return [Puri::Protocol::Activity]
    class ActivityChanged
      attr_reader conversation: String

      attr_reader activity: Puri::Protocol::Activity
    end

    # Event: the mic in the prompt changed state. Dictation is the window's, not a
    # conversation's, so it names none.
    # 
    #   DictationChanged.new(state: 'listening', status: 'Listening… press F5 when done', level: 0.4)
    #   DictationChanged.new(state: 'transcribing', status: 'Transcribing…')
    #   DictationChanged.new(state: 'idle', text: 'buy avocados')     # insert at the cursor
    #   DictationChanged.new(state: 'failed', status: "Couldn't transcribe: …")
    # 
    # @!attribute [r] state
    #   @return [String] one of {STATES}
    # @!attribute [r] status
    #   @return [String] what to show under the bar, as Core words it; empty while `idle`
    # @!attribute [r] level
    #   @return [Float] the mic's level while `listening`, 0 (silence) to 1; 0 otherwise
    # @!attribute [r] text
    #   @return [String] on the `idle` that ends a transcription, what was heard, squeezed to
    #     single spaces; empty for silence and on every other event
    class DictationChanged
      STATES: ::Array[String]

      # _@param_ `state` — one of {STATES}
      # 
      # _@param_ `status`
      # 
      # _@param_ `level`
      # 
      # _@param_ `text`
      def initialize: (
                        state: String,
                        ?status: String,
                        ?level: Float,
                        ?text: String
                      ) -> void

      # _@return_ — whether the mic records or its clip is being transcribed
      def active?: () -> bool

      # _@return_ — one of {STATES}
      attr_reader state: String

      # _@return_ — what to show under the bar, as Core words it; empty while `idle`
      attr_reader status: String

      # _@return_ — the mic's level while `listening`, 0 (silence) to 1; 0 otherwise
      attr_reader level: Float

      # _@return_ — on the `idle` that ends a transcription, what was heard, squeezed to
      # single spaces; empty for silence and on every other event
      attr_reader text: String
    end

    # One row of the history sidebar.
    # 
    # @!attribute [r] id
    #   @return [String]
    # @!attribute [r] title
    #   @return [String] "New conversation" until Core names it from the opening question
    # @!attribute [r] started_at
    #   @return [String] ISO 8601 with the offset, `2026-11-11T14:05:00+01:00`
    # @!attribute [r] running
    #   @return [Boolean] whether a turn runs in it now, the sidebar's `●`
    # @!attribute [r] last_question
    #   @return [String, nil] what the user asked last, for Up in an empty entry
    # @!attribute [r] asked_at
    #   @return [String, nil] when, ISO 8601 like {#started_at}
    class ConversationSummary
      attr_reader id: String

      # _@return_ — "New conversation" until Core names it from the opening question
      attr_reader title: String

      # _@return_ — ISO 8601 with the offset, `2026-11-11T14:05:00+01:00`
      attr_reader started_at: String

      # _@return_ — whether a turn runs in it now, the sidebar's `●`
      attr_reader running: bool

      # _@return_ — what the user asked last, for Up in an empty entry
      attr_reader last_question: String?

      # _@return_ — when, ISO 8601 like {#started_at}
      attr_reader asked_at: String?
    end

    # Event: the history changed: a conversation began, got its title, started or stopped
    # running, or was deleted. Carries the whole list, as {Backend#list_conversations} returns it.
    # 
    # @!attribute [r] conversations
    #   @return [Array<Puri::Protocol::ConversationSummary>] newest first
    class ConversationsChanged
      # _@return_ — newest first
      attr_reader conversations: ::Array[Puri::Protocol::ConversationSummary]
    end
  end
end