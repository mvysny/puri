#!/usr/bin/env ruby
# frozen_string_literal: true

# The composition root, the one file that knows both Core and Desktop: loads GTK and Adw, then
# the app, builds Core, and connects it to the Desktop app through Protocol's JSON round trip.

# Pin Bundler to this project's Gemfile, so the script works from any directory and through a
# symlink (`__dir__` resolves it).
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'puri'

begin
  Puri.require_gtk
rescue LoadError
  abort 'Puri needs GTK4 and libadwaita from apt: sudo apt install ruby ruby-bundler ruby-gtk4 gir1.2-adw-1'
end
Puri::LOADER.eager_load

client = nil
core = Puri::Core::DummyCore.new { |event| client.deliver(Puri::Protocol.round_trip(event)) }
client = Puri::Desktop::BackendClient.new { |command| core.handle(Puri::Protocol.round_trip(command)) }

# Single-instance on the session bus: a second launch only activates this one, which is how the
# global shortcut will bring the window back.
app = Adw::Application.new('io.github.mvysny.Puri', :default_flags)
app.signal_connect('activate') do |a|
  (a.active_window || Puri::Desktop::PopupWindow.new(a, client)).present
end
exit app.run([])
